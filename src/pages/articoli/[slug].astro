---
// Rotta dinamica degli articoli: una pagina per ogni file in src/dati/articoli/.
// Gli URL restano identici all'originale (/articoli/<slug>) per non perdere SEO.
import ArticoloBlog from '../../layouts/ArticoloBlog.astro';

export function getStaticPaths() {
  const moduli = import.meta.glob('../../dati/articoli/*.json', { eager: true });
  return Object.values(moduli).map((m: any) => {
    const articolo = m.default ?? m;
    return { params: { slug: articolo.slug }, props: { articolo } };
  });
}

const { articolo } = Astro.props;
---
<ArticoloBlog articolo={articolo} />
