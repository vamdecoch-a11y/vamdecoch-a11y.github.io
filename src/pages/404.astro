---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata | VAM Deco" description="La pagina che cercavi non esiste o è stata spostata.">
  <section class="max-w-2xl mx-auto px-4 py-28 text-center">
    <div class="font-display text-6xl md:text-7xl font-bold text-brand">404</div>
    <h1 id="e404-h1" class="font-display text-2xl md:text-3xl font-bold mt-4"
        data-en="Page not found" data-de="Seite nicht gefunden">Pagina non trovata</h1>
    <p id="e404-p" class="mt-5 text-carta/70 leading-relaxed"
       data-en="The page you were looking for does not exist or has been moved. You can go back to the home page or take a look at our services."
       data-de="Die gesuchte Seite existiert nicht oder wurde verschoben. Sie können zur Startseite zurückkehren oder einen Blick auf unsere Leistungen werfen.">
      La pagina che cercavi non esiste o è stata spostata. Puoi tornare alla home
      oppure dare un'occhiata ai nostri servizi.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a id="e404-home" href="/" class="btn-anim inline-block rounded-full bg-brand px-7 py-3.5 font-semibold text-ink hover:bg-brand-dark"
         data-en="Back to home" data-de="Zurück zur Startseite">Torna alla home</a>
      <a id="e404-serv" href="/servizi" class="inline-block rounded-full border border-white/20 px-7 py-3.5 font-semibold text-carta hover:border-brand"
         data-en="Our services" data-de="Unsere Leistungen">I nostri servizi</a>
    </div>
  </section>
  <script is:inline>
    // GitHub Pages serve questo 404 per QUALSIASI URL sconosciuto: adatto lingua e link
    // in base al prefisso /en o /de del percorso.
    (function () {
      var p = location.pathname;
      var lang = (p.indexOf('/en/') === 0 || p === '/en') ? 'en' : (p.indexOf('/de/') === 0 || p === '/de') ? 'de' : 'it';
      if (lang === 'it') return;
      document.documentElement.lang = lang;
      var pre = '/' + lang;
      ['e404-h1', 'e404-p', 'e404-home', 'e404-serv'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el && el.dataset[lang]) el.textContent = el.dataset[lang];
      });
      var home = document.getElementById('e404-home'); if (home) home.setAttribute('href', pre);
      var serv = document.getElementById('e404-serv'); if (serv) serv.setAttribute('href', pre + '/servizi');
      document.title = (lang === 'en' ? 'Page not found' : 'Seite nicht gefunden') + ' | VAM Deco';
    })();
  </script>
</Base>
