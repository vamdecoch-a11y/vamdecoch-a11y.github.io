---
// CONTATTACI: recapiti completi + modulo condiviso. Corregge il link telefono
// rotto dell'originale Framer (puntava a '020202002') e aggiunge LocalBusiness JSON-LD.
import Base from '../layouts/Base.astro';
import FormContatti from '../components/FormContatti.astro';
import WhatsAppTondo from '../components/WhatsAppTondo.astro';

const orari = [
  { g: 'Lunedì - Venerdì', o: '08:30 - 12:00 / 13:30 - 18:00' },
  { g: 'Sabato', o: '09:30 - 12:00' },
  { g: 'Domenica', o: 'Chiuso' },
];

const localBusinessJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'VAM Deco Agency Sagl',
  url: 'https://vamdeco.ch',
  telephone: '+41765889497',
  email: 'info@vamdeco.ch',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via Pobbia 4D',
    postalCode: '6514',
    addressLocality: 'Sementina',
    addressRegion: 'Ticino',
    addressCountry: 'CH',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:30', closes: '12:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '13:30', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:30', closes: '12:00' },
  ],
  sameAs: ['https://instagram.com/vamdeco.ch', 'https://facebook.com/vamdeco.ch', 'https://www.tiktok.com/@vamdeco.ch'],
});
---
<Base
  title="Contattaci | Richiedi un preventivo gratuito | VAM Deco"
  description="Hai un'idea da realizzare? Contatta VAM Deco a Sementina: telefono, WhatsApp, email o modulo. Preventivo personalizzato gratuito in 24/48h."
>
  <script type="application/ld+json" set:html={localBusinessJsonLd} />

  <!-- HERO -->
  <section class="relative pattern-hero overflow-hidden">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-3xl mx-auto px-4 pt-20 pb-14 text-center" data-reveal-stagger>
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-4 uppercase">Contattaci</div>
      <h1 data-reveal class="text-3xl md:text-5xl font-bold leading-tight tracking-tight" style="text-wrap: balance">
        Diamo vita al tuo <span class="text-brand">progetto</span>
      </h1>
      <p data-reveal class="mt-8 text-carta/80 leading-relaxed">
        Chiamaci, scrivici su WhatsApp o compila il modulo: ti rispondiamo con un preventivo gratuito in 24/48h.
      </p>
    </div>
  </section>

  <!-- RECAPITI + MODULO -->
  <section class="max-w-6xl mx-auto px-4 py-14 grid gap-12 md:grid-cols-[1fr_1.2fr]">
    <div class="space-y-8" data-reveal-stagger>
      <a data-reveal href="tel:+41765889497" class="group flex items-start gap-4">
        <span class="mt-0.5 w-11 h-11 rounded-full bg-brand/15 text-brand grid place-items-center shrink-0" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
        </span>
        <span>
          <span class="block text-xs font-bold tracking-widest text-carta/50 uppercase">Cellulare</span>
          <span class="block mt-1 font-display font-semibold group-hover:text-brand transition-colors">+41 76 588 94 97</span>
        </span>
      </a>

      <a data-reveal href="https://maps.app.goo.gl/zq6THCbbrv1LWDPY6" target="_blank" rel="noopener" class="group flex items-start gap-4">
        <span class="mt-0.5 w-11 h-11 rounded-full bg-brand/15 text-brand grid place-items-center shrink-0" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
        </span>
        <span>
          <span class="block text-xs font-bold tracking-widest text-carta/50 uppercase">Indirizzo</span>
          <span class="block mt-1 font-display font-semibold group-hover:text-brand transition-colors">Via Pobbia 4D, 6514 Sementina</span>
          <span class="block text-sm text-carta/60">Ticino, Svizzera · apri su Google Maps</span>
        </span>
      </a>

      <div data-reveal class="flex items-start gap-4">
        <span class="mt-0.5 w-11 h-11 rounded-full bg-brand/15 text-brand grid place-items-center shrink-0" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>
        </span>
        <span>
          <span class="block text-xs font-bold tracking-widest text-carta/50 uppercase">Email</span>
          <a href="mailto:info@vamdeco.ch" class="block mt-1 font-display font-semibold hover:text-brand transition-colors">info@vamdeco.ch</a>
          <a href="mailto:info@vamdeco.agency" class="block font-display font-semibold hover:text-brand transition-colors">info@vamdeco.agency</a>
        </span>
      </div>

      <div data-reveal class="flex items-start gap-4">
        <span class="mt-0.5 w-11 h-11 rounded-full bg-brand/15 text-brand grid place-items-center shrink-0" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm4.2 14.2-4.7-2.8V7h1.5v5.6l4 2.4-.8 1.2Z"/></svg>
        </span>
        <span class="grow">
          <span class="block text-xs font-bold tracking-widest text-carta/50 uppercase">Orari di apertura</span>
          <span class="block mt-2 divide-y divide-white/10 border-y border-white/10">
            {orari.map((r) => (
              <span class="flex justify-between gap-6 py-2 text-sm">
                <span class="text-carta/70">{r.g}</span>
                <span class={`font-semibold ${r.o === 'Chiuso' ? 'text-carta/45' : ''}`}>{r.o}</span>
              </span>
            ))}
          </span>
        </span>
      </div>

      <div data-reveal class="flex items-start gap-4">
        <span class="mt-0.5 w-11 h-11 rounded-full bg-brand/15 text-brand grid place-items-center shrink-0" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-8 1a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm0 2c-2.33 0-7 1.17-7 3.5V20h8v-2.5c0-.85.34-2.34 2.44-3.5A13.6 13.6 0 0 0 8 14Zm8-1c-2.67 0-8 1.34-8 4v3h16v-3c0-2.66-5.33-4-8-4Z"/></svg>
        </span>
        <span>
          <span class="block text-xs font-bold tracking-widest text-carta/50 uppercase">Seguici sui social</span>
          <span class="mt-3 flex items-center gap-3">
            <a href="https://instagram.com/vamdeco.ch" target="_blank" rel="noopener" class="social-tile" aria-label="Seguici su Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23a3.7 3.7 0 0 1-.9 1.38c-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07ZM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.86 5.86 0 0 0-2.13 1.38A5.86 5.86 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.8.72 1.47 1.38 2.13a5.86 5.86 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.86 5.86 0 0 0 2.13-1.38 5.86 5.86 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.86 5.86 0 0 0-1.38-2.13A5.86 5.86 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84Zm0 10.15A4 4 0 1 1 16 12a4 4 0 0 1-4 3.99Zm7.85-10.4a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44Z"/></svg>
            </a>
            <a href="https://facebook.com/vamdeco.ch" target="_blank" rel="noopener" class="social-tile" aria-label="Seguici su Facebook">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.88 11.85v-8.38H7.08V12h3.04V9.36c0-3 1.79-4.67 4.53-4.67 1.31 0 2.68.24 2.68.24v2.95h-1.51c-1.49 0-1.95.92-1.95 1.87V12h3.32l-.53 3.47h-2.79v8.38A12 12 0 0 0 24 12Z"/></svg>
            </a>
            <a href="https://www.tiktok.com/@vamdeco.ch" target="_blank" rel="noopener" class="social-tile" aria-label="Seguici su TikTok">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z"/></svg>
            </a>
            <a href="https://wa.me/41765889497" target="_blank" rel="noopener" class="social-tile" aria-label="Scrivici su WhatsApp">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.06 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.11.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35ZM12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.4 9.4 0 0 1-1.44-5.03c0-5.2 4.23-9.43 9.43-9.43a9.37 9.37 0 0 1 6.67 2.76 9.37 9.37 0 0 1 2.76 6.68c0 5.2-4.24 9.43-9.44 9.43Zm8.03-17.46A11.29 11.29 0 0 0 12.04 .72C5.8.72.72 5.8.72 12.05c0 2 .52 3.94 1.51 5.66L.63 23.28l5.7-1.5a11.32 11.32 0 0 0 5.71 1.55c6.25 0 11.33-5.08 11.33-11.32 0-3.03-1.18-5.87-3.32-8.01Z"/></svg>
            </a>
          </span>
        </span>
      </div>
    </div>

    <div data-reveal>
      <h2 class="font-display text-2xl md:text-3xl font-bold mb-6">Parliamo<span class="text-brand">!</span></h2>
      <FormContatti oggetto="Richiesta dalla pagina Contattaci" />
    </div>
  </section>

  <WhatsAppTondo testo="Ciao VAM Deco, vorrei informazioni." />
</Base>
