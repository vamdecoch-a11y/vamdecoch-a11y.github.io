---
// Pagine citta abbigliamento EN (/en/abbigliamento-personalizzato-ticino/<citta>).
import PaginaServizio from '../../../layouts/PaginaServizio.astro';
export function getStaticPaths() {
  const moduli = import.meta.glob('../../../dati/servizi-en/citta/abbigliamento-*.json', { eager: true });
  return Object.entries(moduli).map(([path, mod]) => {
    const file = path.split('/').pop()!.replace('.json', '');
    return { params: { slug: file.replace('abbigliamento-', '') }, props: { servizio: (mod as any).default } };
  });
}
const { servizio } = Astro.props;
---
<PaginaServizio servizio={servizio} />
