---
// Pagine citta decorazione vetrine EN (/en/decorazione-vetrine-ticino/<slug>).
import PaginaServizio from '../../../layouts/PaginaServizio.astro';
export function getStaticPaths() {
  const moduli = import.meta.glob('../../../dati/servizi-en/citta/decorazione-vetrine-*.json', { eager: true });
  return Object.entries(moduli).map(([path, mod]) => {
    const slug = path.split('/').pop()!.replace('.json', '');
    return { params: { slug }, props: { servizio: (mod as any).default } };
  });
}
const { servizio } = Astro.props;
---
<PaginaServizio servizio={servizio} />
