---
// Thank-you page after form submit (EN). Forms redirect here; also used to measure conversions.
import Base from '../../layouts/Base.astro';
---
<Base
  title="Thank you! | VAM Deco"
  description="We have received your request. We will contact you within 24/48 working hours."
  noindex
>
  <section class="relative pattern-hero overflow-hidden min-h-[70vh] flex items-center">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-2xl mx-auto px-4 py-20 text-center" data-reveal-stagger>
      <div data-reveal class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-full bg-brand text-ink text-4xl font-bold" aria-hidden="true">✓</div>
      <h1 data-reveal class="font-display text-5xl md:text-7xl font-bold text-brand">Thank you!</h1>
      <p data-reveal class="mt-8 text-lg text-carta/80 leading-relaxed">
        We have successfully received your form. We will contact you within 24/48 working hours
        to give you all the information you need and answer your request in detail.
      </p>
      <p data-reveal class="mt-6 text-carta/70">
        If you have urgent questions or special requests, call us right away at{' '}
        <a href="tel:+41765889497" class="text-brand font-semibold hover:underline">+41 76 588 94 97</a>{' '}
        or write to us at{' '}
        <a href="mailto:info@vamdeco.ch" class="text-brand font-semibold hover:underline">info@vamdeco.ch</a>
      </p>
      <div data-reveal class="mt-10">
        <a href="/en" class="btn-anim inline-block rounded-full bg-brand px-8 py-3.5 font-semibold text-ink hover:bg-brand-dark uppercase tracking-wide text-sm">Back to home</a>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      try {
        if (sessionStorage.getItem('vd-lead-ok') !== '1') return;
        sessionStorage.removeItem('vd-lead-ok');
      } catch (e) { return; }
      var tenta = 0;
      (function invia() {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'generate_lead', { metodo: 'form_sito' });
        } else if (tenta++ < 30) {
          setTimeout(invia, 100);
        }
      })();
    })();
  </script>
</Base>
