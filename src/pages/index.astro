const servizi = [
  { titolo: 'Decorazione veicoli', href: '/decorazione-veicoli-ticino', ico: 'car', descr: 'Trasforma la tua auto, furgone o camion in una pubblicità in movimento con grafiche resistenti e personalizzate.' },
  { titolo: 'Decorazione vetrine', href: '/decorazione-vetrine-ticino', ico: 'house', descr: 'Attira clienti e valorizza il tuo brand con vetrine creative e su misura.' },
  { titolo: 'Abbigliamento personalizzato', href: '/abbigliamento-personalizzato-ticino', ico: 'tshirt', descr: 'Magliette, felpe e divise personalizzate per aziende, eventi e privati.' },
  { titolo: 'Pellicole satinate privacy', href: '/pellicole-satinate-ticino', ico: 'prohibit', descr: 'Pellicole satinate per privacy e design eleganti, ideali per uffici, bagni e negozi.' },
  { titolo: 'Oscuramento vetrate UV', href: '/oscuramento-vetrate-uv', ico: 'perspective', descr: 'Pellicole che riducono calore, abbagliamento e raggi UV, migliorando comfort e protezione degli ambienti.' },
  { titolo: 'Oscuramento vetri auto', href: '/oscuramento-vetri-auto-ticino', ico: 'carprofile', descr: 'Pellicole oscuranti per comfort, protezione UV e look moderno del tuo veicolo.' },
  { titolo: 'Adesivi e etichette', href: '/adesivi-e-etichette', ico: 'sticker', descr: 'Adesivi ed etichette personalizzate per prodotti, vetrine e veicoli: resistenti, precise e di qualità professionale.' },
  { titolo: 'Etichette resinate', href: '/etichette-resinate', ico: 'drop', descr: 'Loghi in rilievo con effetto 3D e finitura lucida (doming), resistenti ad acqua, graffi e raggi UV.' },
  { titolo: 'Cartellonistica', href: '/cartellonistica', ico: 'cards', descr: 'Insegne e pannelli su misura per dare visibilità e forza al tuo business.' },
  { titolo: 'Stampa su carta', href: '/stampa-su-carta', ico: 'printer', descr: 'Biglietti da visita, volantini, cataloghi e molto altro stampati con qualità professionale.' },
  { titolo: 'Siti web', href: '/siti-web', ico: 'mouse', descr: 'Siti web moderni, ottimizzati SEO e mobile-friendly per far crescere la tua attività online.' },
  { titolo: 'Personalizza la tua festa', href: '/personalizza-la-tua-festa', ico: 'confetti', descr: 'T-shirt, articoli in legno e decorazioni su misura per compleanni, baby shower e addii al celibato.' },
];

const numeri = [
  { n: anniEsperienza(), s: '+', l: 'Anni di esperienza', anniDa: ANNO_FONDAZIONE },
  { n: 500, s: '+', l: 'Progetti di successo' },
  { n: 300, s: '+', l: 'Clienti soddisfatti' },
  { n: 85, s: '+', l: 'Recensioni a 5 stelle' },
];

// Specialità: 3 valori (come originale) + 2 percentuali, in seconda riga centrata
const specialita = [
  { kicker: 'Affidabilità', titolo: 'Risultati<br>dimostrati', descr: 'Reputazione solida come partner affidabile: decorazioni e personalizzazioni di qualità che portano risultati concreti e clienti soddisfatti.' },
  { kicker: 'Artigianalità', titolo: 'Soluzioni<br>su misura', descr: 'Soluzioni personalizzate per decorazioni, abbigliamento, cartellonistica e altro, progettate sulle esigenze di ogni cliente e settore.' },
  { kicker: 'Relazione', titolo: 'Focus<br>sui clienti', descr: 'Il successo dei nostri clienti è la nostra priorità: capiamo le loro esigenze per offrire risultati che superano le aspettative.' },
  { kicker: 'Impatto', num: '150%', sotto: 'Aumento medio della visibilità del brand', descr: 'Le nostre decorazioni e personalizzazioni hanno portato a un incremento medio del 150% nella visibilità dei brand dei nostri clienti.' },
  { kicker: 'Visibilità', num: '80%', sotto: 'Maggiore visibilità del brand', descr: 'Grazie alle nostre soluzioni di decorazione e personalizzazione, i clienti hanno sperimentato un aumento dell\'80% nella visibilità.' },
];

// Ultimi 3 articoli per la sezione blog
const moduliArticoli = import.meta.glob('../dati/articoli/*.json', { eager: true });
const articoliRecenti = Object.values(moduliArticoli)
  .map((m: any) => m.default)
  .sort((a: any, b: any) => (b.dataIso || '').localeCompare(a.dataIso || ''))
  .slice(0, 3);

// FAQ home: domande generiche che toccano più servizi
const faqHome = [
  { domanda: 'Di cosa si occupa VAM Deco?', risposta: 'Ci occupiamo di decorazione e personalizzazione a 360 gradi: car wrapping e decorazione veicoli, oscuramento vetri, decorazione di vetrine e spazi commerciali, adesivi ed etichette personalizzate, abbigliamento personalizzato e stampa. Seguiamo ogni progetto dall\'idea grafica fino alla posa finale, tutto internamente qui in Ticino.' },
  { domanda: 'Quanto costano i vostri servizi?', risposta: 'Ogni lavoro è su misura, quindi il prezzo dipende da dimensioni, materiali e complessità della grafica. A titolo indicativo un wrapping parziale parte da qualche centinaio di franchi e uno completo si aggira tra 1\'500 e 3\'500 franchi, mentre stampe, adesivi e abbigliamento hanno costi più contenuti. Il modo più preciso per saperlo è richiedere un preventivo gratuito senza impegno.' },
  { domanda: 'Quanto tempo serve per realizzare un lavoro?', risposta: 'Dipende dal servizio: un oscuramento vetri richiede in genere mezza giornata, mentre un car wrapping completo dai 3 ai 7 giorni lavorativi. Per stampe, adesivi e abbigliamento i tempi partono di solito da pochi giorni lavorativi dopo l\'approvazione della grafica.' },
  { domanda: 'Quanto dura una pellicola applicata?', risposta: 'Con materiali professionali e una posa a regola d\'arte una pellicola di car wrapping dura in media dai 5 ai 7 anni. Anche le pellicole per vetrine e veicoli commerciali resistono a sole, pioggia e lavaggi mantenendo i colori vividi nel tempo.' },
  { domanda: 'L\'oscuramento dei vetri auto è legale in Svizzera?', risposta: 'Sì, ma con regole precise. In Svizzera il parabrezza e i vetri anteriori devono lasciar passare almeno il 70% della luce, mentre lunotto e vetri posteriori possono essere oscurati liberamente. Usiamo solo pellicole conformi, così il veicolo resta in regola anche al collaudo.' },
  { domanda: 'Come si mantiene un veicolo o una vetrina decorata?', risposta: 'Basta poco: un lavaggio delicato a mano con acqua e sapone neutro, evitando gli autolavaggi con spazzole e i prodotti aggressivi o a base di solventi. Dopo una nuova applicazione consigliamo di attendere circa una settimana prima del primo lavaggio.' },
  { domanda: 'Posso ordinare anche un solo pezzo o piccole quantità?', risposta: 'Sì. Realizziamo sia il pezzo singolo sia grandi quantità, che si tratti di una maglietta personalizzata, di pochi adesivi o di una serie di etichette. Per le tirature più alte il costo del singolo pezzo si riduce.' },
  { domanda: 'Devo già avere la grafica pronta o la create voi?', risposta: 'Non serve avere nulla di pronto. Possiamo partire da un vostro file oppure occuparci noi dell\'intera grafica, dal logo al progetto completo, adattandola al materiale e alla superficie finale. Prima di produrre vi mostriamo sempre un\'anteprima da approvare.' },
];
---
<Base
  title="VAM Deco | Decorazione Veicoli e Vetrine in Ticino"
  description="Decorazione veicoli, vetrine, abbigliamento personalizzato e pellicole oscuranti in Ticino. Richiedi subito un preventivo gratuito per la tua azienda."
>
  <!-- HERO: titolo con 'vita' nel riquadro storto + megafono, testo centrato, volpe con scritta scorrevole e sfumatura, badge #1 -->
  <section class="relative pattern-hero overflow-hidden">
    <!-- sfumatura arancione: piena ai piedi della volpe, sale coprendo la volpe e svanisce all'altezza dei bottoni -->
    <div class="sfumatura-hero" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 pt-14 md:pt-20 text-center" data-reveal-stagger>
      <!-- TITOLO -->
      <h1 data-reveal class="titolo-hero font-display font-bold text-white">
        <span class="riga-titolo">
          <span>Diamo</span>
          <span class="pill-vita"><span>vita</span></span>
        </span>
        <span class="riga-titolo">
          <span>alle tue idee</span>
          <span class="badge-megafono"><img src="/img/megafono-doodle.png" alt="" aria-hidden="true" /></span>
        </span>
      </h1>
      <!-- DESCRIZIONE (centrata) -->
      <p data-reveal class="mx-auto mt-7 max-w-2xl text-lg text-carta/75">
