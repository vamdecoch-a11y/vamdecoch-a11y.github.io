      width: max-content;
      animation: scorri-hero 60s linear infinite;
    }
    .scritta-scroll-track span {
      font-family: 'Unbounded', sans-serif;
      font-weight: 500;
      font-size: clamp(3rem, 10vw, 6rem);
      color: rgba(255, 255, 255, 0.88);
      line-height: 1.3;
      text-shadow: 0 6px 22px rgba(0, 0, 0, 0.55), 0 2px 6px rgba(0, 0, 0, 0.4);
    }
    @keyframes scorri-hero {
      to { transform: translateX(-50%); }
    }
    /* sfumatura arancione: piena ai piedi, sale coprendo la volpe, svanisce all'altezza dei bottoni */
    .sfumatura-hero {
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      height: clamp(460px, 52vw, 700px);
      z-index: 0;
      pointer-events: none;
      background: linear-gradient(180deg, transparent 0%, rgba(245, 131, 39, 0.06) 24%, rgba(245, 131, 39, 0.22) 58%, rgba(245, 131, 39, 0.5) 92%);
    }
    /* badge #1 galleggiante */
    .badge-stat {
      position: absolute;
      z-index: 20;
      right: clamp(0.5rem, 4vw, 3.5rem);
      bottom: clamp(0.5rem, 3vw, 2rem);
      max-width: 340px;
      border-radius: 1.4rem;
      border: 1px solid rgba(255, 255, 255, 0.5);
      background: rgba(10, 10, 10, 0.42);
