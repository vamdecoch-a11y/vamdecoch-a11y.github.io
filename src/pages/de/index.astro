---
import Base from '../../layouts/Base.astro';
import ParoleScroll from '../../components/ParoleScroll.astro';
import RecensioniEleganti from '../../components/RecensioniEleganti.astro';
import { recensioniStandard } from '../../dati/recensioni';
import { anniEsperienza, ANNO_FONDAZIONE } from '../../dati/statistiche';
import { ICONE } from '../../dati/icone-servizi';

const servizi = [
  { titolo: 'Fahrzeugbeschriftung', href: '/de/decorazione-veicoli-ticino', ico: 'car', descr: 'Verwandeln Sie Ihr Auto, Ihren Lieferwagen oder LKW mit langlebigen, individuellen Grafiken in mobile Werbung.' },
  { titolo: 'Schaufensterbeschriftung', href: '/de/decorazione-vetrine-ticino', ico: 'house', descr: 'Gewinnen Sie Kunden und stärken Sie Ihre Marke mit kreativen, massgeschneiderten Schaufenstern.' },
  { titolo: 'Personalisierte Bekleidung', href: '/de/abbigliamento-personalizzato-ticino', ico: 'tshirt', descr: 'T-Shirts, Hoodies und Uniformen nach Mass für Unternehmen, Events und Privatpersonen.' },
  { titolo: 'Sichtschutzfolien satiniert', href: '/de/pellicole-satinate-ticino', ico: 'prohibit', descr: 'Satinierte Folien für Sichtschutz und elegantes Design, ideal für Büros, Bäder und Geschäfte.' },
  { titolo: 'UV-Fensterfolien', href: '/de/oscuramento-vetrate-uv', ico: 'perspective', descr: 'Folien, die Hitze, Blendung und UV-Strahlen reduzieren, für mehr Komfort und Schutz Ihrer Räume.' },
  { titolo: 'Autoscheiben-Tönung', href: '/de/oscuramento-vetri-auto-ticino', ico: 'carprofile', descr: 'Tönungsfolien für Komfort, UV-Schutz und einen modernen Look Ihres Fahrzeugs.' },
  { titolo: 'Aufkleber und Etiketten', href: '/de/adesivi-e-etichette', ico: 'sticker', descr: 'Individuelle Aufkleber und Etiketten für Produkte, Schaufenster und Fahrzeuge: langlebig, präzise und in professioneller Qualität.' },
  { titolo: 'Doming-Etiketten', href: '/de/etichette-resinate', ico: 'drop', descr: 'Erhabene Logos mit 3D-Effekt und glänzender Doming-Oberfläche, beständig gegen Wasser, Kratzer und UV.' },
  { titolo: 'Beschilderung', href: '/de/cartellonistica', ico: 'cards', descr: 'Massgeschneiderte Schilder und Tafeln, die Ihrem Unternehmen Sichtbarkeit und Wirkung verleihen.' },
  { titolo: 'Papierdruck', href: '/de/stampa-su-carta', ico: 'printer', descr: 'Visitenkarten, Flyer, Kataloge und vieles mehr in professioneller Druckqualität.' },
  { titolo: 'Websites', href: '/de/siti-web', ico: 'mouse', descr: 'Moderne, SEO-optimierte und mobilfreundliche Websites, um Ihr Geschäft online wachsen zu lassen.' },
  { titolo: 'Gestalten Sie Ihr Fest', href: '/de/personalizza-la-tua-festa', ico: 'confetti', descr: 'T-Shirts, Holzartikel und Dekorationen nach Mass für Geburtstage, Baby-Partys und Junggesellenabschiede.' },
];

const numeri = [
  { n: anniEsperienza(), s: '+', l: 'Jahre Erfahrung', anniDa: ANNO_FONDAZIONE },
  { n: 500, s: '+', l: 'Erfolgreiche Projekte' },
  { n: 300, s: '+', l: 'Zufriedene Kunden' },
  { n: 85, s: '+', l: '5-Sterne-Bewertungen' },
];

const specialita = [
  { kicker: 'Zuverlässigkeit', titolo: 'Bewiesene<br>Ergebnisse', descr: 'Ein solider Ruf als zuverlässiger Partner: hochwertige Dekoration und Personalisierung, die konkrete Ergebnisse und zufriedene Kunden bringen.' },
  { kicker: 'Handwerk', titolo: 'Massgeschneiderte<br>Lösungen', descr: 'Individuelle Lösungen für Dekoration, Bekleidung, Beschilderung und mehr, abgestimmt auf die Bedürfnisse jedes Kunden und jeder Branche.' },
  { kicker: 'Beziehung', titolo: 'Kunden im<br>Fokus', descr: 'Der Erfolg unserer Kunden hat für uns Priorität: Wir verstehen ihre Bedürfnisse, um Ergebnisse zu liefern, die die Erwartungen übertreffen.' },
  { kicker: 'Wirkung', num: '150%', sotto: 'Durchschnittliche Steigerung der Markensichtbarkeit', descr: 'Unsere Dekorations- und Personalisierungsarbeit hat zu einer durchschnittlichen Steigerung der Markensichtbarkeit um 150 % geführt.' },
  { kicker: 'Sichtbarkeit', num: '80%', sotto: 'Mehr Markensichtbarkeit', descr: 'Dank unserer Dekorations- und Personalisierungslösungen haben Kunden eine Zunahme der Sichtbarkeit um 80 % erlebt.' },
];

// FAQ Startseite: allgemeine Fragen, die mehrere Leistungen betreffen
const faqHome = [
  { domanda: 'Was macht VAM Deco?', risposta: 'Wir kümmern uns rundum um Dekoration und Personalisierung: Car-Wrapping und Fahrzeugbeschriftung, Scheibentönung, Gestaltung von Schaufenstern und Geschäftsräumen, individuelle Aufkleber und Etiketten, personalisierte Bekleidung und Druck. Wir begleiten jedes Projekt von der grafischen Idee bis zur finalen Montage, alles im eigenen Haus hier im Tessin.' },
  { domanda: 'Was kosten Ihre Leistungen?', risposta: 'Jeder Auftrag ist massgeschneidert, daher hängt der Preis von Grösse, Materialien und der Komplexität der Grafik ab. Als grober Richtwert: Eine Teilfolierung beginnt bei einigen Hundert Franken, eine Vollfolierung liegt zwischen CHF 1\'500 und 3\'500, während Drucke, Aufkleber und Bekleidung deutlich günstiger sind. Am genausten erfahren Sie es mit einer kostenlosen, unverbindlichen Offerte.' },
  { domanda: 'Wie lange dauert ein Auftrag?', risposta: 'Das hängt von der Leistung ab: Eine Scheibentönung dauert in der Regel einen halben Tag, ein komplettes Car-Wrapping 3 bis 7 Arbeitstage. Bei Drucken, Aufklebern und Bekleidung beginnen die Zeiten meist bei wenigen Arbeitstagen nach Freigabe der Grafik.' },
  { domanda: 'Wie lange hält eine aufgebrachte Folie?', risposta: 'Mit professionellen Materialien und fachgerechter Verarbeitung hält eine Car-Wrapping-Folie im Schnitt 5 bis 7 Jahre. Auch Folien für Schaufenster und Geschäftsfahrzeuge widerstehen Sonne, Regen und Wäschen und behalten ihre Farben lange lebendig.' },
  { domanda: 'Ist die Tönung von Autoscheiben in der Schweiz legal?', risposta: 'Ja, aber mit klaren Regeln. In der Schweiz müssen Frontscheibe und vordere Seitenscheiben mindestens 70 % des Lichts durchlassen, während Heckscheibe und hintere Seitenscheiben frei getönt werden dürfen. Wir verwenden nur konforme Folien, damit Ihr Fahrzeug auch bei der Prüfung vorschriftsgemäss bleibt.' },
  { domanda: 'Wie pflege ich ein foliertes Fahrzeug oder Schaufenster?', risposta: 'Es braucht nur wenig: eine sanfte Handwäsche mit Wasser und neutraler Seife, ohne Bürstenwaschanlagen und ohne aggressive oder lösungsmittelhaltige Produkte. Nach einer neuen Anwendung empfehlen wir, etwa eine Woche bis zur ersten Wäsche zu warten.' },
  { domanda: 'Kann ich auch ein einzelnes Stück oder kleine Mengen bestellen?', risposta: 'Ja. Wir fertigen sowohl Einzelstücke als auch grosse Auflagen, sei es ein personalisiertes T-Shirt, einige Aufkleber oder eine Serie von Etiketten. Bei höheren Auflagen sinkt der Preis pro Stück.' },
  { domanda: 'Muss die Grafik schon fertig sein oder erstellen Sie sie?', risposta: 'Sie müssen nichts Fertiges haben. Wir können von Ihrer Datei ausgehen oder die gesamte Grafik selbst übernehmen, vom Logo bis zum kompletten Projekt, angepasst an Material und finale Oberfläche. Vor der Produktion zeigen wir Ihnen immer eine Vorschau zur Freigabe.' },
];
---
<Base
  title="VAM Deco | Fahrzeug- und Schaufensterbeschriftung im Tessin"
  description="Fahrzeug- und Schaufensterbeschriftung, personalisierte Bekleidung und Tönungsfolien im Tessin. Fordern Sie noch heute eine kostenlose Offerte für Ihr Unternehmen an."
  i18n
>
  <!-- HERO -->
  <section class="relative pattern-hero overflow-hidden">
    <div class="sfumatura-hero" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 pt-14 md:pt-20 text-center" data-reveal-stagger>
      <h1 data-reveal class="titolo-hero font-display font-bold text-white">
        <span class="riga-titolo">
          <span>Wir erwecken Ihre</span>
          <span class="pill-vita"><span>Ideen</span></span>
        </span>
        <span class="riga-titolo">
          <span>zum Leben</span>
          <span class="badge-megafono"><img src="/img/megafono-doodle.png" alt="" aria-hidden="true" /></span>
        </span>
      </h1>
      <p data-reveal class="mx-auto mt-7 max-w-2xl text-lg text-carta/75">
        Seit über {anniEsperienza()} Jahren sind wir im Tessin die erste Adresse für die Beschriftung von Fahrzeugen,
        Schaufenstern, Beschilderung und Druck, mit personalisierter Bekleidung für Unternehmen, Events und Privatpersonen.
      </p>
      <div data-reveal class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#servizi" class="btn-anim rounded-full bg-brand px-7 py-3.5 font-semibold text-ink hover:bg-brand-dark">
          Unsere Leistungen entdecken
        </a>
        <a
          href="https://wa.me/41765889497?text=Hallo%20VAM%20Deco%2C%20ich%20h%C3%A4tte%20gerne%20eine%20Offerte"
          target="_blank" rel="noopener"
          class="btn-anim rounded-full border-2 border-white/20 px-7 py-3.5 font-semibold hover:border-brand hover:text-brand"
        >Offerte via WhatsApp</a>
      </div>
    </div>

    <div class="zona-volpe">
      <div class="scritta-scroll" aria-hidden="true">
        <div class="scritta-scroll-track">
          <span>360°-Designagentur</span><span>360°-Designagentur</span><span>360°-Designagentur</span><span>360°-Designagentur</span>
          <span>360°-Designagentur</span><span>360°-Designagentur</span><span>360°-Designagentur</span><span>360°-Designagentur</span>
        </div>
      </div>
      <img src="/img/volpe.png" alt="Das Fuchs-Maskottchen von VAM Deco" class="volpe-hero" loading="eager" />
      <div class="badge-stat">
        <div class="badge-stat-titolo">#1 Agentur für Dekoration und Personalisierung im Tessin</div>
        <div class="badge-stat-riga">
          <span class="badge-stat-stelle" aria-label="5 Sterne">★★★★★</span>
          <span class="badge-stat-sub">300+ Zufriedene Kunden</span>
        </div>
      </div>
    </div>
  </section>

  <!-- LEISTUNGEN -->
  <section id="servizi" class="max-w-6xl mx-auto px-4 py-16 md:py-20">
    <h2 data-reveal class="text-2xl md:text-4xl font-bold mb-10">Unsere Leistungen</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 [grid-auto-rows:1fr]" data-reveal-stagger>
      {servizi.map((s) => (
        <a href={s.href} data-reveal class="group card-scura card-anim rounded-2xl p-6 flex flex-col h-full">
          <div class="flex items-center gap-4 min-h-[3.5rem]">
            <span class="ico-servizio shrink-0" set:html={ICONE[s.ico]} />
            <h3 class="font-display text-sm font-bold tracking-wide uppercase leading-tight group-hover:text-brand transition-colors">{s.titolo}</h3>
          </div>
          <p class="mt-5 text-sm text-carta/65 leading-relaxed">{s.descr}</p>
          <span class="mt-auto pt-5 inline-flex items-center gap-1.5 text-xs font-bold tracking-widest text-brand">MEHR ERFAHREN <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
    <div class="mt-10 text-center">
      <a data-reveal href="/de/servizi" class="btn-anim inline-flex items-center gap-2 rounded-full bg-brand px-8 py-3.5 font-semibold text-ink hover:bg-brand-dark">
        Alle Leistungen ansehen <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- WIR ERWECKEN ZUM LEBEN -->
  <ParoleScroll
    prefisso="Wir erwecken zum Leben"
    parole={['Ihre Fahrzeuge.', 'Ihre Schaufenster.', 'Ihre Bekleidung.', 'Ihre Scheiben.', 'Ihre Schilder.', 'Ihre Events.', 'Ihre Ideen.']}
    sfondo="/img/diamo-vita-sfondo.jpg"
    statistiche={numeri}
  />

  <!-- BEWERTUNGEN -->
  <section class="border-y border-white/5 bg-white/[0.02]">
    <RecensioniEleganti recensioni={recensioniStandard} />
  </section>

  <!-- SPEZIALITÄTEN -->
  <section class="max-w-6xl mx-auto px-4 py-16 md:py-20">
    <div class="mb-12 max-w-2xl" data-reveal-stagger>
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-3 uppercase">Unsere Methode</div>
      <h2 data-reveal class="font-display text-3xl md:text-5xl font-bold leading-tight">Unsere <span class="text-brand">Spezialitäten</span></h2>
    </div>
    <div class="grid gap-5 md:grid-cols-6 [grid-auto-rows:1fr]" data-reveal-stagger>
      {specialita.map((s, i) => (
        <div data-reveal class={`card-scura card-anim group relative overflow-hidden rounded-3xl p-8 ${i >= 3 ? 'md:col-span-3' : 'md:col-span-2'}`}>
          <span class="font-display pointer-events-none absolute -right-3 -top-8 text-[130px] font-extrabold leading-none text-white/[0.055] select-none">{String(i + 1).padStart(2, '0')}</span>
          <div class="relative">
            <div class="flex items-center gap-2.5">
              <span class="inline-flex h-2.5 w-2.5 rounded-full bg-brand"></span>
              <span class="text-[11px] font-medium uppercase tracking-[0.2em] text-carta/50">{s.kicker}</span>
            </div>
            {s.num ? (
              <>
                <div class="font-display mt-6 text-5xl font-extrabold leading-none text-brand">{s.num}</div>
                <h3 class="font-display mt-2.5 text-lg font-bold leading-tight">{s.sotto}</h3>
              </>
            ) : (
              <h3 class="font-display mt-7 text-2xl font-bold leading-tight" set:html={s.titolo}></h3>
            )}
            <p class="mt-3 text-sm leading-relaxed text-carta/65">{s.descr}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-4 py-16 md:py-20">
    <div class="text-center mb-10" data-reveal-stagger>
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-3 uppercase">Häufige Fragen</div>
      <h2 data-reveal class="font-display text-3xl md:text-4xl font-bold">Die Antworten, die Sie suchen</h2>
    </div>
    <div class="space-y-3" data-reveal-stagger>
      {faqHome.map((f) => (
        <details data-reveal class="faq-item card-scura rounded-2xl px-5 py-4 group">
          <summary class="flex items-center justify-between cursor-pointer list-none font-semibold gap-4">
            <span>{f.domanda}</span>
            <span class="text-brand text-2xl leading-none transition-transform duration-300 group-open:rotate-45 shrink-0">+</span>
          </summary>
          <div class="faq-risposta"><div class="overflow-hidden"><p class="pt-3 text-sm text-carta/70 leading-relaxed">{f.risposta}</p></div></div>
        </details>
      ))}
    </div>
  </section>

  <!-- FINALE CTA -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-20 text-center" data-reveal-stagger>
      <h2 data-reveal class="text-2xl md:text-4xl font-bold">Haben Sie ein Projekt im Kopf?</h2>
      <p data-reveal class="mt-4 text-carta/70">Wir antworten schnell per WhatsApp oder E-Mail. Kostenlose Offerte in 24/48 Std.</p>
      <div data-reveal class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/de/contattaci" class="btn-anim rounded-full bg-brand px-7 py-3.5 font-semibold text-ink hover:bg-brand-dark">Jetzt Kontakt aufnehmen</a>
        <a href="tel:+41765889497" class="btn-anim rounded-full border-2 border-white/20 px-7 py-3.5 font-semibold hover:border-brand hover:text-brand">+41 76 588 94 97</a>
      </div>
    </div>
  </section>

  <style>
    /* ---------- TITOLO HERO ---------- */
    .titolo-hero {
      font-size: clamp(2.3rem, 7.6vw, 4.4rem);
      line-height: 0.92;
      letter-spacing: -0.03em;
    }
    .riga-titolo {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0.12em 0.28em;
    }
    .riga-titolo + .riga-titolo { margin-top: 0.12em; }
    .pill-vita {
      display: inline-flex;
      background: #F58327;
      border-radius: 0;
      padding: 0.02em 0.2em;
      transform: rotate(3deg);
    }
    .pill-vita > span {
      display: inline-block;
      color: #0a0a0a;
      transform: rotate(-3deg);
    }
    .badge-megafono {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: clamp(54px, 8.2vw, 84px);
      height: clamp(54px, 8.2vw, 84px);
      margin-left: -0.14em;
      border-radius: 999px;
      background: #F58327;
      overflow: hidden;
      flex: none;
    }
    .badge-megafono img {
      width: 92%;
      height: 92%;
      object-fit: contain;
      transform: rotate(-16deg);
    }

    /* ---------- ZONA VOLPE ---------- */
    .zona-volpe {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: flex-end;
      margin-top: clamp(0.5rem, 2vw, 2rem);
      min-height: clamp(340px, 46vw, 600px);
    }
    .volpe-hero {
      position: relative;
      z-index: 10;
      height: clamp(320px, 43vw, 575px);
      width: auto;
      object-fit: contain;
      transform: translateX(-12.5%);
      filter: drop-shadow(8px 10px 14px rgba(0, 0, 0, 0.45));
    }
    .scritta-scroll {
      position: absolute;
      top: 50%;
      left: 0;
      width: 100%;
      transform: translateY(-50%);
      z-index: 1;
      overflow: hidden;
      white-space: nowrap;
      pointer-events: none;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    }
    .scritta-scroll-track {
      display: inline-flex;
      align-items: center;
      gap: 2.5rem;
      padding: 0.45em 2.5rem 0.7em 0;
      width: max-content;
      animation: scorri-hero 60s linear infinite;
    }
    .scritta-scroll-track span {
      font-family: 'Unbounded', sans-serif;
      font-weight: 500;
      font-size: clamp(3rem, 10vw, 6rem);
      color: rgba(255, 255, 255, 0.88);
      line-height: 1.3;
      text-shadow: 0 6px 22px rgba(0, 0, 0, 0.55), 0 2px 6px rgba(0, 0, 0, 0.4);
    }
    @keyframes scorri-hero {
      to { transform: translateX(-50%); }
    }
    .sfumatura-hero {
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      height: clamp(460px, 52vw, 700px);
      z-index: 0;
      pointer-events: none;
      background: linear-gradient(180deg, transparent 0%, rgba(245, 131, 39, 0.06) 24%, rgba(245, 131, 39, 0.22) 58%, rgba(245, 131, 39, 0.5) 92%);
    }
    .badge-stat {
      position: absolute;
      z-index: 20;
      right: clamp(0.5rem, 4vw, 3.5rem);
      bottom: clamp(0.5rem, 3vw, 2rem);
      max-width: 340px;
      border-radius: 1.4rem;
      border: 1px solid rgba(255, 255, 255, 0.5);
      background: rgba(10, 10, 10, 0.42);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      padding: 1.1rem 1.25rem;
      text-align: left;
    }
    .badge-stat-titolo {
      font-family: 'Unbounded', sans-serif;
      font-weight: 600;
      font-size: 0.92rem;
      line-height: 1.3;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: #fff;
    }
    .badge-stat-riga {
      margin-top: 0.7rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .badge-stat-stelle { color: #FF8442; letter-spacing: 0.15em; font-size: 0.95rem; }
    .badge-stat-sub { color: rgba(255, 255, 255, 0.85); font-size: 0.85rem; }

    /* ---------- ICONA SERVIZIO ---------- */
    .ico-servizio {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3.25rem;
      height: 3.25rem;
      border-radius: 1rem;
      background: rgba(255, 255, 255, 0.05);
    }

    @media (max-width: 640px) {
      section.pattern-hero { overflow: visible; }
      .zona-volpe {
        flex-direction: column;
        align-items: center;
        min-height: 0;
        margin-top: 5.5rem;
      }
      .badge-stat {
        position: relative;
        right: auto;
        left: auto;
        z-index: 30;
        max-width: 92%;
        margin: 1.25rem auto 0;
        text-align: center;
        transform: translateY(calc(50% + 12px));
      }
      #servizi { padding-top: 6.5rem; }
      .badge-stat-riga { align-items: center; }
      .volpe-hero { height: 368px; }
      .scritta-scroll { top: 11.5rem; }
      .sfumatura-hero { height: 64%; }
    }
    @media (prefers-reduced-motion: reduce) {
      .scritta-scroll-track { animation: none; }
    }
  </style>
</Base>
