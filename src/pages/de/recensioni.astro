---
// BEWERTUNGEN (DE): alle echten Google-Bewertungen, übersetzt. Gleiches Layout wie IT.
import Base from '../../layouts/Base.astro';
import FormContatti from '../../components/FormContatti.astro';
import WhatsAppTondo from '../../components/WhatsAppTondo.astro';
import { recensioniTutteDE, linkRecensioniGoogle } from '../../dati/recensioni';

const stelle = '★★★★★';
---
<Base
  title="Kundenbewertungen | Was man über VAM Deco sagt"
  description="Echte Google-Bewertungen von Kunden, die sich für VAM Deco entschieden haben: Fahrzeug- und Schaufensterbeschriftung, Bekleidung und personalisierter Druck im Tessin. Alle 5 Sterne."
  i18n
>
  <!-- HERO -->
  <section class="relative pattern-hero overflow-hidden">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-3xl mx-auto px-4 pt-20 pb-16 text-center" data-reveal-stagger>
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-4 uppercase">Bewertungen</div>
      <h1 data-reveal class="text-3xl md:text-5xl font-bold leading-tight tracking-tight" style="text-wrap: balance">
        Die Worte unserer <span class="text-brand">Kunden</span>
      </h1>
      <div data-reveal class="mt-6 flex items-center justify-center gap-3">
        <span class="text-brand text-2xl tracking-wide" aria-hidden="true">{stelle}</span>
        <span class="font-display font-semibold">5.0 auf Google</span>
      </div>
      <p data-reveal class="mt-5 text-carta/75 leading-relaxed">
        Echte Bewertungen, mit vollem Namen, auf Google hinterlassen von Unternehmen und Privatpersonen, die uns vertraut haben.
      </p>
    </div>
  </section>

  <!-- BEWERTUNGSWAND -->
  <section class="max-w-6xl mx-auto px-4 py-14">
    <div class="columns-1 md:columns-2 lg:columns-3 gap-5" data-reveal-stagger>
      {recensioniTutteDE.map((r) => (
        <figure data-reveal class="card-anim break-inside-avoid mb-5 rounded-2xl border border-white/10 bg-superficie p-6">
          <div class="text-brand tracking-wide" aria-label="5 von 5 Sternen">{stelle}</div>
          <blockquote class="mt-3 text-sm md:text-base text-carta/85 leading-relaxed">{r.testo}</blockquote>
          <figcaption class="mt-4 flex items-center gap-3">
            {r.avatar
              ? <img src={r.avatar} alt="" class="w-9 h-9 rounded-full object-cover" loading="lazy" />
              : <span class="w-9 h-9 rounded-full bg-brand/20 text-brand grid place-items-center font-display font-bold text-sm" aria-hidden="true">{r.nome.charAt(0)}</span>}
            <div>
              <div class="font-display text-sm font-semibold">{r.nome}</div>
              <div class="text-xs text-carta/50">Google-Bewertung</div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>

    <div data-reveal class="mt-10 flex flex-col sm:flex-row justify-center gap-3">
      <a href={linkRecensioniGoogle} target="_blank" rel="noopener" class="btn-anim w-full sm:w-auto text-center rounded-full bg-brand px-7 py-3.5 font-semibold text-ink hover:bg-brand-dark">
        Alle auf Google ansehen
      </a>
      <a href={linkRecensioniGoogle} target="_blank" rel="noopener" class="btn-anim w-full sm:w-auto text-center rounded-full border-2 border-white/20 px-7 py-3.5 font-semibold hover:border-brand hover:text-brand">
        Bewertung abgeben
      </a>
    </div>
  </section>

  <!-- FINALE CTA -->
  <section id="contattaci" class="border-t border-white/5 bg-white/[0.02]">
    <div class="max-w-5xl mx-auto px-4 py-20 text-center">
      <h2 data-reveal class="font-display text-3xl md:text-5xl font-bold text-brand">Möchten Sie der Nächste sein?</h2>
      <p data-reveal class="mt-4 text-carta/70">Erzählen Sie uns Ihre Idee: kostenlose Offerte in 24/48 Std.</p>
      <div class="max-w-2xl mx-auto mt-10">
        <FormContatti oggetto="Richiesta dalla pagina Recensioni (DE)" origine="Pagina Recensioni DE" />
      </div>
    </div>
  </section>

  <WhatsAppTondo testo="Hallo VAM Deco, ich hätte gerne eine Offerte." />
</Base>
