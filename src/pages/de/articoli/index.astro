---
// BLOG (DE): Artikelübersicht. Neuester Beitrag über die volle Breite, die anderen im Raster.
// Artikel aus src/dati/articoli-de/*.json.
import Base from '../../../layouts/Base.astro';
import SezioneParliamo from '../../../components/SezioneParliamo.astro';
import WhatsAppTondo from '../../../components/WhatsAppTondo.astro';

const moduli = import.meta.glob('../../../dati/articoli-de/*.json', { eager: true });
const articoli = Object.values(moduli)
  .map((m: any) => m.default ?? m)
  .sort((a: any, b: any) => (a.dataIso < b.dataIso ? 1 : -1));
const [primo, ...altri] = articoli;
---
<Base
  title="Blog | Tipps und Projekte zu Dekoration und Personalisierung | VAM Deco"
  description="Ratgeber, Tipps und echte Projekte aus der Werkstatt von VAM Deco: Fahrzeugbeschriftung, Scheibentönung, DTF-Druck, personalisierte Bekleidung und vieles mehr."
  i18n
>
  <!-- HERO -->
  <section class="relative pattern-hero overflow-hidden">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-3xl mx-auto px-4 pt-20 pb-14 text-center" data-reveal-stagger>
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-4 uppercase">Blog</div>
      <h1 data-reveal class="text-3xl md:text-5xl font-bold leading-tight tracking-tight" style="text-wrap: balance">
        Ideen, Projekte und <span class="text-brand">Tipps</span>
      </h1>
      <p data-reveal class="mt-8 text-carta/80 leading-relaxed">
        Aus unserer Werkstatt in Sementina: echte Projekte, praktische Ratgeber und Tipps zu
        Dekoration, Personalisierung und Druck.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-14">
    {primo && (
      <a data-reveal href={`/de/articoli/${primo.slug}`} class="group grid md:grid-cols-2 gap-8 items-center rounded-3xl border border-white/10 bg-superficie overflow-hidden mb-12 card-anim">
        {primo.cover && (
          <div class="overflow-hidden h-64 md:h-96">
            <img src={primo.cover} alt={primo.h1} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="eager" />
          </div>
        )}
        <div class="p-7 md:p-10">
          <div class="flex items-center gap-3 text-xs font-bold tracking-widest uppercase">
            <span class="rounded-full bg-brand/15 text-brand px-3 py-1">{primo.categoria}</span>
            <span class="text-carta/45">{primo.data}</span>
          </div>
          <h2 class="mt-4 font-display text-xl md:text-2xl font-bold leading-snug group-hover:text-brand transition-colors" style="text-wrap: balance">{primo.h1}</h2>
          <p class="mt-3 text-sm md:text-base text-carta/65 leading-relaxed">{primo.estratto}</p>
          <span class="mt-5 inline-flex items-center gap-2 font-semibold text-brand">Artikel lesen <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
        </div>
      </a>
    )}

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {altri.map((a: any) => (
        <a data-reveal href={`/de/articoli/${a.slug}`} class="group rounded-2xl border border-white/10 bg-superficie overflow-hidden card-anim flex flex-col">
          {a.cover && (
            <div class="overflow-hidden h-48">
              <img src={a.cover} alt={a.h1} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            </div>
          )}
          <div class="p-6 flex flex-col grow">
            <div class="flex items-center gap-2.5 text-[0.65rem] font-bold tracking-widest uppercase">
              <span class="rounded-full bg-brand/15 text-brand px-2.5 py-0.5">{a.categoria}</span>
              <span class="text-carta/45">{a.data}</span>
            </div>
            <h2 class="mt-3 font-display font-bold leading-snug group-hover:text-brand transition-colors" style="text-wrap: balance">{a.h1}</h2>
            <p class="mt-2.5 text-sm text-carta/60 leading-relaxed line-clamp-3">{a.estratto}</p>
            <span class="mt-auto pt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand">Lesen <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <SezioneParliamo oggetto="Richiesta dal blog (DE)" origine="Blog DE (indice)" />

  <WhatsAppTondo testo="Hallo VAM Deco, ich hätte gerne Informationen." />
</Base>
