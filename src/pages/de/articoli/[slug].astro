---
// Dynamische Artikel-Route DE (/de/articoli/<slug>). Gleiches Layout, Inhalte aus articoli-de.
import ArticoloBlog from '../../../layouts/ArticoloBlog.astro';

export function getStaticPaths() {
  const moduli = import.meta.glob('../../../dati/articoli-de/*.json', { eager: true });
  return Object.values(moduli).map((m: any) => {
    const articolo = m.default ?? m;
    return { params: { slug: articolo.slug }, props: { articolo } };
  });
}

const { articolo } = Astro.props;
---
<ArticoloBlog articolo={articolo} />
