---
import Base from '../layouts/Base.astro';
import CardStack from '../components/CardStack.astro';
import dati from '../dati/pellicole-satinate-ticino.json';

// Benefici: nelle liste estratte come "01. Titolo: descrizione"
const sezBenefici = dati.sezioni.find((s) => (s.heading || '').startsWith('Hai bisogno di privacy'));
const benefici = (sezBenefici?.liste || []).map((v) => {
  const m = v.match(/^(\d+)\.\s*([^:]+):\s*(.*)$/s);
  return m ? { n: m[1], titolo: m[2].trim(), testo: m[3].trim() } : { n: '', titolo: v, testo: '' };
});

const fasi = [
  { t: 'Analisi delle tue esigenze', d: 'Capiremo insieme dove vuoi maggiore privacy (ufficio, bagno, vetrina…) e ti consiglieremo la soluzione più adatta.' },
  { t: 'Proposta su misura', d: 'Prepariamo un preventivo gratuito e ti mostriamo esempi e pellicole disponibili, anche con opzioni personalizzate.' },
  { t: 'Applicazione veloce e pulita', d: 'In pochi minuti la pellicola viene applicata senza polvere, rumori o lavori invasivi. Può essere rimossa in futuro senza danni.' },
  { t: 'Risultato immediato', d: 'Subito dopo l’applicazione avrai vetri opachi, eleganti e riservati. Più luce naturale, meno occhi indiscreti.' },
];

const perche = [
  { t: 'Esperienza Consolidata', d: 'Con anni di esperienza e numerosi progetti realizzati, abbiamo costruito una solida reputazione come partner di fiducia per la decorazione e la personalizzazione in Ticino.' },
  { t: 'Soluzioni su Misura', d: 'Ogni progetto è unico. Offriamo soluzioni personalizzate che rispondono alle specifiche esigenze di ogni cliente, garantendo sempre il miglior risultato.' },
  { t: 'Focalizzazione sul Cliente', d: 'La soddisfazione del cliente è al centro di tutto ciò che facciamo. Lavoriamo a stretto contatto con te per realizzare esattamente ciò che desideri.' },
  { t: 'Comunicazione Trasparente', d: 'Crediamo nell’importanza della trasparenza. Manteniamo una comunicazione costante e chiara in ogni fase del progetto.' },
];

const galleria = dati.immagini.filter((i) => (i.contesto || '').includes('alleria')).map((i) => i.srcArchivio);

const testimonianze = [
  { testo: 'Michele ha trasformato la nostra flotta aziendale con un design accattivante e professionale. La sua attenzione ai dettagli e il servizio personalizzato sono stati eccezionali.', nome: 'A. Rossi', avatar: 'G1bC6MQnKLl8c7ZyjwpJlVGuw.jpg' },
  { testo: 'Affidarci a VAM Deco per la decorazione delle nostre vetrine è stata una delle migliori decisioni per la nostra attività.', nome: 'M. Pestoni', avatar: 'vE17bXTh6LumndyjLk4ly8AzJY.png' },
  { testo: 'La qualità delle stampe e degli adesivi di VAM Deco è eccezionale. Non solo hanno rispettato le scadenze, ma hanno anche fornito un supporto costante.', nome: 'M. Ferraro', avatar: 'rM9PIBsqZjq8bCq7vWVwGPT2CI.jpg' },
  { testo: 'Siamo stati aiutati a migliorare la privacy e l’estetica della nostra casa con pellicole oscuranti di altissima qualità.', nome: 'E. Ricchino', avatar: 'rlizSNVuxrrqd6I5hGaSxwqn0Os.png' },
  { testo: 'Ho collaborato con diverse aziende di decorazione veicoli, ma VAM Deco e Michele hanno superato ogni aspettativa. Risposte rapide, lavoro impeccabile.', nome: 'N. Di Lorenzi', avatar: 'YfirIiUhVQXLMtaAlNTGBf13chY.png' },
];

// Dati strutturati FAQPage per Google e le risposte AI
const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: dati.faq.map((f) => ({
    '@type': 'Question',
    name: f.domanda,
    acceptedAnswer: { '@type': 'Answer', text: f.risposta },
  })),
});
---
<Base
  title="Pellicole satinate privacy per vetri in Ticino | VAM Deco"
  description="Pellicole satinate e opache per vetri in Ticino: privacy immediata senza perdere luce naturale, per uffici, negozi e case. Preventivo gratuito in 24/48h."
>
  <script type="application/ld+json" set:html={faqJsonLd} />

  <!-- HERO scura con pattern e bagliore, testi integrali centrati come l'originale -->
  <section class="relative pattern-hero overflow-hidden">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-3xl mx-auto px-4 pt-20 pb-24 text-center" data-reveal-stagger>
      <h1 data-reveal class="text-3xl md:text-5xl font-bold leading-tight tracking-tight">
        Pellicole opache e satinate per la privacy in Ticino
      </h1>
      <p data-reveal class="mt-8 text-carta/80 leading-relaxed">
        Vuoi più privacy in ufficio, a casa o nel tuo negozio senza tende o muri? Le pellicole satinate
        trasformano vetri e vetrate in superfici eleganti e riservate, lasciando entrare la luce naturale
        e valorizzando lo stile dei tuoi ambienti.
      </p>
      <p data-reveal class="mt-5 text-carta/80 leading-relaxed">
        In tutto il Ticino, da Bellinzona a Locarno, Lugano e Biasca, offriamo <strong class="text-carta">pellicole
        opache per vetri</strong> ideali per chi desidera proteggere i propri spazi da sguardi indiscreti senza
        rinunciare alla luminosità.
      </p>
      <p data-reveal class="mt-5 text-carta/80 leading-relaxed">
        Perfette per <strong class="text-carta">uffici, studi professionali, negozi e abitazioni private</strong>,
        creano ambienti moderni e sicuri con un risultato raffinato e duraturo.
      </p>
      <p data-reveal class="mt-8 font-display text-xl md:text-2xl font-bold text-brand leading-snug">
        Installazione rapida, con possibilità di personalizzare i vetri con loghi, scritte o pattern decorativi.
      </p>
      <div data-reveal class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#contattaci" class="btn-anim rounded-full bg-brand px-7 py-3.5 font-semibold text-ink hover:bg-brand-dark">
          Richiedi il tuo preventivo gratuito
        </a>
        <a
          href="https://wa.me/41765889497?text=Ciao%20VAM%20Deco%2C%20vorrei%20un%20preventivo%20per%20pellicola%20satinata%20%2F%20privacy."
          target="_blank" rel="noopener"
          class="btn-anim rounded-full border-2 border-white/20 px-7 py-3.5 font-semibold hover:border-brand hover:text-brand"
        >Scrivici su WhatsApp</a>
      </div>
      <div data-reveal class="mt-6 space-y-1.5">
        <p class="text-base md:text-lg font-semibold text-carta">Richiedi il tuo preventivo gratuito in <span class="text-brand">24/48h</span></p>
        <p class="text-base md:text-lg font-semibold text-carta/85">Ti rispondiamo velocemente su WhatsApp o via mail</p>
      </div>
    </div>
  </section>

  <!-- GALLERIA A PILA DI CARD: trascina o usa le frecce -->
  <section class="py-10">
    <CardStack
      immagini={galleria.map((img) => `/img/pellicole/${img}`)}
      alt="Lavoro di applicazione pellicola satinata privacy realizzato da VAM Deco in Ticino"
    />
  </section>

  <!-- BENEFICI -->
  <section class="border-y border-white/5 bg-white/[0.02] py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Benefici</div>
      <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-4">Hai bisogno di privacy, comfort e sicurezza nei tuoi spazi in Ticino?</h2>
      <p data-reveal class="max-w-3xl text-carta/70 mb-10">
        Con le nostre <strong class="text-carta">pellicole satinate e opache per vetri</strong> ottieni subito privacy ed eleganza,
        senza perdere luce naturale. Una soluzione semplice, veloce e duratura, ideale per uffici, studi, aziende e abitazioni.
      </p>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {benefici.map((b) => (
          <div data-reveal class="card-scura card-anim rounded-2xl p-6">
            <div class="font-display text-2xl font-bold text-brand">{b.n}</div>
            <div class="mt-2 font-semibold">{b.titolo}</div>
            {b.testo && <p class="mt-2 text-sm text-carta/65 leading-relaxed">{b.testo}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESSO IN 4 FASI: numeroni che si accendono d'arancione allo scroll -->
  <section class="max-w-5xl mx-auto px-4 py-20">
    <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Come funziona</div>
    <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-14">Il nostro Processo in 4 Fasi</h2>
    <div class="space-y-16">
      {fasi.map((f, i) => (
        <div class="fase-riga grid grid-cols-[auto_1fr] gap-6 md:gap-12 items-center">
          <div class="numero-fase">0{i + 1}</div>
          <div data-reveal>
            <div class="font-display text-lg md:text-2xl font-semibold">{f.t}</div>
            <p class="mt-2 text-sm md:text-base text-carta/65 leading-relaxed max-w-xl">{f.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- MACCHINA DA SCRIVERE, come sull'originale -->
  <section class="max-w-6xl mx-auto px-4 py-24 text-center">
    <h2 class="typewriter font-display text-3xl md:text-6xl font-bold text-brand">
      <span class="tw-testo" data-testo="Diamo vita alle tue idee"></span><span class="cursore">&nbsp;</span>
    </h2>
  </section>

  <!-- PERCHÉ NOI: sezione ARANCIONE piena, come l'originale -->
  <section class="bg-brand py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-ink/70 mb-2 uppercase">Perchè scegliere VAM Deco</div>
      <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-10 text-ink">Semplice, veloce, su misura. Ecco perché ci scelgono</h2>
      <div class="grid gap-5 md:grid-cols-2" data-reveal-stagger>
        {perche.map((p) => (
          <div data-reveal class="card-anim rounded-2xl bg-ink/90 border border-black/20 p-6">
            <div class="font-semibold text-carta">{p.t}</div>
            <p class="mt-2 text-sm text-carta/70 leading-relaxed">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIANZE con la scritta gigante dietro -->
  <section class="relative max-w-6xl mx-auto px-4 py-20 overflow-hidden">
    <div class="parola-gigante">TESTIMONIANZE</div>
    <div class="relative pt-24">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {testimonianze.map((t) => (
          <figure data-reveal class="card-scura card-anim rounded-2xl p-6 backdrop-blur-sm">
            <div class="text-brand text-sm tracking-widest" aria-label="5 stelle su 5">★★★★★</div>
            <blockquote class="mt-3 text-sm text-carta/80 leading-relaxed">"{t.testo}"</blockquote>
            <figcaption class="mt-4 flex items-center gap-3">
              <img src={`/img/pellicole/${t.avatar}`} alt={`Foto profilo della recensione di ${t.nome}`} class="w-9 h-9 rounded-full object-cover" loading="lazy" />
              <span class="text-sm font-semibold">{t.nome}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <a data-reveal href="/recensioni" class="mt-8 inline-block font-semibold text-brand hover:underline">Vedi le recensioni →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-y border-white/5 bg-white/[0.02] py-16">
    <div class="max-w-3xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Domande frequenti</div>
      <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-8">Hai Domande? Ecco le nostre Risposte!</h2>
      <div data-reveal-stagger>
        {dati.faq.map((f) => (
          <details data-reveal class="faq-item group border-b border-white/10 py-1">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 font-semibold text-sm md:text-base">
              {f.domanda}
              <span class="faq-chevron text-brand text-xl leading-none shrink-0">+</span>
            </summary>
            <div class="faq-risposta">
              <div>
                <p class="pb-5 text-sm text-carta/70 leading-relaxed">{f.risposta}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FORM CONTATTI (come l'originale; invio da collegare al backend al go-live) -->
  <section id="contattaci" class="relative overflow-hidden">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-20">
      <div class="grid gap-10 md:grid-cols-2 items-start">
        <div data-reveal-stagger>
          <h2 data-reveal class="font-display text-6xl md:text-8xl font-bold leading-[0.95]">Parli<br /><span class="text-brand">amo!</span></h2>
          <p data-reveal class="mt-6 text-carta/70 leading-relaxed">
            Compila il modulo e ricevi la tua offerta entro 24h. Oppure scrivici direttamente su WhatsApp.
          </p>
          <ul data-reveal class="mt-6 space-y-2.5 text-sm text-carta/80">
            <li><a href="tel:+41765889497" class="hover:text-brand font-semibold">+41 76 588 94 97</a></li>
            <li><a href="mailto:info@vamdeco.ch" class="hover:text-brand font-semibold">info@vamdeco.ch</a></li>
            <li>Via Pobbia 4d, 6514 Sementina, Ticino</li>
          </ul>
        </div>
        <form data-reveal class="card-scura rounded-2xl p-6 grid gap-4" id="form-contatti">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="grid gap-1.5 text-xs font-semibold">Nome*
              <input required name="nome" type="text" class="rounded-lg bg-white/5 border border-white/15 px-3.5 py-2.5 text-sm font-normal text-carta focus:border-brand outline-none" />
            </label>
            <label class="grid gap-1.5 text-xs font-semibold">Cognome*
              <input required name="cognome" type="text" class="rounded-lg bg-white/5 border border-white/15 px-3.5 py-2.5 text-sm font-normal text-carta focus:border-brand outline-none" />
            </label>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="grid gap-1.5 text-xs font-semibold">Azienda
              <input name="azienda" type="text" class="rounded-lg bg-white/5 border border-white/15 px-3.5 py-2.5 text-sm font-normal text-carta focus:border-brand outline-none" />
            </label>
            <label class="grid gap-1.5 text-xs font-semibold">Email*
              <input required name="email" type="email" class="rounded-lg bg-white/5 border border-white/15 px-3.5 py-2.5 text-sm font-normal text-carta focus:border-brand outline-none" />
            </label>
          </div>
          <label class="grid gap-1.5 text-xs font-semibold">Numero di telefono
            <input name="telefono" type="tel" class="rounded-lg bg-white/5 border border-white/15 px-3.5 py-2.5 text-sm font-normal text-carta focus:border-brand outline-none" />
          </label>
          <label class="grid gap-1.5 text-xs font-semibold">Messaggio*
            <textarea required name="messaggio" rows="4" placeholder="Fornisci più informazioni possibili per ricevere l'offerta entro 24h" class="rounded-lg bg-white/5 border border-white/15 px-3.5 py-2.5 text-sm font-normal text-carta placeholder:text-carta/40 focus:border-brand outline-none resize-y"></textarea>
          </label>
          <label class="grid gap-1.5 text-xs font-semibold">Come ci hai conosciuti?
            <select name="fonte" class="rounded-lg bg-superficie border border-white/15 px-3.5 py-2.5 text-sm font-normal text-carta focus:border-brand outline-none">
              <option>Google</option><option>Passaparola</option><option>Instagram</option><option>Facebook</option><option>Altri Social</option><option>Altro</option>
            </select>
          </label>
          <button type="submit" class="btn-anim rounded-full bg-brand px-7 py-3.5 font-semibold text-ink hover:bg-brand-dark">Invia</button>
          <p class="text-xs text-carta/50">*Campi obbligatori</p>
        </form>
      </div>
    </div>
  </section>

  <!-- WHATSAPP FLUTTUANTE (numero corretto) -->
  <a
    href="https://wa.me/41765889497?text=Ciao%20VAM%20Deco%2C%20vorrei%20un%20preventivo%20per%20pellicola%20satinata%20%2F%20privacy."
    target="_blank" rel="noopener"
    class="btn-anim fixed bottom-5 right-5 z-40 rounded-full bg-[#25D366] text-white px-5 py-3.5 text-sm font-semibold shadow-xl shadow-black/50"
    aria-label="Scrivici su WhatsApp per un preventivo"
  >Chat su WhatsApp</a>

  <script>
    // Numeroni del processo: si accendono d'arancione quando entrano nella fascia centrale dello schermo
    const osservaFasi = new IntersectionObserver((voci) => {
      voci.forEach((v) => v.target.classList.toggle('accesa', v.isIntersecting));
    }, { rootMargin: '-35% 0px -35% 0px' });
    document.querySelectorAll('.fase-riga').forEach((r) => osservaFasi.observe(r));

    // Macchina da scrivere: parte quando la sezione entra in vista
    const tw = document.querySelector<HTMLElement>('.tw-testo');
    if (tw) {
      const testo = tw.dataset.testo || '';
      const osservaTw = new IntersectionObserver((voci) => {
        if (!voci[0].isIntersecting) return;
        osservaTw.disconnect();
        let i = 0;
        const scrivi = () => {
          tw.textContent = testo.slice(0, i);
          i += 1;
          if (i <= testo.length) setTimeout(scrivi, 65);
        };
        scrivi();
      }, { threshold: 0.6 });
      osservaTw.observe(tw.closest('section')!);
    }
  </script>

  <script>
    // Anteprima: il modulo compone una email; al go-live verrà collegato al backend sul VPS
    document.getElementById('form-contatti')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(e.target as HTMLFormElement);
      const corpo = [
        `Nome: ${f.get('nome')} ${f.get('cognome')}`,
        f.get('azienda') ? `Azienda: ${f.get('azienda')}` : '',
        `Email: ${f.get('email')}`,
        f.get('telefono') ? `Telefono: ${f.get('telefono')}` : '',
        `Come ci hai conosciuti: ${f.get('fonte')}`,
        '', `${f.get('messaggio')}`,
      ].filter(Boolean).join('\n');
      location.href = `mailto:info@vamdeco.ch?subject=${encodeURIComponent('Richiesta preventivo pellicole satinate')}&body=${encodeURIComponent(corpo)}`;
    });
  </script>
</Base>
