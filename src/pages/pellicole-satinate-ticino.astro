---
import { readdirSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import GalleriaOrizzontale from '../components/GalleriaOrizzontale.astro';
import FormContatti from '../components/FormContatti.astro';
import RecensioniEleganti from '../components/RecensioniEleganti.astro';
import WhatsAppTondo from '../components/WhatsAppTondo.astro';
import dati from '../dati/pellicole-satinate-ticino.json';

// Benefici: nelle liste estratte come "01. Titolo: descrizione"
const sezBenefici = dati.sezioni.find((s) => (s.heading || '').startsWith('Hai bisogno di privacy'));
const benefici = (sezBenefici?.liste || []).map((v) => {
  const m = v.match(/^(\d+)\.\s*([^:]+):\s*(.*)$/s);
  return m ? { n: m[1], titolo: m[2].trim(), testo: m[3].trim() } : { n: '', titolo: v, testo: '' };
});

const fasi = [
  { t: 'Analisi delle tue esigenze', d: 'Capiremo insieme dove vuoi maggiore privacy (ufficio, bagno, vetrina…) e ti consiglieremo la soluzione più adatta.' },
  { t: 'Proposta su misura', d: 'Prepariamo un preventivo gratuito e ti mostriamo esempi e pellicole disponibili, anche con opzioni personalizzate.' },
  { t: 'Applicazione veloce e pulita', d: 'In pochi minuti la pellicola viene applicata senza polvere, rumori o lavori invasivi. Può essere rimossa in futuro senza danni.' },
  { t: 'Risultato immediato', d: 'Subito dopo l’applicazione avrai vetri opachi, eleganti e riservati. Più luce naturale, meno occhi indiscreti.' },
];

const perche = [
  { t: 'Esperienza Consolidata', d: 'Con anni di esperienza e numerosi progetti realizzati, abbiamo costruito una solida reputazione come partner di fiducia per la decorazione e la personalizzazione in Ticino.' },
  { t: 'Soluzioni su Misura', d: 'Ogni progetto è unico. Offriamo soluzioni personalizzate che rispondono alle specifiche esigenze di ogni cliente, garantendo sempre il miglior risultato.' },
  { t: 'Focalizzazione sul Cliente', d: 'La soddisfazione del cliente è al centro di tutto ciò che facciamo. Lavoriamo a stretto contatto con te per realizzare esattamente ciò che desideri.' },
  { t: 'Comunicazione Trasparente', d: 'Crediamo nell’importanza della trasparenza. Manteniamo una comunicazione costante e chiara in ogni fase del progetto.' },
];

// Galleria = TUTTE le foto nella cartella: basta aggiungerne una lì e alla prossima
// pubblicazione compare (pipeline pensata per il futuro caricamento via Telegram)
const galleria = readdirSync('public/img/pellicole/galleria')
  .filter((f: string) => /\.(jpe?g|png|webp)$/i.test(f))
  .sort();

const testimonianze = [
  { testo: 'Michele ha trasformato la nostra flotta aziendale con un design accattivante e professionale. La sua attenzione ai dettagli e il servizio personalizzato sono stati eccezionali.', nome: 'A. Rossi', avatar: 'G1bC6MQnKLl8c7ZyjwpJlVGuw.jpg' },
  { testo: 'Affidarci a VAM Deco per la decorazione delle nostre vetrine è stata una delle migliori decisioni per la nostra attività.', nome: 'M. Pestoni', avatar: 'vE17bXTh6LumndyjLk4ly8AzJY.png' },
  { testo: 'La qualità delle stampe e degli adesivi di VAM Deco è eccezionale. Non solo hanno rispettato le scadenze, ma hanno anche fornito un supporto costante.', nome: 'M. Ferraro', avatar: 'rM9PIBsqZjq8bCq7vWVwGPT2CI.jpg' },
  { testo: 'Siamo stati aiutati a migliorare la privacy e l’estetica della nostra casa con pellicole oscuranti di altissima qualità.', nome: 'E. Ricchino', avatar: 'rlizSNVuxrrqd6I5hGaSxwqn0Os.png' },
  { testo: 'Ho collaborato con diverse aziende di decorazione veicoli, ma VAM Deco e Michele hanno superato ogni aspettativa. Risposte rapide, lavoro impeccabile.', nome: 'N. Di Lorenzi', avatar: 'YfirIiUhVQXLMtaAlNTGBf13chY.png' },
];

// Dati strutturati FAQPage per Google e le risposte AI
const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: dati.faq.map((f) => ({
    '@type': 'Question',
    name: f.domanda,
    acceptedAnswer: { '@type': 'Answer', text: f.risposta },
  })),
});
---
<Base
  title="Pellicole satinate privacy per vetri in Ticino | VAM Deco"
  description="Pellicole satinate e opache per vetri in Ticino: privacy immediata senza perdere luce naturale, per uffici, negozi e case. Preventivo gratuito in 24/48h."
>
  <script type="application/ld+json" set:html={faqJsonLd} />

  <!-- HERO scura con pattern e bagliore, testi integrali centrati come l'originale -->
  <section class="relative pattern-hero overflow-hidden">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-3xl mx-auto px-4 pt-20 pb-24 text-center" data-reveal-stagger>
      <h1 data-reveal class="text-3xl md:text-5xl font-bold leading-tight tracking-tight">
        Pellicole opache e satinate per la privacy in Ticino
      </h1>
      <p data-reveal class="mt-8 text-carta/80 leading-relaxed">
        Vuoi più privacy in ufficio, a casa o nel tuo negozio senza tende o muri? Le pellicole satinate
        trasformano vetri e vetrate in superfici eleganti e riservate, lasciando entrare la luce naturale
        e valorizzando lo stile dei tuoi ambienti.
      </p>
      <p data-reveal class="mt-5 text-carta/80 leading-relaxed">
        In tutto il Ticino, da Bellinzona a Locarno, Lugano e Biasca, offriamo <strong class="text-carta">pellicole
        opache per vetri</strong> ideali per chi desidera proteggere i propri spazi da sguardi indiscreti senza
        rinunciare alla luminosità.
      </p>
      <p data-reveal class="mt-5 text-carta/80 leading-relaxed">
        Perfette per <strong class="text-carta">uffici, studi professionali, negozi e abitazioni private</strong>,
        creano ambienti moderni e sicuri con un risultato raffinato e duraturo.
      </p>
      <p data-reveal class="mt-8 font-display text-xl md:text-2xl font-bold text-brand leading-snug">
        Installazione rapida, con possibilità di personalizzare i vetri con loghi, scritte o pattern decorativi.
      </p>
      <div data-reveal class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#contattaci" class="btn-anim rounded-full bg-brand px-7 py-3.5 font-semibold text-ink hover:bg-brand-dark">
          Richiedi il tuo preventivo gratuito
        </a>
        <a
          href="https://wa.me/41765889497?text=Ciao%20VAM%20Deco%2C%20vorrei%20un%20preventivo%20per%20pellicola%20satinata%20%2F%20privacy."
          target="_blank" rel="noopener"
          class="btn-anim rounded-full border-2 border-white/20 px-7 py-3.5 font-semibold hover:border-brand hover:text-brand"
        >Scrivici su WhatsApp</a>
      </div>
      <div data-reveal class="mt-6 space-y-1.5">
        <p class="text-base md:text-lg font-semibold text-carta">Richiedi il tuo preventivo gratuito in <span class="text-brand">24/48h</span></p>
        <p class="text-base md:text-lg font-semibold text-carta/85">Ti rispondiamo velocemente su WhatsApp o via mail</p>
      </div>
    </div>
  </section>

  <!-- GALLERIA ORIZZONTALE: scendendo, le foto scorrono di lato -->
  <GalleriaOrizzontale
    immagini={galleria.map((img: string) => `/img/pellicole/galleria/${img}`)}
    alt="Lavoro di applicazione pellicola satinata privacy realizzato da VAM Deco in Ticino"
  />

  <!-- BENEFICI -->
  <section class="border-y border-white/5 bg-white/[0.02] py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Benefici</div>
      <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-4">Hai bisogno di privacy, comfort e sicurezza nei tuoi spazi in Ticino?</h2>
      <p data-reveal class="max-w-3xl text-carta/70 mb-10">
        Con le nostre <strong class="text-carta">pellicole satinate e opache per vetri</strong> ottieni subito privacy ed eleganza,
        senza perdere luce naturale. Una soluzione semplice, veloce e duratura, ideale per uffici, studi, aziende e abitazioni.
      </p>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {benefici.map((b) => (
          <div data-reveal class="card-scura card-anim rounded-2xl p-6">
            <div class="font-display text-2xl font-bold text-brand">{b.n}</div>
            <div class="mt-2 font-semibold">{b.titolo}</div>
            {b.testo && <p class="mt-2 text-sm text-carta/65 leading-relaxed">{b.testo}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESSO IN 4 FASI: sezione centrata, numeroni + linea che si illuminano, riquadri grigi -->
  <section class="max-w-3xl mx-auto px-4 py-20">
    <div class="text-center">
      <div data-reveal class="inline-block rounded-full bg-white/[0.06] border border-white/10 px-5 py-2 text-xs font-bold tracking-widest text-brand uppercase mb-3">Come funziona</div>
      <h2 data-reveal class="text-2xl md:text-4xl font-bold mb-14">Il nostro Processo in 4 Fasi</h2>
    </div>
    <div>
      {fasi.map((f, i) => (
        <div class="fase-riga grid grid-cols-[5.5rem_1fr] md:grid-cols-[9.5rem_1fr] gap-5 md:gap-10 items-stretch">
          <div class="fase-colonna">
            <div class="numero-fase w-full text-center">0{i + 1}</div>
            {i < fasi.length - 1 && <div class="fase-linea"><div class="fase-linea-riempi"></div></div>}
          </div>
          <div data-reveal class="card-scura rounded-2xl p-6 md:p-7 mb-6 self-start">
            <div class="inline-block rounded-full bg-white/[0.07] px-3.5 py-1 text-[10px] font-bold tracking-widest text-carta/60 uppercase">Step 0{i + 1}</div>
            <div class="mt-3 font-display text-lg md:text-2xl font-semibold">{f.t}</div>
            <p class="mt-2 text-sm md:text-base text-carta/65 leading-relaxed">{f.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA A METÀ PAGINA: scritta che si scrive e cancella in loop + form + freccia -->
  <section class="max-w-6xl mx-auto px-4 pt-6 pb-16 text-center">
    <h2 class="typewriter font-display text-3xl md:text-6xl font-bold text-brand min-h-[1.3em]">
      <span class="tw-testo" data-frasi='["Parliamone.", "Diamo vita alle tue idee."]'></span><span class="cursore">&nbsp;</span>
    </h2>
    <div class="max-w-2xl mx-auto mt-10">
      <FormContatti oggetto="Richiesta preventivo pellicole satinate" />
    </div>
    <div class="freccia-giu mt-12 mx-auto w-12 h-12 rounded-full border border-white/20 grid place-items-center text-brand text-xl" aria-hidden="true">↓</div>
  </section>

  <!-- PERCHÉ NOI: sezione ARANCIONE piena con card icone -->
  <section class="bg-brand py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-ink/70 mb-2 uppercase">Perchè scegliere VAM Deco</div>
      <h2 data-reveal class="text-2xl md:text-4xl font-bold mb-10 text-ink">Semplice, veloce, su misura.<br />Ecco perché ci scelgono</h2>
      <div class="grid gap-5 md:grid-cols-2" data-reveal-stagger>
        {perche.map((p, i) => (
          <div data-reveal class="card-anim rounded-2xl bg-ink/90 border border-black/20 p-7">
            <div class="w-12 h-12 rounded-xl bg-brand/15 border border-brand/30 grid place-items-center text-brand text-xl font-display font-bold">
              {['★', '✦', '◎', '✉'][i]}
            </div>
            <div class="mt-4 font-display text-lg font-semibold text-carta">{p.t}</div>
            <p class="mt-2 text-sm text-carta/70 leading-relaxed">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RECENSIONI: stile elegante con numero gigante e citazione che si compone -->
  <RecensioniEleganti recensioni={testimonianze.map((t) => ({ ...t, avatar: `/img/pellicole/${t.avatar}` }))} />
  <div class="text-center pb-16">
    <a data-reveal href="/recensioni" class="btn-anim inline-block rounded-full bg-brand px-8 py-3.5 font-semibold text-ink hover:bg-brand-dark">Vedi le recensioni</a>
  </div>

  <!-- FAQ -->
  <section class="border-y border-white/5 bg-white/[0.02] py-16">
    <div class="max-w-3xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Domande frequenti</div>
      <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-8">Hai Domande? Ecco le nostre Risposte!</h2>
      <div data-reveal-stagger class="space-y-4">
        {dati.faq.map((f) => (
          <details data-reveal class="faq-item faq-card group px-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 font-semibold text-sm md:text-base">
              {f.domanda}
              <span class="faq-bottone" aria-hidden="true">⌄</span>
            </summary>
            <div class="faq-risposta">
              <div>
                <p class="pb-5 text-sm text-carta/70 leading-relaxed">{f.risposta}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FORM CONTATTI (come l'originale; invio da collegare al backend al go-live) -->
  <section id="contattaci" class="relative overflow-hidden">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-20">
      <div class="grid gap-6 md:grid-cols-2 md:gap-4 items-center">
        <div data-reveal class="w-full text-center md:text-left">
          <!-- Su mobile una riga sola "Parliamo!", su desktop due righe sovrapposte col ! che sale -->
          <h2 class="font-display font-light leading-none md:leading-[0.72] text-[13.5vw] md:text-[11.5vw]">Parli<br class="hidden md:block" /><span class="text-brand font-medium">amo!</span></h2>
        </div>
        <div data-reveal class="md:max-w-md w-full">
          <FormContatti oggetto="Richiesta preventivo pellicole satinate" compatto />
        </div>
      </div>
    </div>
  </section>

  <!-- WHATSAPP FLUTTUANTE: cerchio chiudibile come shop.vamdeco -->
  <WhatsAppTondo testo="Ciao VAM Deco, vorrei un preventivo per pellicola satinata / privacy." />

  <script>
    // Processo: il numero si accende quando lo raggiungi e la linea sotto si RIEMPIE
    // progressivamente d'arancione seguendo lo scroll (come l'originale).
    const righeFasi = Array.from(document.querySelectorAll<HTMLElement>('.fase-riga'));
    const numeriFasi = righeFasi.map((r) => r.querySelector<HTMLElement>('.numero-fase')!);
    const lineeFasi = righeFasi.map((r) => r.querySelector<HTMLElement>('.fase-linea-riempi'));
    const aggiornaFasi = () => {
      const centro = window.innerHeight * 0.55;
      const centri = numeriFasi.map((n) => {
        const b = n.getBoundingClientRect();
        return b.top + b.height / 2;
      });
      righeFasi.forEach((r, i) => {
        r.classList.toggle('accesa', centri[i] <= centro);
        const riempi = lineeFasi[i];
        if (riempi && i < centri.length - 1) {
          const p = Math.min(1, Math.max(0, (centro - centri[i]) / (centri[i + 1] - centri[i])));
          riempi.style.height = `${p * 100}%`;
        }
      });
    };
    if (righeFasi.length) {
      window.addEventListener('scroll', aggiornaFasi, { passive: true });
      window.addEventListener('resize', aggiornaFasi);
      aggiornaFasi();
    }

    // Macchina da scrivere in loop: scrive una frase, la cancella, scrive la successiva
    const tw = document.querySelector<HTMLElement>('.tw-testo');
    if (tw && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const frasi: string[] = JSON.parse(tw.dataset.frasi || '[]');
      const osservaTw = new IntersectionObserver((voci) => {
        if (!voci[0].isIntersecting) return;
        osservaTw.disconnect();
        let indice = 0;
        let pos = 0;
        let cancella = false;
        const passo = () => {
          const frase = frasi[indice];
          tw.textContent = frase.slice(0, pos);
          let attesa = cancella ? 32 : 68;
          if (!cancella) {
            pos += 1;
            if (pos > frase.length) { cancella = true; attesa = 1700; }
          } else {
            pos -= 1;
            if (pos < 0) { cancella = false; pos = 0; indice = (indice + 1) % frasi.length; attesa = 350; }
          }
          setTimeout(passo, attesa);
        };
        passo();
      }, { threshold: 0.15 });
      osservaTw.observe(tw.closest('h2')!);
    } else if (tw) {
      tw.textContent = 'Parliamone.';
    }
  </script>
</Base>
