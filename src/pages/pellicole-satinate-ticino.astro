---
import Base from '../layouts/Base.astro';
import dati from '../dati/pellicole-satinate-ticino.json';

// Benefici: nelle liste estratte come "01. Titolo: descrizione"
const sezBenefici = dati.sezioni.find((s) => (s.heading || '').startsWith('Hai bisogno di privacy'));
const benefici = (sezBenefici?.liste || []).map((v) => {
  const m = v.match(/^(\d+)\.\s*([^:]+):\s*(.*)$/s);
  return m ? { n: m[1], titolo: m[2].trim(), testo: m[3].trim() } : { n: '', titolo: v, testo: '' };
});

const fasi = [
  { t: 'Analisi delle tue esigenze', d: 'Capiremo insieme dove vuoi maggiore privacy (ufficio, bagno, vetrina…) e ti consiglieremo la soluzione più adatta.' },
  { t: 'Proposta su misura', d: 'Prepariamo un preventivo gratuito e ti mostriamo esempi e pellicole disponibili, anche con opzioni personalizzate.' },
  { t: 'Applicazione veloce e pulita', d: 'In pochi minuti la pellicola viene applicata senza polvere, rumori o lavori invasivi. Può essere rimossa in futuro senza danni.' },
  { t: 'Risultato immediato', d: 'Subito dopo l’applicazione avrai vetri opachi, eleganti e riservati. Più luce naturale, meno occhi indiscreti.' },
];

const perche = [
  { t: 'Esperienza Consolidata', d: 'Con anni di esperienza e numerosi progetti realizzati, abbiamo costruito una solida reputazione come partner di fiducia per la decorazione e la personalizzazione in Ticino.' },
  { t: 'Soluzioni su Misura', d: 'Ogni progetto è unico. Offriamo soluzioni personalizzate che rispondono alle specifiche esigenze di ogni cliente, garantendo sempre il miglior risultato.' },
  { t: 'Focalizzazione sul Cliente', d: 'La soddisfazione del cliente è al centro di tutto ciò che facciamo. Lavoriamo a stretto contatto con te per realizzare esattamente ciò che desideri.' },
  { t: 'Comunicazione Trasparente', d: 'Crediamo nell’importanza della trasparenza. Manteniamo una comunicazione costante e chiara in ogni fase del progetto.' },
];

const galleria = dati.immagini.filter((i) => (i.contesto || '').includes('alleria')).map((i) => i.srcArchivio);

const testimonianze = [
  { testo: 'Michele ha trasformato la nostra flotta aziendale con un design accattivante e professionale. La sua attenzione ai dettagli e il servizio personalizzato sono stati eccezionali.', nome: 'A. Rossi', avatar: 'G1bC6MQnKLl8c7ZyjwpJlVGuw.jpg' },
  { testo: 'Affidarci a VAM Deco per la decorazione delle nostre vetrine è stata una delle migliori decisioni per la nostra attività.', nome: 'M. Pestoni', avatar: 'vE17bXTh6LumndyjLk4ly8AzJY.png' },
  { testo: 'La qualità delle stampe e degli adesivi di VAM Deco è eccezionale. Non solo hanno rispettato le scadenze, ma hanno anche fornito un supporto costante.', nome: 'M. Ferraro', avatar: 'rM9PIBsqZjq8bCq7vWVwGPT2CI.jpg' },
  { testo: 'Siamo stati aiutati a migliorare la privacy e l’estetica della nostra casa con pellicole oscuranti di altissima qualità.', nome: 'E. Ricchino', avatar: 'rlizSNVuxrrqd6I5hGaSxwqn0Os.png' },
  { testo: 'Ho collaborato con diverse aziende di decorazione veicoli, ma VAM Deco e Michele hanno superato ogni aspettativa. Risposte rapide, lavoro impeccabile.', nome: 'N. Di Lorenzi', avatar: 'YfirIiUhVQXLMtaAlNTGBf13chY.png' },
];

// Dati strutturati FAQPage per Google e le risposte AI
const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: dati.faq.map((f) => ({
    '@type': 'Question',
    name: f.domanda,
    acceptedAnswer: { '@type': 'Answer', text: f.risposta },
  })),
});
---
<Base
  title="Pellicole satinate privacy per vetri in Ticino | VAM Deco"
  description="Pellicole satinate e opache per vetri in Ticino: privacy immediata senza perdere luce naturale, per uffici, negozi e case. Preventivo gratuito in 24/48h."
>
  <script type="application/ld+json" set:html={faqJsonLd} />

  <!-- HERO (testi integrali dall'originale) -->
  <section class="max-w-6xl mx-auto px-4 pt-16 pb-10" data-reveal-stagger>
    <div class="max-w-3xl">
      <h1 data-reveal class="text-3xl md:text-5xl font-bold leading-tight tracking-tight">
        Pellicole opache e satinate per la <span class="text-brand">privacy in Ticino</span>
      </h1>
      <p data-reveal class="mt-6 text-ink/70 leading-relaxed">
        Vuoi più privacy in ufficio, a casa o nel tuo negozio senza tende o muri? Le pellicole satinate
        trasformano vetri e vetrate in superfici eleganti che proteggono dagli sguardi indiscreti, senza
        rinunciare alla luminosità.
      </p>
      <p data-reveal class="mt-4 text-ink/70 leading-relaxed">
        In tutto il Ticino, da Bellinzona a Locarno, Lugano e Biasca, offriamo <strong>pellicole opache per
        vetri</strong> ideali per chi desidera proteggere i propri spazi da sguardi indiscreti senza rinunciare
        alla luminosità. Perfette per <strong>uffici, studi professionali, negozi e abitazioni private</strong>,
        creano ambienti moderni e sicuri con un risultato raffinato e duraturo.
      </p>
      <p data-reveal class="mt-4 text-ink/70 leading-relaxed">
        Installazione rapida, con possibilità di personalizzare i vetri con <strong>loghi, scritte o pattern decorativi</strong>.
      </p>
      <div data-reveal class="mt-8 flex flex-wrap gap-3">
        <a href="#contattaci" class="btn-anim rounded-full bg-brand px-7 py-3.5 font-semibold text-white hover:bg-brand-dark">
          Richiedi il tuo preventivo gratuito
        </a>
        <a
          href="https://wa.me/41765889497?text=Ciao%20VAM%20Deco%2C%20vorrei%20un%20preventivo%20per%20pellicola%20satinata%20%2F%20privacy."
          target="_blank" rel="noopener"
          class="btn-anim rounded-full border-2 border-ink/15 px-7 py-3.5 font-semibold hover:border-brand hover:text-brand"
        >Scrivici su WhatsApp</a>
      </div>
      <p data-reveal class="mt-4 text-sm text-ink/50">Richiedi il tuo preventivo gratuito in 24/48h · Ti rispondiamo velocemente su WhatsApp o via mail</p>
    </div>
  </section>

  <!-- GALLERIA LAVORI SCORREVOLE (come l'originale) -->
  <div class="marquee py-6" aria-label="Galleria dei nostri lavori con pellicole satinate">
    <div class="marquee-track" style="animation-duration: 60s;">
      {[...galleria, ...galleria].map((img) => (
        <img
          src={`/img/pellicole/${img}`}
          alt="Lavoro di applicazione pellicola satinata privacy realizzato da VAM Deco in Ticino"
          class="h-52 md:h-64 w-auto rounded-xl object-cover shadow-md"
          loading="lazy"
        />
      ))}
    </div>
  </div>

  <!-- BENEFICI (testi integrali, numerati come l'originale) -->
  <section class="bg-white border-y border-black/5 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Benefici</div>
      <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-4">Hai bisogno di privacy, comfort e sicurezza nei tuoi spazi in Ticino?</h2>
      <p data-reveal class="max-w-3xl text-ink/70 mb-10">
        Con le nostre <strong>pellicole satinate e opache per vetri</strong> ottieni subito privacy ed eleganza,
        senza perdere luce naturale. Una soluzione semplice, veloce e duratura, ideale per uffici, studi, aziende e abitazioni.
      </p>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {benefici.map((b) => (
          <div data-reveal class="card-anim rounded-2xl bg-paper border border-black/5 p-6">
            <div class="font-display text-2xl font-bold text-brand">{b.n}</div>
            <div class="mt-2 font-semibold">{b.titolo}</div>
            {b.testo && <p class="mt-2 text-sm text-ink/70 leading-relaxed">{b.testo}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESSO IN 4 FASI -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Come funziona</div>
    <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-10">Il nostro Processo in 4 Fasi</h2>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {fasi.map((f, i) => (
        <div data-reveal class="card-anim rounded-2xl bg-white border border-black/5 p-6 shadow-sm">
          <div class="text-xs font-bold tracking-widest text-ink/40 uppercase">Step 0{i + 1}</div>
          <div class="mt-3 font-semibold">{f.t}</div>
          <p class="mt-2 text-sm text-ink/70 leading-relaxed">{f.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PERCHÉ NOI -->
  <section class="bg-white border-y border-black/5 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Perchè scegliere VAM Deco</div>
      <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-10">Semplice, veloce, su misura. Ecco perché ci scelgono</h2>
      <div class="grid gap-5 md:grid-cols-2" data-reveal-stagger>
        {perche.map((p) => (
          <div data-reveal class="card-anim rounded-2xl bg-paper border border-black/5 p-6">
            <div class="font-semibold">{p.t}</div>
            <p class="mt-2 text-sm text-ink/70 leading-relaxed">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIANZE (con avatar originali) -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Testimonianze</div>
    <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-10">Cosa dicono i nostri clienti</h2>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {testimonianze.map((t) => (
        <figure data-reveal class="card-anim rounded-2xl bg-white border border-black/5 p-6 shadow-sm">
          <div class="text-brand text-sm tracking-widest" aria-label="5 stelle su 5">★★★★★</div>
          <blockquote class="mt-3 text-sm text-ink/80 leading-relaxed">"{t.testo}"</blockquote>
          <figcaption class="mt-4 flex items-center gap-3">
            <img src={`/img/pellicole/${t.avatar}`} alt={`Foto profilo della recensione di ${t.nome}`} class="w-9 h-9 rounded-full object-cover" loading="lazy" />
            <span class="text-sm font-semibold">{t.nome}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <a data-reveal href="/recensioni" class="mt-8 inline-block font-semibold text-brand hover:underline">Vedi le recensioni →</a>
  </section>

  <!-- FAQ (risposte integrali recuperate dall'originale) -->
  <section class="bg-white border-y border-black/5 py-16">
    <div class="max-w-3xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Domande frequenti</div>
      <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-8">Hai Domande? Ecco le nostre Risposte!</h2>
      <div data-reveal-stagger>
        {dati.faq.map((f) => (
          <details data-reveal class="faq-item group border-b border-black/10 py-1">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 font-semibold text-sm md:text-base">
              {f.domanda}
              <span class="faq-chevron text-brand text-xl leading-none shrink-0">+</span>
            </summary>
            <div class="faq-risposta">
              <div>
                <p class="pb-5 text-sm text-ink/70 leading-relaxed">{f.risposta}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FORM CONTATTI (come l'originale; invio da collegare al backend al go-live) -->
  <section id="contattaci" class="max-w-6xl mx-auto px-4 py-20">
    <div class="grid gap-10 md:grid-cols-2 items-start">
      <div data-reveal-stagger>
        <h2 data-reveal class="text-4xl md:text-6xl font-bold leading-tight">Parliamo<span class="text-brand">!</span></h2>
        <p data-reveal class="mt-6 text-ink/70 leading-relaxed">
          Compila il modulo e ricevi la tua offerta entro 24h. Oppure scrivici direttamente su WhatsApp.
        </p>
        <ul data-reveal class="mt-6 space-y-2.5 text-sm text-ink/80">
          <li><a href="tel:+41765889497" class="hover:text-brand font-semibold">+41 76 588 94 97</a></li>
          <li><a href="mailto:info@vamdeco.ch" class="hover:text-brand font-semibold">info@vamdeco.ch</a></li>
          <li>Via Pobbia 4d, 6514 Sementina, Ticino</li>
        </ul>
      </div>
      <form data-reveal class="rounded-2xl bg-white border border-black/5 p-6 shadow-sm grid gap-4" id="form-contatti">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-1.5 text-xs font-semibold">Nome*
            <input required name="nome" type="text" class="rounded-lg border border-black/10 px-3.5 py-2.5 text-sm font-normal focus:border-brand outline-none" />
          </label>
          <label class="grid gap-1.5 text-xs font-semibold">Cognome*
            <input required name="cognome" type="text" class="rounded-lg border border-black/10 px-3.5 py-2.5 text-sm font-normal focus:border-brand outline-none" />
          </label>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-1.5 text-xs font-semibold">Azienda
            <input name="azienda" type="text" class="rounded-lg border border-black/10 px-3.5 py-2.5 text-sm font-normal focus:border-brand outline-none" />
          </label>
          <label class="grid gap-1.5 text-xs font-semibold">Email*
            <input required name="email" type="email" class="rounded-lg border border-black/10 px-3.5 py-2.5 text-sm font-normal focus:border-brand outline-none" />
          </label>
        </div>
        <label class="grid gap-1.5 text-xs font-semibold">Numero di telefono
          <input name="telefono" type="tel" class="rounded-lg border border-black/10 px-3.5 py-2.5 text-sm font-normal focus:border-brand outline-none" />
        </label>
        <label class="grid gap-1.5 text-xs font-semibold">Messaggio*
          <textarea required name="messaggio" rows="4" placeholder="Fornisci più informazioni possibili per ricevere l'offerta entro 24h" class="rounded-lg border border-black/10 px-3.5 py-2.5 text-sm font-normal focus:border-brand outline-none resize-y"></textarea>
        </label>
        <label class="grid gap-1.5 text-xs font-semibold">Come ci hai conosciuti?
          <select name="fonte" class="rounded-lg border border-black/10 px-3.5 py-2.5 text-sm font-normal focus:border-brand outline-none bg-white">
            <option>Google</option><option>Passaparola</option><option>Instagram</option><option>Facebook</option><option>Altri Social</option><option>Altro</option>
          </select>
        </label>
        <button type="submit" class="btn-anim rounded-full bg-brand px-7 py-3.5 font-semibold text-white hover:bg-brand-dark">Invia</button>
        <p class="text-xs text-ink/50">*Campi obbligatori</p>
      </form>
    </div>
  </section>

  <!-- WHATSAPP FLUTTUANTE (numero corretto, a differenza del popup originale) -->
  <a
    href="https://wa.me/41765889497?text=Ciao%20VAM%20Deco%2C%20vorrei%20un%20preventivo%20per%20pellicola%20satinata%20%2F%20privacy."
    target="_blank" rel="noopener"
    class="btn-anim fixed bottom-5 right-5 z-40 rounded-full bg-[#25D366] text-white px-5 py-3.5 text-sm font-semibold shadow-xl"
    aria-label="Scrivici su WhatsApp per un preventivo"
  >Chat su WhatsApp</a>

  <script>
    // Anteprima: il modulo compone una email; al go-live verrà collegato al backend sul VPS
    document.getElementById('form-contatti')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(e.target as HTMLFormElement);
      const corpo = [
        `Nome: ${f.get('nome')} ${f.get('cognome')}`,
        f.get('azienda') ? `Azienda: ${f.get('azienda')}` : '',
        `Email: ${f.get('email')}`,
        f.get('telefono') ? `Telefono: ${f.get('telefono')}` : '',
        `Come ci hai conosciuti: ${f.get('fonte')}`,
        '', `${f.get('messaggio')}`,
      ].filter(Boolean).join('\n');
      location.href = `mailto:info@vamdeco.ch?subject=${encodeURIComponent('Richiesta preventivo pellicole satinate')}&body=${encodeURIComponent(corpo)}`;
    });
  </script>
</Base>
