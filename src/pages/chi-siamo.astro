---
// CHI SIAMO: storia vera dell'azienda (dal sito originale), timeline animata,
// fornitori, fondatore, processo in 4 fasi, galleria della sede, FAQ.
import { readdirSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import GalleriaOrizzontale from '../components/GalleriaOrizzontale.astro';
import FormContatti from '../components/FormContatti.astro';
import RecensioniEleganti from '../components/RecensioniEleganti.astro';
import WhatsAppTondo from '../components/WhatsAppTondo.astro';
import Marquee from '../components/Marquee.astro';
import { recensioniStandard } from '../dati/recensioni';

const galleriaSede = readdirSync('public/img/chi-siamo/galleria')
  .filter((f: string) => /\.(jpe?g|png|webp)$/i.test(f))
  .sort();

const tappe = [
  { anno: '2017', titolo: 'La scintilla', testo: "VAM Deco nasce quasi per gioco in un piccolo garage, con il primo plotter e i primi lavori svolti direttamente nel piazzale." },
  { anno: '2018', titolo: 'La prima sede', testo: "A giugno apriamo la prima sede a Giubiasco: 16 metri quadrati di pura dedizione. Sei mesi dopo arriva il secondo plotter, e lo spazio inizia già a diventare stretto." },
  { anno: '2019', titolo: 'La nuova casa', testo: "A metà novembre, dopo un mese e mezzo di lavori tra risate e notti in bianco, inauguriamo la nuova sede. Una giornata che rimarrà per sempre nei nostri cuori." },
  { anno: '2020', titolo: 'La prova più dura', testo: "Dopo soli quattro mesi arriva il COVID. La dedizione e la determinazione di non arrenderci ci permettono di superare anche quel periodo." },
  { anno: 'Oggi', titolo: 'Supporto a 360 gradi', testo: "Anno dopo anno investiamo tutto in stampanti, macchinari e formazione continua. Con partner fidati offriamo una gamma completa di servizi ai nostri clienti." },
  { anno: 'Domani', titolo: 'Si cresce ancora', testo: "L'obiettivo: ampliare macchinari e stampanti, puntare a una sede più grande e migliorare ancora l'esperienza dei clienti, con l'innovazione sempre al centro." },
];

const fornitori = [
  { slug: 'arlon', nome: 'Arlon' }, { slug: 'mimaki', nome: 'Mimaki' }, { slug: '3m', nome: '3M' },
  { slug: 'clique', nome: 'Clique' }, { slug: 'siser', nome: 'Siser' }, { slug: 'roland', nome: 'Roland' },
  { slug: 'avery', nome: 'Avery' }, { slug: 'hexis', nome: 'Hexis' },
];

const qualita = ['Visionario', 'Collaborativo', 'Orientato ai risultati', 'Problem solver', 'Integrità', 'Resiliente'];

const fasi = [
  { t: 'Analisi e comprensione', d: "Ci immergiamo nelle tue esigenze e nei tuoi obiettivi: che si tratti di un veicolo, una vetrina o un capo personalizzato, lavoriamo a stretto contatto con te per capire esattamente cosa vuoi ottenere." },
  { t: 'Progettazione personalizzata', d: "Sviluppiamo un preventivo su misura scegliendo le tecnologie e i materiali più adatti al lavoro. Creiamo design che rispecchiano il tuo brand e catturano l'attenzione." },
  { t: 'Produzione e installazione', d: "Dopo l'approvazione passiamo alla fase operativa: produciamo con attrezzature all'avanguardia e installiamo presso la nostra o la tua sede, con precisione e nei tempi stabiliti." },
  { t: 'Verifica e supporto continuo', d: "A progetto completato verifichiamo ogni dettaglio secondo i nostri standard di qualità. E restiamo a disposizione, perché il lavoro è finito solo quando sei soddisfatto." },
];

const faq = [
  { domanda: 'Quanto costa la decorazione di un veicolo commerciale in Ticino?', risposta: 'I costi variano in base alla dimensione del veicolo e al tipo di decorazione, ma generalmente una decorazione semplice può partire già da CHF 250.' },
  { domanda: "Quanto è efficace la decorazione dei veicoli come pubblicità in movimento?", risposta: "È una forma di pubblicità molto efficace: visibile ovunque, in strada, nei parcheggi o quando l'auto è in movimento, offre una promozione costante e gratuita." },
  { domanda: 'Quanto tempo dura la decorazione delle vetrine?', risposta: "Con la giusta manutenzione, le pellicole decorative per vetrine possono durare diversi anni, a seconda del tipo di materiale e dell'esposizione agli agenti atmosferici." },
  { domanda: 'Quali sono i vantaggi della decorazione vetrine per le attività commerciali?', risposta: "Le vetrine decorate attirano l'attenzione dei passanti, migliorano la visibilità del brand e possono fungere da mezzo pubblicitario." },
  { domanda: 'Quali tipi di abbigliamento posso personalizzare per il mio business?', risposta: 'È possibile personalizzare t-shirt, felpe, cappellini e altro abbigliamento promozionale, sia con stampa che con ricamo.' },
  { domanda: "Quanto dura la stampa sull'abbigliamento personalizzato?", risposta: 'Con la giusta cura, la stampa su abbigliamento personalizzato può durare per anni, mantenendo intatti i colori e i dettagli.' },
  { domanda: 'Qual è il formato ideale per uno striscione pubblicitario esterno?', risposta: 'Il formato dipende dalla posizione e dalla distanza di visualizzazione, ma i formati standard sono 2x1 e 3x1 metri per una visibilità ottimale.' },
  { domanda: 'Quanto tempo ci vuole per creare un sito web ottimizzato per la SEO?', risposta: 'La creazione di un sito web ottimizzato per la SEO può richiedere da alcune settimane a un mese, a seconda della complessità del progetto.' },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.domanda,
    acceptedAnswer: { '@type': 'Answer', text: f.risposta },
  })),
});
---
<Base
  title="Chi siamo | VAM Deco, dove la creatività incontra la qualità"
  description="Dal garage del 2017 alla sede di oggi: la storia di VAM Deco, il team ticinese di decorazione e personalizzazione. Missione, valori, processo e fondatore."
>
  <script type="application/ld+json" set:html={faqJsonLd} />

  <!-- HERO -->
  <section class="relative pattern-hero overflow-hidden">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-3xl mx-auto px-4 pt-20 pb-16 text-center" data-reveal-stagger>
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-4 uppercase">Chi siamo</div>
      <h1 data-reveal class="text-3xl md:text-5xl font-bold leading-tight tracking-tight" style="text-wrap: balance">
        Dove la creatività incontra la <span class="text-brand">qualità</span>
      </h1>
      <p data-reveal class="mt-8 text-carta/80 leading-relaxed">
        Siamo più di una semplice azienda di decorazione e personalizzazione: siamo un team appassionato di
        creatività, innovazione e qualità. Ogni giorno trasformiamo le idee in realtà con soluzioni
        personalizzate che catturano l'attenzione e valorizzano ogni brand.
      </p>
      <p data-reveal class="mt-5 font-display text-xl md:text-2xl font-bold text-brand leading-snug">
        Da noi, la tua immagine conta.
      </p>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 pb-20" data-reveal>
      <img src="/img/chi-siamo/hero.jpg" alt="Il laboratorio VAM Deco a Sementina" class="w-full rounded-3xl border border-white/10 shadow-2xl" loading="eager" />
    </div>
  </section>

  <!-- STORIA: timeline con linea che si riempie allo scroll -->
  <section class="max-w-4xl mx-auto px-4 py-20">
    <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">La nostra storia</div>
    <h2 data-reveal class="text-2xl md:text-4xl font-bold mb-12">Dal garage a punto di riferimento.</h2>
    <div class="space-y-0">
      {tappe.map((t, i) => (
        <div class="tappa-riga grid grid-cols-[5.5rem_2rem_1fr] md:grid-cols-[8rem_2.5rem_1fr] gap-x-2 md:gap-x-4">
          <div class="tappa-anno font-display text-xl md:text-3xl font-bold text-carta/30 text-right pt-0.5 transition-colors duration-500">{t.anno}</div>
          <div class="relative flex flex-col items-center">
            <span class="tappa-punto mt-2 w-3 h-3 rounded-full bg-white/20 shrink-0 transition-colors duration-500"></span>
            {i < tappe.length - 1 && (
              <span class="relative w-px flex-1 bg-white/10 my-1 overflow-hidden">
                <span class="tappa-linea-riempi absolute top-0 left-0 w-full bg-brand" style="height: 0%"></span>
              </span>
            )}
          </div>
          <div class="pb-10">
            <h3 class="font-display font-semibold text-lg">{t.titolo}</h3>
            <p class="mt-2 text-sm md:text-base text-carta/70 leading-relaxed max-w-xl">{t.testo}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- MISSIONE (scura) + VISIONE (arancione): due blocchi contrapposti -->
  <section class="max-w-6xl mx-auto px-4 pb-20 grid md:grid-cols-2 gap-6">
    <div data-reveal class="rounded-3xl border border-white/10 bg-superficie p-8 md:p-10">
      <div class="text-xs font-bold tracking-widest text-brand mb-3 uppercase">01. La missione</div>
      <h2 class="text-xl md:text-2xl font-bold">Farti distinguere.</h2>
      <p class="mt-4 text-sm md:text-base text-carta/70 leading-relaxed">
        Aiutiamo le aziende a distinguersi con soluzioni creative e personalizzate, migliorando visibilità e
        riconoscibilità del brand. Lavoriamo per superare le aspettative, dalla decorazione dei veicoli alle
        vetrine e oltre, con risultati concreti che contribuiscono alla crescita dei nostri clienti.
      </p>
    </div>
    <div data-reveal class="rounded-3xl bg-brand p-8 md:p-10 text-ink">
      <div class="text-xs font-bold tracking-widest text-ink/60 mb-3 uppercase">02. La visione</div>
      <h2 class="text-xl md:text-2xl font-bold">Diventare il riferimento.</h2>
      <p class="mt-4 text-sm md:text-base text-ink/80 leading-relaxed">
        Vogliamo essere il punto di riferimento della decorazione e personalizzazione nel Sopraceneri, in Ticino
        e oltre: soluzioni innovative e di qualità al giusto prezzo, per dare ad aziende di ogni dimensione gli
        strumenti per prosperare e distinguersi sul mercato.
      </p>
    </div>
  </section>

  <!-- FORNITORI: nastro di loghi che scorre -->
  <section class="border-y border-white/5 bg-white/[0.02] py-14 overflow-hidden">
    <div data-reveal class="text-center text-xs font-bold tracking-widest text-carta/50 uppercase mb-8">I fornitori con cui lavoriamo</div>
    <div class="marquee select-none" aria-label="Fornitori: Arlon, Mimaki, 3M, Clique, Siser, Roland, Avery, Hexis">
      <div class="marquee-track items-center">
        {[...fornitori, ...fornitori].map((f) => (
          <span class="inline-flex items-center justify-center h-16 md:h-20 px-8 md:px-10 mx-3 rounded-2xl bg-white/95">
            <img src={`/img/chi-siamo/fornitori/${f.slug}.png`} alt={f.nome} class="max-h-8 md:max-h-10 w-auto max-w-[8rem]" loading="lazy" />
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- FONDATORE -->
  <section class="max-w-6xl mx-auto px-4 py-20 grid md:grid-cols-[1fr_1.4fr] gap-10 items-center">
    <div data-reveal class="relative mx-auto">
      <div class="absolute -inset-6 rounded-full bg-brand/15 blur-3xl" aria-hidden="true"></div>
      <img src="/img/chi-siamo/michele.png" alt="Michele Scacco, fondatore di VAM Deco" class="relative w-56 md:w-72 drop-shadow-2xl" loading="lazy" />
    </div>
    <div data-reveal-stagger>
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Conosci il fondatore</div>
      <h2 data-reveal class="text-2xl md:text-4xl font-bold">Michele Scacco</h2>
      <p data-reveal class="mt-5 text-carta/75 leading-relaxed">
        Il cuore pulsante di VAM Deco. Con anni di esperienza nella decorazione e personalizzazione, la passione
        di Michele per l'innovazione e la dedizione ai clienti guidano il nostro percorso: visione strategica,
        approccio orientato al cliente e capacità di trovare soluzioni creative definiscono il nostro impegno
        verso l'eccellenza.
      </p>
      <p data-reveal class="mt-4 text-carta/75 leading-relaxed">
        Su valori di trasparenza e integrità ha portato l'azienda a crescere fino a diventare un punto di
        riferimento nel settore, superando costantemente le aspettative.
      </p>
      <div data-reveal class="mt-6 flex flex-wrap gap-2">
        {qualita.map((q) => (
          <span class="rounded-full border border-brand/40 px-4 py-1.5 text-sm text-brand">{q}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- VALORI: nastro di parole -->
  <Marquee testo="Qualità · Precisione · Passione · Creatività · Affidabilità ·" />

  <!-- PROCESSO in 4 fasi (stesso linguaggio visivo delle pagine servizi) -->
  <section class="max-w-4xl mx-auto px-4 py-20">
    <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Come lavoriamo</div>
    <h2 data-reveal class="text-2xl md:text-4xl font-bold mb-12">Il nostro processo in 4 fasi.</h2>
    <div>
      {fasi.map((f, i) => (
        <div class="fase-riga grid grid-cols-[3.5rem_1fr] md:grid-cols-[4.5rem_1fr] gap-x-4 md:gap-x-6">
          <div class="flex flex-col items-center">
            <div class="numero-fase font-display text-xl md:text-2xl font-bold w-11 h-11 md:w-13 md:h-13 rounded-full border grid place-items-center shrink-0">{i + 1}</div>
            {i < fasi.length - 1 && (
              <div class="fase-linea relative w-px flex-1 my-2 overflow-hidden">
                <div class="fase-linea-riempi absolute top-0 left-0 w-full" style="height: 0%"></div>
              </div>
            )}
          </div>
          <div class="pb-10">
            <h3 class="font-display font-semibold text-lg md:text-xl pt-2">{f.t}</h3>
            <p class="mt-2 text-sm md:text-base text-carta/70 leading-relaxed max-w-xl">{f.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- GALLERIA SEDE -->
  <section class="pb-4">
    <div class="max-w-3xl mx-auto px-4 text-center" data-reveal-stagger>
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">La nostra sede e tecnologia</div>
      <h2 data-reveal class="text-2xl md:text-4xl font-bold">Dove le tue idee prendono vita.</h2>
      <p data-reveal class="mt-4 text-carta/70 leading-relaxed">
        Dai macchinari all'avanguardia agli spazi dedicati alla creatività: ogni immagine racconta l'attenzione
        e la cura che dedichiamo ai progetti di personalizzazione, decorazione e stampa.
      </p>
    </div>
    <GalleriaOrizzontale
      immagini={galleriaSede.map((img) => `/img/chi-siamo/galleria/${img}`)}
      alt="La sede e i macchinari di VAM Deco"
    />
  </section>

  <!-- RECENSIONI (condivise) -->
  <RecensioniEleganti recensioni={recensioniStandard} />
  <div class="text-center pb-16">
    <a data-reveal href="/recensioni" class="btn-anim inline-block rounded-full bg-brand px-8 py-3.5 font-semibold text-ink hover:bg-brand-dark">Vedi le recensioni</a>
  </div>

  <!-- FAQ -->
  <section class="border-y border-white/5 bg-white/[0.02] py-16">
    <div class="max-w-3xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Domande frequenti</div>
      <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-8">Hai domande? Ecco le nostre risposte!</h2>
      <div data-reveal-stagger class="space-y-4">
        {faq.map((f) => (
          <details class="faq-item faq-card group px-5" data-reveal>
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 font-semibold text-sm md:text-base">
              {f.domanda}
              <span class="faq-bottone" aria-hidden="true">⌄</span>
            </summary>
            <div class="faq-risposta">
              <div>
                <p class="pb-5 text-sm text-carta/70 leading-relaxed">{f.risposta}</p>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINALE -->
  <section id="contattaci" class="max-w-2xl mx-auto px-4 py-20 text-center">
    <h2 data-reveal class="font-display text-3xl md:text-5xl font-bold text-brand">Parliamone.</h2>
    <p data-reveal class="mt-4 text-carta/70">Raccontaci la tua idea: preventivo gratuito in 24/48h.</p>
    <div class="mt-10">
      <FormContatti oggetto="Richiesta dalla pagina Chi siamo" />
    </div>
  </section>

  <WhatsAppTondo testo="Ciao VAM Deco, vorrei informazioni." />

  <script>
    // Timeline storia + processo: linee che si riempiono e punti che si accendono con lo scroll
    const gruppi: Array<{ righe: HTMLElement[]; punto: string; linea: string }> = [
      { righe: Array.from(document.querySelectorAll<HTMLElement>('.tappa-riga')), punto: '.tappa-punto', linea: '.tappa-linea-riempi' },
      { righe: Array.from(document.querySelectorAll<HTMLElement>('.fase-riga')), punto: '.numero-fase', linea: '.fase-linea-riempi' },
    ];
    const aggiorna = () => {
      const centro = window.innerHeight * 0.55;
      for (const g of gruppi) {
        if (!g.righe.length) continue;
        const centri = g.righe.map((r) => {
          const b = r.querySelector<HTMLElement>(g.punto)!.getBoundingClientRect();
          return b.top + b.height / 2;
        });
        g.righe.forEach((r, i) => {
          r.classList.toggle('accesa', centri[i] <= centro);
          const riempi = r.querySelector<HTMLElement>(g.linea);
          if (riempi && i < centri.length - 1) {
            const p = Math.min(1, Math.max(0, (centro - centri[i]) / (centri[i + 1] - centri[i])));
            riempi.style.height = `${p * 100}%`;
          }
        });
      }
    };
    window.addEventListener('scroll', aggiorna, { passive: true });
    window.addEventListener('resize', aggiorna);
    aggiorna();
  </script>

  <style>
    /* Tappe della timeline: si accendono al passaggio */
    .tappa-riga.accesa .tappa-anno { color: var(--color-brand); }
    .tappa-riga.accesa .tappa-punto { background: var(--color-brand); box-shadow: 0 0 14px rgba(245, 131, 39, 0.65); }
  </style>
</Base>
