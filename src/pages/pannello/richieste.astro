---
// RICHIESTE: i lead che arrivano dai form del sito. Ogni richiesta mostra la
// PAGINA di provenienza (tracciabilita gia predisposta nei form). Dati di
// esempio: al go-live i form invieranno le richieste al backend che le elenca qui.
import PannelloAdmin from '../../layouts/PannelloAdmin.astro';

const richieste = [
  { data: '05.08 · 14:22', nome: 'Luca Bernasconi', email: 'l.bernasconi@studiolb.ch', servizio: 'Decorazione veicoli', origine: 'Servizio: decorazione-veicoli (modulo 1)', fonte: 'Google', stato: 'nuova' },
  { data: '05.08 · 09:41', nome: 'Sara Moretti', email: 'sara.moretti@gmail.com', servizio: 'Personalizzazione festa', origine: 'Pagina Festa', fonte: 'Instagram', stato: 'nuova' },
  { data: '04.08 · 18:03', nome: 'Garage Rossi Sagl', email: 'info@garagerossi.ch', servizio: 'Oscuramento vetri auto', origine: 'Servizio: oscuramento-auto (modulo 2)', fonte: 'Passaparola', stato: 'in corso' },
  { data: '04.08 · 11:15', nome: 'Elena Fumagalli', email: 'elena.f@outlook.com', servizio: 'Abbigliamento personalizzato', origine: 'Pagina Contattaci', fonte: 'Google', stato: 'in corso' },
  { data: '03.08 · 16:50', nome: 'Marco Delucchi', email: 'm.delucchi@edildel.ch', servizio: 'Cartellonistica', origine: 'Servizio: cartellonistica (modulo 1)', fonte: 'Google', stato: 'gestita' },
  { data: '03.08 · 10:07', nome: 'Bar Centrale', email: 'barcentrale.bellinzona@gmail.com', servizio: 'Decorazione vetrine', origine: 'Pagina Recensioni', fonte: 'Altri Social', stato: 'gestita' },
  { data: '02.08 · 13:38', nome: 'Giada Pult', email: 'giada.pult@icloud.com', servizio: 'Etichette resinate', origine: 'Servizio: etichette-resinate (modulo 1)', fonte: 'Google', stato: 'gestita' },
];

const badge = (s: string) =>
  s === 'nuova' ? 'bg-brand/20 text-brand'
  : s === 'in corso' ? 'bg-sky-400/15 text-sky-300'
  : 'bg-white/[0.06] text-carta/50';

const perFonte = richieste.reduce((acc, r) => { acc[r.fonte] = (acc[r.fonte] || 0) + 1; return acc; }, {} as Record<string, number>);
---
<PannelloAdmin titolo="Richieste" attivo="richieste">
  <div class="mb-6 rounded-xl border border-white/10 bg-white/[0.02] p-3 text-sm text-carta/60">
    Esempio di come vedrai le richieste. Ogni riga mostra <strong class="text-carta/80">da quale pagina</strong> arriva (tracciabilità già pronta nei form). Al go-live i moduli invieranno qui le richieste reali.
  </div>

  <!-- RIEPILOGO -->
  <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-4 mb-6">
    <div class="rounded-2xl border border-white/10 bg-superficie/50 p-5">
      <div class="text-xs font-bold tracking-widest text-carta/45 uppercase">Questa settimana</div>
      <div class="mt-2 font-display text-3xl font-bold">{richieste.length}</div>
      <div class="mt-1 text-xs text-carta/50">richieste ricevute</div>
    </div>
    <div class="rounded-2xl border border-white/10 bg-superficie/50 p-5">
      <div class="text-xs font-bold tracking-widest text-carta/45 uppercase">Da gestire</div>
      <div class="mt-2 font-display text-3xl font-bold text-brand">{richieste.filter(r => r.stato !== 'gestita').length}</div>
      <div class="mt-1 text-xs text-carta/50">nuove o in corso</div>
    </div>
    <div class="rounded-2xl border border-white/10 bg-superficie/50 p-5 sm:col-span-1 lg:col-span-2">
      <div class="text-xs font-bold tracking-widest text-carta/45 uppercase mb-3">Come ti hanno conosciuto</div>
      <div class="flex flex-wrap gap-2">
        {Object.entries(perFonte).sort((a,b)=>b[1]-a[1]).map(([f, n]) => (
          <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm"><span class="font-semibold text-brand">{n}</span>{f}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- TABELLA -->
  <div class="rounded-2xl border border-white/10 bg-superficie/50 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-carta/45 uppercase tracking-widest border-b border-white/10 bg-white/[0.02]">
            <th class="px-4 py-3 font-semibold w-28">Data</th>
            <th class="px-4 py-3 font-semibold">Cliente</th>
            <th class="px-4 py-3 font-semibold">Servizio</th>
            <th class="px-4 py-3 font-semibold">Arriva da</th>
            <th class="px-4 py-3 font-semibold w-24 text-right">Stato</th>
          </tr>
        </thead>
        <tbody>
          {richieste.map((r) => (
            <tr class="border-b border-white/5 hover:bg-white/[0.02]">
              <td class="px-4 py-3 text-carta/55 whitespace-nowrap">{r.data}</td>
              <td class="px-4 py-3">
                <div class="font-medium">{r.nome}</div>
                <div class="text-xs text-carta/50">{r.email}</div>
              </td>
              <td class="px-4 py-3 text-carta/80">{r.servizio}</td>
              <td class="px-4 py-3">
                <div class="text-carta/70 text-xs">{r.origine}</div>
                <div class="text-[11px] text-carta/40">canale: {r.fonte}</div>
              </td>
              <td class="px-4 py-3 text-right"><span class={`rounded-full px-2.5 py-1 text-xs font-semibold ${badge(r.stato)}`}>{r.stato}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</PannelloAdmin>
