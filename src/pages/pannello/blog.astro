---
// BLOG CRM: lista degli articoli (dati reali) in stile tabella come Framer,
// con l'editor in un pannello laterale. Il salvataggio si collega al backend.
import PannelloAdmin from '../../layouts/PannelloAdmin.astro';

const moduli = import.meta.glob('../../dati/articoli/*.json', { eager: true });
const articoli = Object.values(moduli)
  .map((m: any) => m.default ?? m)
  .sort((a: any, b: any) => (a.dataIso < b.dataIso ? 1 : -1));

const categorie = [...new Set(articoli.map((a: any) => a.categoria))];
---
<PannelloAdmin titolo="Blog" attivo="blog">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-carta/60">{articoli.length} articoli · {categorie.length} categorie</p>
    <button id="nuovo-articolo" class="btn-anim rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-ink hover:bg-brand-dark">+ Nuovo articolo</button>
  </div>

  <!-- TABELLA ARTICOLI (stile Framer) -->
  <div class="rounded-2xl border border-white/10 bg-superficie/50 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-carta/45 uppercase tracking-widest border-b border-white/10 bg-white/[0.02]">
            <th class="px-4 py-3 font-semibold w-24">In primo piano</th>
            <th class="px-4 py-3 font-semibold">Titolo</th>
            <th class="px-4 py-3 font-semibold w-48">Categoria</th>
            <th class="px-4 py-3 font-semibold w-28">Data</th>
            <th class="px-4 py-3 font-semibold w-20 text-right">Azioni</th>
          </tr>
        </thead>
        <tbody>
          {articoli.map((a: any, i: number) => (
            <tr class="riga-articolo border-b border-white/5 hover:bg-white/[0.02] cursor-pointer" data-articolo={JSON.stringify({ h1: a.h1, slug: a.slug, categoria: a.categoria, data: a.data, description: a.description, estratto: a.estratto, sezioni: a.sezioni?.length || 0, faq: a.faq?.length || 0 })}>
              <td class="px-4 py-3">
                <span class={`inline-block w-9 h-5 rounded-full relative ${i < 3 ? 'bg-brand' : 'bg-white/15'}`}>
                  <span class={`absolute top-0.5 w-4 h-4 rounded-full bg-white transition-all ${i < 3 ? 'left-4' : 'left-0.5'}`}></span>
                </span>
              </td>
              <td class="px-4 py-3 font-medium max-w-md truncate">{a.h1}</td>
              <td class="px-4 py-3"><span class="rounded-full bg-white/[0.06] px-2.5 py-1 text-xs text-carta/70">{a.categoria}</span></td>
              <td class="px-4 py-3 text-carta/55">{a.data}</td>
              <td class="px-4 py-3 text-right"><span class="text-brand text-xs font-semibold">Modifica ✎</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- EDITOR (pannello laterale) -->
  <div id="editor" class="fixed inset-0 z-50 hidden">
    <div id="editor-sfondo" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
    <div class="absolute right-0 top-0 bottom-0 w-full max-w-2xl bg-ink border-l border-white/10 overflow-y-auto">
      <div class="sticky top-0 flex items-center justify-between border-b border-white/10 bg-ink/90 backdrop-blur px-6 h-16">
        <h2 id="editor-titolo" class="font-display font-bold">Nuovo articolo</h2>
        <button id="editor-chiudi" class="text-carta/60 hover:text-carta text-xl">✕</button>
      </div>
      <div class="p-6 space-y-5">
        <label class="block"><span class="text-xs font-bold tracking-widest text-carta/50 uppercase">Titolo (H1)</span>
          <input id="f-h1" type="text" class="mt-2 w-full rounded-xl bg-white/5 border border-white/15 px-4 py-3 text-sm outline-none focus:border-brand" placeholder="Es. Oscuramento vetri auto in Ticino: legge e prezzi" /></label>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="block"><span class="text-xs font-bold tracking-widest text-carta/50 uppercase">Categoria</span>
            <select id="f-cat" class="mt-2 w-full rounded-xl bg-superficie border border-white/15 px-4 py-3 text-sm outline-none focus:border-brand">
              {categorie.map((c) => <option>{c}</option>)}
            </select></label>
          <label class="block"><span class="text-xs font-bold tracking-widest text-carta/50 uppercase">Data</span>
            <input id="f-data" type="text" class="mt-2 w-full rounded-xl bg-white/5 border border-white/15 px-4 py-3 text-sm outline-none focus:border-brand" placeholder="22 feb 2025" /></label>
        </div>
        <label class="block"><span class="text-xs font-bold tracking-widest text-carta/50 uppercase">Slug (URL)</span>
          <input id="f-slug" type="text" class="mt-2 w-full rounded-xl bg-white/5 border border-white/15 px-4 py-3 text-sm outline-none focus:border-brand" placeholder="oscuramento-vetri-auto-ticino" /></label>
        <label class="block"><span class="text-xs font-bold tracking-widest text-carta/50 uppercase">Descrizione SEO</span>
          <textarea id="f-desc" rows="2" class="mt-2 w-full rounded-xl bg-white/5 border border-white/15 px-4 py-3 text-sm outline-none focus:border-brand resize-y"></textarea></label>
        <label class="block"><span class="text-xs font-bold tracking-widest text-carta/50 uppercase">Estratto</span>
          <textarea id="f-estratto" rows="2" class="mt-2 w-full rounded-xl bg-white/5 border border-white/15 px-4 py-3 text-sm outline-none focus:border-brand resize-y"></textarea></label>
        <div class="rounded-xl border border-white/10 bg-white/[0.02] p-4 text-sm text-carta/60">
          <div class="font-semibold text-carta/80 mb-1">Contenuto, FAQ e immagini</div>
          Le sezioni di testo, le domande frequenti e la galleria si modificano qui sotto (editor completo in arrivo con il backend). L'articolo aperto ha <span id="f-conta" class="text-brand font-semibold"></span>.
        </div>
        <div class="flex items-center gap-3 pt-2">
          <button class="btn-anim rounded-full bg-brand px-6 py-3 text-sm font-semibold text-ink hover:bg-brand-dark" title="Si collega al backend">Salva e pubblica</button>
          <button id="editor-annulla" class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-carta/70 hover:text-carta">Annulla</button>
          <span class="text-xs text-carta/40">Anteprima: il salvataggio si attiva col backend</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    const editor = document.getElementById('editor')!;
    const apri = (dati?: any) => {
      editor.classList.remove('hidden');
      const t = document.getElementById('editor-titolo')!;
      const set = (id: string, v: string) => { (document.getElementById(id) as HTMLInputElement).value = v || ''; };
      if (dati) {
        t.textContent = 'Modifica articolo';
        set('f-h1', dati.h1); set('f-cat', dati.categoria); set('f-data', dati.data);
        set('f-slug', dati.slug); set('f-desc', dati.description); set('f-estratto', dati.estratto || '');
        document.getElementById('f-conta')!.textContent = `${dati.sezioni} sezioni e ${dati.faq} FAQ`;
      } else {
        t.textContent = 'Nuovo articolo';
        ['f-h1','f-data','f-slug','f-desc','f-estratto'].forEach((id) => set(id, ''));
        document.getElementById('f-conta')!.textContent = '0 sezioni e 0 FAQ';
      }
    };
    const chiudi = () => editor.classList.add('hidden');
    document.getElementById('nuovo-articolo')!.addEventListener('click', () => apri());
    document.getElementById('editor-chiudi')!.addEventListener('click', chiudi);
    document.getElementById('editor-annulla')!.addEventListener('click', chiudi);
    document.getElementById('editor-sfondo')!.addEventListener('click', chiudi);
    document.querySelectorAll<HTMLElement>('.riga-articolo').forEach((r) => {
      r.addEventListener('click', () => apri(JSON.parse(r.dataset.articolo || '{}')));
    });
  </script>
</PannelloAdmin>
