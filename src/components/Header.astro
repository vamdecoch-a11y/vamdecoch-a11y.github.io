---
const voci = [
  { testo: 'Home', href: '/' },
  { testo: 'Chi siamo', href: '/chi-siamo' },
  { testo: 'I nostri servizi', href: '/servizi' },
  { testo: 'Recensioni', href: '/recensioni' },
  { testo: 'Blog', href: '/articoli' },
];
---
<header class="sticky top-0 z-50 bg-ink/85 backdrop-blur border-b border-white/10">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="VAM Deco, torna alla home">
      <img src="/logo-vamdeco.png" alt="Logo VAM Deco" class="h-8 w-auto" />
    </a>
    <nav class="hidden md:flex items-center gap-1 rounded-full border border-white/10 bg-white/[0.04] px-2 py-1.5 text-sm font-medium">
      {voci.map((v) => (
        <a href={v.href} class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-brand transition-colors">{v.testo}</a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <button type="button" id="apri-cerca" class="p-2 rounded-full hover:bg-white/10 transition-colors cursor-pointer" aria-label="Cerca nel sito" aria-expanded="false">
        <svg viewBox="0 0 24 24" class="w-5 h-5 fill-none stroke-carta stroke-2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5" stroke-linecap="round"/></svg>
      </button>
      <a
        href="/contattaci"
        class="btn-anim inline-flex items-center rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-ink hover:bg-brand-dark"
      >Contattaci</a>
      <!-- Pannello di ricerca: si apre dalla lente, filtra le pagine del sito -->
      <div id="pannello-cerca" class="hidden absolute left-0 right-0 top-full border-b border-white/10 bg-ink/95 backdrop-blur">
        <div class="max-w-2xl mx-auto px-4 py-4">
          <input
            id="campo-cerca" type="search" placeholder="Cerca un servizio..." autocomplete="off"
            class="w-full rounded-full bg-white/5 border border-white/15 px-5 py-3 text-sm text-carta placeholder:text-carta/40 focus:border-brand outline-none"
          />
          <ul id="risultati-cerca" class="mt-3 space-y-1 text-sm"></ul>
        </div>
      </div>
      <details class="md:hidden relative">
        <summary class="list-none cursor-pointer p-2 -mr-2" aria-label="Apri il menu">
          <span class="block w-6 h-0.5 bg-carta mb-1.5"></span>
          <span class="block w-6 h-0.5 bg-carta mb-1.5"></span>
          <span class="block w-6 h-0.5 bg-carta"></span>
        </summary>
        <nav class="absolute right-0 top-full mt-3 w-56 rounded-2xl bg-superficie shadow-xl border border-white/10 p-3 flex flex-col">
          {voci.map((v) => (
            <a href={v.href} class="px-3 py-2.5 rounded-lg text-sm font-medium hover:bg-white/10">{v.testo}</a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Ricerca: filtra le pagine del sito mentre scrivi
  const pagine = [
    { titolo: 'Decorazione veicoli', href: '/decorazione-veicoli-ticino' },
    { titolo: 'Decorazione vetrine', href: '/decorazione-vetrine-ticino' },
    { titolo: 'Abbigliamento personalizzato (magliette, felpe, divise)', href: '/abbigliamento-personalizzato-ticino' },
    { titolo: 'Pellicole satinate privacy', href: '/pellicole-satinate-ticino' },
    { titolo: 'Oscuramento vetrate UV', href: '/oscuramento-vetrate-uv' },
    { titolo: 'Oscuramento vetri auto', href: '/oscuramento-vetri-auto-ticino' },
    { titolo: 'Adesivi e etichette', href: '/adesivi-e-etichette' },
    { titolo: 'Cartellonistica e insegne', href: '/cartellonistica' },
    { titolo: 'Stampa su carta', href: '/stampa-su-carta' },
    { titolo: 'Siti web', href: '/siti-web' },
    { titolo: 'Personalizza la tua festa', href: '/personalizza-la-tua-festa' },
    { titolo: 'Chi siamo', href: '/chi-siamo' },
    { titolo: 'Recensioni', href: '/recensioni' },
    { titolo: 'Blog', href: '/articoli' },
    { titolo: 'Contattaci', href: '/contattaci' },
  ];
  const bottone = document.getElementById('apri-cerca');
  const pannello = document.getElementById('pannello-cerca');
  const campo = document.getElementById('campo-cerca') as HTMLInputElement | null;
  const lista = document.getElementById('risultati-cerca');
  if (bottone && pannello && campo && lista) {
    const mostra = (query: string) => {
      const q = query.trim().toLowerCase();
      const trovate = q ? pagine.filter((p) => p.titolo.toLowerCase().includes(q)) : pagine.slice(0, 6);
      lista.innerHTML = trovate.length
        ? trovate.map((p) => `<li><a class="block rounded-lg px-4 py-2.5 hover:bg-white/10 hover:text-brand transition-colors" href="${p.href}">${p.titolo}</a></li>`).join('')
        : '<li class="px-4 py-2.5 text-carta/50">Nessun risultato. Prova con "vetrine", "magliette", "pellicole"...</li>';
    };
    bottone.addEventListener('click', () => {
      const aperto = !pannello.classList.contains('hidden');
      pannello.classList.toggle('hidden');
      bottone.setAttribute('aria-expanded', String(!aperto));
      if (!aperto) { mostra(''); campo.focus(); }
    });
    campo.addEventListener('input', () => mostra(campo.value));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { pannello.classList.add('hidden'); bottone.setAttribute('aria-expanded', 'false'); }
    });
  }
</script>
