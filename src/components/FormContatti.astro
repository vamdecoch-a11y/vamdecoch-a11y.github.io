---
interface Props {
  oggetto: string;
  compatto?: boolean;
  origine?: string; // etichetta della pagina/posizione da cui parte la richiesta (visibile nell'admin)
}
const { oggetto, compatto = false, origine = oggetto } = Astro.props;
const campo = `rounded-xl bg-white/5 border border-white/15 text-sm font-normal text-carta placeholder:text-carta/45 focus:border-brand outline-none ${compatto ? 'px-4 py-2.5' : 'px-4 py-3'}`;
---
<!-- Come l'originale: campi con segnaposto, niente etichette -->
<form class={`form-contatti text-left grid ${compatto ? 'gap-2.5' : 'gap-4 card-scura rounded-2xl p-6'}`} data-oggetto={oggetto} data-origine={origine}>
  <input type="hidden" name="origine" value={origine} />
  <!-- honeypot anti-bot: invisibile agli umani, i bot lo compilano -->
  <input type="text" name="sito" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-campo" />
  <div class={`grid sm:grid-cols-2 ${compatto ? 'gap-2.5' : 'gap-4'}`}>
    <input required name="nome" type="text" placeholder="Nome*" aria-label="Nome" class={campo} />
    <input required name="cognome" type="text" placeholder="Cognome*" aria-label="Cognome" class={campo} />
  </div>
  <input name="azienda" type="text" placeholder="Azienda" aria-label="Azienda" class={campo} />
  <div class={`grid sm:grid-cols-2 ${compatto ? 'gap-2.5' : 'gap-4'}`}>
    <input required name="email" type="email" placeholder="Email*" aria-label="Email" class={campo} />
    <input name="telefono" type="tel" placeholder="Numero di telefono" aria-label="Numero di telefono" class={campo} />
  </div>
  <textarea required name="messaggio" rows={compatto ? 3 : 4} placeholder="Messaggio* (fornisci più informazioni possibili per ricevere l'offerta entro 24h)" aria-label="Messaggio" class={`${campo} resize-y`}></textarea>
  <label class="grid gap-1.5 text-xs font-semibold text-carta/80">Come ci hai conosciuti?*
    <select required name="fonte" class={`rounded-xl bg-superficie border border-white/15 text-sm font-normal text-carta focus:border-brand outline-none ${compatto ? 'px-4 py-2.5' : 'px-4 py-3'}`}>
      <option value="" disabled selected>Seleziona una risposta*</option>
      <option>Google</option>
      <option>Passaparola</option>
      <option>Instagram</option>
      <option>Facebook</option>
      <option>Altri Social</option>
      <option>Intelligenza Artificiale (ChatGPT, Gemini, ecc.)</option>
      <option>Altro</option>
    </select>
  </label>
  <button type="submit" class={`btn-anim rounded-full bg-brand font-semibold text-ink hover:bg-brand-dark ${compatto ? 'px-6 py-3' : 'px-7 py-3.5'}`}>Invia</button>
  <p class="form-note text-xs text-carta/50">*Campi obbligatori</p>
</form>

<style>
  .hp-campo {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .form-esito {
    border: 1px solid rgba(245, 131, 39, 0.4);
    background: rgba(245, 131, 39, 0.08);
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    text-align: center;
  }
</style>

<script>
  // Invio al pannello VAM Deco (pagina Richieste). Se la rete fallisce,
  // ripiego sull'email: nessuna richiesta va persa.
  const ENDPOINT = 'https://pannello.vamdeco.agency/api/lead';

  document.querySelectorAll<HTMLFormElement>('.form-contatti').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const bottone = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const testoBottone = bottone.textContent;
      bottone.disabled = true;
      bottone.textContent = 'Invio in corso...';
      try {
        const r = await fetch(ENDPOINT, { method: 'POST', body: new URLSearchParams(f as unknown as Record<string, string>) });
        const dati = await r.json().catch(() => ({}));
        if (!r.ok || !dati.ok) throw new Error(dati.errore || `HTTP ${r.status}`);
        // successo: pagina di ringraziamento (come sul sito originale)
        location.href = '/ringraziamenti';
      } catch {
        // ripiego email con gli stessi contenuti
        bottone.disabled = false;
        bottone.textContent = testoBottone;
        const corpo = [
          `Nome: ${f.get('nome')} ${f.get('cognome')}`,
          f.get('azienda') ? `Azienda: ${f.get('azienda')}` : '',
          `Email: ${f.get('email')}`,
          f.get('telefono') ? `Telefono: ${f.get('telefono')}` : '',
          `Come ci hai conosciuti: ${f.get('fonte')}`,
          `Richiesta inviata da: ${f.get('origine')}`,
          '', `${f.get('messaggio')}`,
        ].filter(Boolean).join('\n');
        const oggetto = form.dataset.oggetto || 'Richiesta preventivo';
        location.href = `mailto:info@vamdeco.ch?subject=${encodeURIComponent(oggetto)}&body=${encodeURIComponent(corpo)}`;
      }
    });
  });
</script>
