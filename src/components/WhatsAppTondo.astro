---
// Bottone WhatsApp a cerchio (come shop.vamdeco.ch), chiudibile con la X.
import { t, type Locale } from '../i18n';
interface Props {
  testo: string;
  numero?: string; // numero WhatsApp in formato wa.me (default: VAM Deco)
}
const { testo, numero = '41765889497' } = Astro.props;
const link = `https://wa.me/${numero}?text=${encodeURIComponent(testo)}`;
const locale = (Astro.currentLocale ?? 'it') as Locale;
---
<div id="wa-tondo" class="fixed bottom-5 right-5 z-40">
  <a
    href={link}
    target="_blank" rel="noopener"
    class="btn-anim grid place-items-center w-14 h-14 rounded-full bg-[#25D366] shadow-xl shadow-black/50"
    aria-label={t(locale, 'cta_whatsapp')}
  >
    <svg viewBox="0 0 24 24" class="w-7 h-7 fill-white" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.29.18-1.42-.08-.13-.28-.2-.57-.35ZM12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.83 9.83 0 0 1 6.99 2.9 9.83 9.83 0 0 1 2.9 7c0 5.45-4.44 9.88-9.9 9.88Zm8.42-18.3A11.82 11.82 0 0 0 12.04 0C5.46 0 .1 5.35.1 11.92c0 2.1.55 4.15 1.6 5.96L0 24l6.28-1.65a11.93 11.93 0 0 0 5.76 1.47h.01c6.58 0 11.94-5.35 11.94-11.92a11.86 11.86 0 0 0-3.52-8.42Z"/></svg>
  </a>
  <button
    type="button" id="wa-chiudi"
    class="absolute -top-1.5 -left-1.5 w-6 h-6 rounded-full bg-ink border border-white/25 text-carta/80 text-xs leading-none grid place-items-center cursor-pointer hover:border-brand hover:text-brand"
    aria-label="Nascondi il bottone WhatsApp"
  >✕</button>
</div>

<script>
  // La chiusura vale solo finché resti sulla pagina: ricaricando riappare
  document.getElementById('wa-chiudi')?.addEventListener('click', () => {
    document.getElementById('wa-tondo')?.remove();
  });
</script>
