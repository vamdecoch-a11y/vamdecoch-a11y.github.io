---
// Carosello orizzontale guidato dallo scroll: scendendo nella pagina, la striscia di foto
// scorre di lato (porting vanilla del componente 21st.dev scelto da Michele, senza framer-motion).
interface Props {
  immagini: string[];
  alt: string;
}
const { immagini, alt } = Astro.props;
---
<section class="galleria-orizzontale relative h-[300vh]">
  <div class="sticky top-0 flex h-screen items-center overflow-hidden">
    <div class="galleria-binario flex gap-4 will-change-transform pl-4">
      {immagini.map((img, i) => (
        <div class="group relative h-[52vh] w-[85vw] md:h-[58vh] md:w-[34vw] shrink-0 overflow-hidden rounded-2xl border border-white/10 bg-superficie">
          <img
            src={img}
            alt={`${alt} (foto ${i + 1})`}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
            loading={i < 3 ? 'eager' : 'lazy'}
            draggable="false"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Mappa lo scroll verticale della sezione sullo spostamento orizzontale della striscia
  const sezioni = document.querySelectorAll<HTMLElement>('.galleria-orizzontale');
  if (sezioni.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const aggiorna = () => {
      sezioni.forEach((sez) => {
        const binario = sez.querySelector<HTMLElement>('.galleria-binario')!;
        const r = sez.getBoundingClientRect();
        const corsa = r.height - window.innerHeight;
        const progresso = Math.min(1, Math.max(0, -r.top / corsa));
        const massimo = binario.scrollWidth - window.innerWidth + 32;
        binario.style.transform = `translateX(${-progresso * Math.max(0, massimo)}px)`;
      });
    };
    window.addEventListener('scroll', aggiorna, { passive: true });
    window.addEventListener('resize', aggiorna);
    aggiorna();
  } else {
    // Senza animazioni: striscia scorrevole a mano
    sezioni.forEach((sez) => {
      sez.classList.remove('h-[300vh]');
      sez.style.height = 'auto';
      const sticky = sez.firstElementChild as HTMLElement;
      sticky.classList.remove('sticky', 'h-screen');
      sticky.style.overflowX = 'auto';
    });
  }
</script>
