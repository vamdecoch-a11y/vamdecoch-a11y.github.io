---
// Galleria a scorrimento automatico continuo: le foto sfilano da sole (rallentano al passaggio
// del mouse, zoomano all'hover). Altezza uguale per tutte, larghezza secondo l'orientamento.
interface Props {
  immagini: string[];
  alt: string;
}
const { immagini, alt } = Astro.props;
---
<div class="galleria-auto overflow-hidden py-10" role="region" aria-label={alt}>
  <div class="galleria-binario flex items-center gap-4 w-max will-change-transform pl-4">
    {[...immagini, ...immagini].map((img, i) => (
      <div class="group shrink-0 overflow-hidden rounded-2xl border border-white/10 bg-superficie">
        <img
          src={img}
          alt={i < immagini.length ? `${alt} (foto ${i + 1})` : ''}
          aria-hidden={i >= immagini.length ? 'true' : undefined}
          class="h-[42vh] md:h-[52vh] w-auto object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
          decoding="async"
          draggable="false"
        />
      </div>
    ))}
  </div>
</div>

<script>
  // Scorrimento continuo + trascinamento manuale (mouse e dito): trascini, e al rilascio riparte da solo
  document.querySelectorAll<HTMLElement>('.galleria-auto').forEach((cont) => {
    const binario = cont.querySelector<HTMLElement>('.galleria-binario')!;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      cont.style.overflowX = 'auto';
      return;
    }
    const base = 0.6;
    let velocita = base;
    let obiettivo = base;
    let x = 0;
    let trascinando = false;
    let ultimoX = 0;

    cont.addEventListener('pointerenter', () => { if (!trascinando) obiettivo = base * 0.2; });
    cont.addEventListener('pointerleave', () => { if (!trascinando) obiettivo = base; });

    cont.style.touchAction = 'pan-y';
    cont.style.cursor = 'grab';
    cont.addEventListener('pointerdown', (e) => {
      trascinando = true;
      ultimoX = e.clientX;
      obiettivo = 0;
      velocita = 0;
      cont.style.cursor = 'grabbing';
      e.preventDefault();
    });
    // move/up a livello finestra: il trascinamento non si perde nemmeno uscendo dal riquadro
    window.addEventListener('pointermove', (e) => {
      if (!trascinando) return;
      x -= e.clientX - ultimoX;
      ultimoX = e.clientX;
    }, { passive: true });
    const fine = () => {
      if (!trascinando) return;
      trascinando = false;
      cont.style.cursor = 'grab';
      obiettivo = base;
    };
    window.addEventListener('pointerup', fine);
    window.addEventListener('pointercancel', fine);

    const passo = () => {
      velocita += (obiettivo - velocita) * 0.05;
      if (!trascinando) x += velocita;
      const meta = binario.scrollWidth / 2;
      if (x >= meta) x -= meta;
      if (x < 0) x += meta;
      binario.style.transform = `translateX(${-x}px)`;
      requestAnimationFrame(passo);
    };
    requestAnimationFrame(passo);
  });
</script>
