---
const servizi = [
  { testo: 'Decorazione veicoli', href: '/decorazione-veicoli-ticino' },
  { testo: 'Decorazione vetrine', href: '/decorazione-vetrine-ticino' },
  { testo: 'Abbigliamento personalizzato', href: '/abbigliamento-personalizzato-ticino' },
  { testo: 'Cartellonistica', href: '/cartellonistica' },
  { testo: 'Adesivi e etichette', href: '/adesivi-e-etichette' },
  { testo: 'Pellicole satinate privacy', href: '/pellicole-satinate-ticino' },
  { testo: 'Oscuramento vetrate UV', href: '/oscuramento-vetrate-uv' },
  { testo: 'Oscuramento vetri auto', href: '/oscuramento-vetri-auto-ticino' },
  { testo: 'Stampa su carta', href: '/stampa-su-carta' },
  { testo: 'Siti web', href: '/siti-web' },
  { testo: 'Packaging', href: '/packaging' },
];
const nastro = 'Decorazione veicoli · Vetrine · Abbigliamento · Pellicole · Cartellonistica · Adesivi · Stampa · Siti web · Packaging · ';
---
<!-- Footer cinematografico a tendina: su desktop resta fermo dietro la pagina e si svela allo scroll -->
<div class="reveal-wrap">
  <footer class="cine-footer bg-ink flex flex-col">
    <div class="footer-sfumatura-alto"></div>
    <div class="footer-aurora"></div>
    <div class="footer-griglia"></div>

    <!-- Nastro a tutta larghezza: prima riga del footer (mt-20 = libera l'altezza del menu fisso) -->
    <div class="footer-nastro marquee relative w-full mt-20 py-3 bg-black/30" aria-hidden="true">
      <div class="marquee-track" style="animation-duration: 40s;">
        <span class="font-display text-sm tracking-widest uppercase text-carta/50">{nastro}{nastro}</span>
        <span class="font-display text-sm tracking-widest uppercase text-carta/50">{nastro}{nastro}</span>
      </div>
    </div>

    <div class="relative w-full px-5 md:px-10 py-10 md:py-0 md:my-auto">
      <div class="text-center">
        <h2 class="footer-titano">Diamo vita alle tue idee</h2>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/contattaci" class="act magnetico btn-anim rounded-full bg-brand px-7 py-3.5 font-semibold text-ink hover:bg-brand-dark">Richiedi un preventivo</a>
          <a href="https://wa.me/41765889497?text=Ciao%20VAM%20Deco%2C%20vorrei%20un%20preventivo" target="_blank" rel="noopener" class="act magnetico pillola-vetro rounded-full px-7 py-3.5 font-semibold text-carta">Scrivici su WhatsApp</a>
        </div>
      </div>

      <div class="mt-10 grid gap-10 md:grid-cols-[minmax(280px,1fr)_2fr] md:gap-14">
        <!-- CONTATTI: logo + voci con icone, gruppi separati -->
        <div class="md:pl-20">
          <img src="/logo-vamdeco.png" alt="Logo VAM Deco" class="h-9 w-auto mb-6" />
          <ul class="text-sm text-carta/80 space-y-1">
            <li>
              <a href="tel:+41765889497" class="act inline-flex items-center gap-3 py-1 hover:text-brand">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-brand shrink-0" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
                +41 76 588 94 97
              </a>
            </li>
            <li class="pt-3">
              <a href="mailto:info@vamdeco.ch" class="act inline-flex items-center gap-3 py-1 hover:text-brand">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-brand shrink-0" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>
                info@vamdeco.ch
              </a>
            </li>
            <li>
              <a href="mailto:info@vamdeco.agency" class="act inline-flex items-center gap-3 py-1 hover:text-brand">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-brand shrink-0" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z"/></svg>
                info@vamdeco.agency
              </a>
            </li>
            <li class="pt-3">
              <a href="https://maps.app.goo.gl/zq6THCbbrv1LWDPY6" target="_blank" rel="noopener" class="act inline-flex items-center gap-3 py-1 hover:text-brand">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-brand shrink-0" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
                Via Pobbia 4d, 6514 Sementina
              </a>
            </li>
          </ul>
        </div>

        <!-- SERVIZI: due colonne, più grandi, tutto lo spazio -->
        <div>
          <div class="font-display text-sm tracking-widest uppercase text-brand mb-5">I nostri servizi</div>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-3 text-base text-carta/85">
            {servizi.map((s) => (
              <li><a href={s.href} class="act hover:text-brand transition-colors">{s.testo}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="relative w-full px-5 md:px-10 pb-5">
      <div class="pt-4 border-t border-white/10 flex flex-col md:flex-row md:flex-wrap items-center justify-between gap-4 md:gap-3 text-xs text-carta/55">
        <a href="https://vamdeco.ch" class="act hover:text-brand order-2 md:order-none">© Progettazione e sviluppo by VAM Deco Agency Sagl</a>
        <!-- SEGUICI: icone animate (su mobile SOPRA il credit) -->
        <div class="flex items-center gap-3 order-1 md:order-none">
          <a href="https://instagram.com/vamdeco.ch" target="_blank" rel="noopener" class="act social-tile" aria-label="Seguici su Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23a3.7 3.7 0 0 1-.9 1.38c-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07ZM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.86 5.86 0 0 0-2.13 1.38A5.86 5.86 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.8.72 1.47 1.38 2.13a5.86 5.86 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56 1.28.06 1.69.07 4.95.07s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.86 5.86 0 0 0 2.13-1.38 5.86 5.86 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.86 5.86 0 0 0-1.38-2.13A5.86 5.86 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84Zm0 10.15A4 4 0 1 1 16 12a4 4 0 0 1-4 3.99Zm7.85-10.4a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44Z"/></svg>
          </a>
          <a href="https://facebook.com/vamdeco.ch" target="_blank" rel="noopener" class="act social-tile" aria-label="Seguici su Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.88 11.85v-8.38H7.08V12h3.04V9.36c0-3 1.79-4.67 4.53-4.67 1.31 0 2.68.24 2.68.24v2.95h-1.51c-1.49 0-1.95.92-1.95 1.87V12h3.32l-.53 3.47h-2.79v8.38A12 12 0 0 0 24 12Z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@vamdeco.ch" target="_blank" rel="noopener" class="act social-tile" aria-label="Seguici su TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z"/></svg>
          </a>
        </div>
        <div class="flex items-center gap-5">
          <a href="/norme-sulla-privacy" class="act hover:text-brand">Norme sulla privacy</a>
          <!-- Al go-live: collegare al pannello del gestore cookie -->
          <button type="button" id="impostazioni-cookie" class="act hover:text-brand cursor-pointer">Cookie Settings</button>
          <button type="button" id="torna-su" class="act magnetico pillola-vetro rounded-full px-4 py-2 text-carta/80 cursor-pointer">Torna su ↑</button>
        </div>
      </div>
    </div>
  </footer>
</div>

<script>
  // Torna su
  document.getElementById('torna-su')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Bottoni magnetici (solo su dispositivi con mouse, niente GSAP: vanilla)
  if (window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('.magnetico').forEach((el) => {
      el.addEventListener('mousemove', (e) => {
        const r = el.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        el.style.transform = `translate(${dx * 0.25}px, ${dy * 0.25}px) scale(1.04)`;
      });
      el.addEventListener('mouseleave', () => {
        el.style.transition = 'transform 0.45s cubic-bezier(0.2, 1.6, 0.4, 1)';
        el.style.transform = '';
        setTimeout(() => { el.style.transition = ''; }, 460);
      });
    });
  }
</script>
