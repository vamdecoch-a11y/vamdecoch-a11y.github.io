---
const servizi = [
  { testo: 'Decorazione veicoli', href: '/decorazione-veicoli-ticino' },
  { testo: 'Decorazione vetrine', href: '/decorazione-vetrine-ticino' },
  { testo: 'Abbigliamento personalizzato', href: '/abbigliamento-personalizzato-ticino' },
  { testo: 'Cartellonistica', href: '/cartellonistica' },
  { testo: 'Adesivi e etichette', href: '/adesivi-e-etichette' },
  { testo: 'Pellicole satinate privacy', href: '/pellicole-satinate-ticino' },
  { testo: 'Oscuramento vetrate UV', href: '/oscuramento-vetrate-uv' },
  { testo: 'Oscuramento vetri auto', href: '/oscuramento-vetri-auto-ticino' },
  { testo: 'Stampa su carta', href: '/stampa-su-carta' },
  { testo: 'Siti web', href: '/siti-web' },
  { testo: 'Packaging', href: '/packaging' },
];
const nastro = 'Decorazione veicoli · Vetrine · Abbigliamento · Pellicole · Cartellonistica · Adesivi · Stampa · Siti web · Packaging · ';
---
<!-- Footer cinematografico a tendina: su desktop resta fermo dietro la pagina e si svela allo scroll -->
<div class="reveal-wrap">
  <footer class="cine-footer bg-ink flex flex-col">
    <div class="footer-sfumatura-alto"></div>
    <div class="footer-aurora"></div>
    <div class="footer-griglia"></div>

    <!-- Nastro a tutta larghezza: prima riga del footer (mt-20 = libera l'altezza del menu fisso) -->
    <div class="footer-nastro marquee relative w-full mt-20 py-3 bg-black/30" aria-hidden="true">
      <div class="marquee-track" style="animation-duration: 40s;">
        <span class="font-display text-sm tracking-widest uppercase text-carta/50">{nastro}{nastro}</span>
        <span class="font-display text-sm tracking-widest uppercase text-carta/50">{nastro}{nastro}</span>
      </div>
    </div>

    <div class="relative w-full px-5 md:px-10 py-10 md:py-0 md:my-auto">
      <div class="text-center">
        <h2 class="footer-titano">Diamo vita alle tue idee</h2>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/contattaci" class="act magnetico btn-anim rounded-full bg-brand px-7 py-3.5 font-semibold text-ink hover:bg-brand-dark">Richiedi un preventivo</a>
          <a href="https://wa.me/41765889497?text=Ciao%20VAM%20Deco%2C%20vorrei%20un%20preventivo" target="_blank" rel="noopener" class="act magnetico pillola-vetro rounded-full px-7 py-3.5 font-semibold text-carta">Scrivici su WhatsApp</a>
        </div>
      </div>

      <div class="mt-8 grid gap-8 md:grid-cols-3 text-sm">
        <div>
          <img src="/logo-vamdeco.png" alt="Logo VAM Deco" class="h-8 w-auto mb-4" />
          <ul class="space-y-2 text-carta/70">
            <li><a href="tel:+41765889497" class="act hover:text-brand">+41 76 588 94 97</a></li>
            <li><a href="mailto:info@vamdeco.ch" class="act hover:text-brand">info@vamdeco.ch</a></li>
            <li><a href="mailto:info@vamdeco.agency" class="act hover:text-brand">info@vamdeco.agency</a></li>
            <li><a href="https://maps.app.goo.gl/zq6THCbbrv1LWDPY6" target="_blank" rel="noopener" class="act hover:text-brand">Via Pobbia 4d, 6514 Sementina</a></li>
          </ul>
        </div>
        <div>
          <div class="font-display text-xs tracking-widest uppercase text-brand mb-3">I nostri servizi</div>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5 text-carta/70">
            {servizi.map((s) => (
              <li><a href={s.href} class="act hover:text-brand">{s.testo}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <div class="font-display text-xs tracking-widest uppercase text-brand mb-3">Seguici</div>
          <ul class="space-y-2 text-carta/70">
            <li><a href="https://instagram.com/vamdeco.ch" target="_blank" rel="noopener" class="act hover:text-brand">Instagram</a></li>
            <li><a href="https://facebook.com/vamdeco.ch" target="_blank" rel="noopener" class="act hover:text-brand">Facebook</a></li>
            <li><a href="https://www.tiktok.com/@vamdeco.ch" target="_blank" rel="noopener" class="act hover:text-brand">TikTok</a></li>
          </ul>
          <div class="mt-4 text-carta/50 text-xs leading-relaxed">
            Lun - Ven: 08:30 - 12:00 / 13:30 - 18:00<br />Sab: 09:30 - 12:00 · Dom: chiuso
          </div>
        </div>
      </div>

    </div>

    <div class="relative w-full px-5 md:px-10 pb-5">
      <div class="pt-4 border-t border-white/10 flex flex-wrap items-center justify-between gap-3 text-xs text-carta/55">
        <span>© VAM Deco Sagl · Sementina, Ticino</span>
        <div class="flex items-center gap-5">
          <a href="/norme-sulla-privacy" class="act hover:text-brand">Norme sulla privacy</a>
          <button type="button" id="torna-su" class="act magnetico pillola-vetro rounded-full px-4 py-2 text-carta/80 cursor-pointer">Torna su ↑</button>
        </div>
      </div>
    </div>
  </footer>
</div>

<script>
  // Torna su
  document.getElementById('torna-su')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Bottoni magnetici (solo su dispositivi con mouse, niente GSAP: vanilla)
  if (window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('.magnetico').forEach((el) => {
      el.addEventListener('mousemove', (e) => {
        const r = el.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        el.style.transform = `translate(${dx * 0.25}px, ${dy * 0.25}px) scale(1.04)`;
      });
      el.addEventListener('mouseleave', () => {
        el.style.transition = 'transform 0.45s cubic-bezier(0.2, 1.6, 0.4, 1)';
        el.style.transform = '';
        setTimeout(() => { el.style.transition = ''; }, 460);
      });
    });
  }
</script>
