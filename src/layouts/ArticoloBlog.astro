---
// TEMPLATE UNICO degli articoli del blog. I contenuti arrivano dai file dati
// (src/dati/articoli/<slug>.json). Ogni articolo ha il suo titolo, la sua data,
// la sua categoria e le sue immagini (regola di Michele: titoli per articolo).
import Base from './Base.astro';
import GalleriaOrizzontale from '../components/GalleriaOrizzontale.astro';
import FormContatti from '../components/FormContatti.astro';
import WhatsAppTondo from '../components/WhatsAppTondo.astro';
import PrimaDopo from '../components/PrimaDopo.astro';
import { t, localePath, haTraduzioni, type Locale } from '../i18n';

interface Sezione {
  heading?: string;
  paragrafi: string[];
  lista?: string[];
  img?: string;
}
interface Articolo {
  slug: string;
  title: string;
  description: string;
  h1: string;
  categoria: string;
  data: string;
  dataIso: string;
  cover: string | null;
  coverCredito?: string;
  estratto: string;
  sezioni: Sezione[];
  galleria?: string[];
  faq?: { domanda: string; risposta: string }[];
  servizioCorrelato?: { testo: string; href: string };
  /* Slider interattivo prima/dopo: se presente sostituisce la cover in testata */
  primaDopo?: { prima: string; dopo: string; didascalia?: string };
}
interface Props { articolo: Articolo; }
const { articolo: a } = Astro.props;
const locale = (Astro.currentLocale ?? 'it') as Locale;
const conTraduzioni = haTraduzioni(Astro.url.pathname);

const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.h1,
  datePublished: a.dataIso,
  image: a.cover ? [`https://vamdeco.ch${a.cover}`] : undefined,
  author: { '@type': 'Organization', name: 'VAM Deco Agency Sagl', url: 'https://vamdeco.ch' },
  publisher: { '@type': 'Organization', name: 'VAM Deco Agency Sagl' },
});

const faqJsonLd = a.faq?.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: a.faq.map((f) => ({
        '@type': 'Question',
        name: f.domanda,
        acceptedAnswer: { '@type': 'Answer', text: f.risposta },
      })),
    })
  : null;
---
<Base title={a.title} description={a.description} i18n={conTraduzioni}>
  <script type="application/ld+json" set:html={articleJsonLd} />
  {faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}

  <!-- TESTATA ARTICOLO -->
  <article>
    <header class="relative pattern-hero overflow-hidden">
      <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
      <div class="relative max-w-3xl mx-auto px-4 pt-16 pb-10 text-center" data-reveal-stagger>
        <div data-reveal class="flex items-center justify-center gap-3 text-xs font-bold tracking-widest uppercase">
          <a href={localePath(locale, '/articoli')} class="text-carta/50 hover:text-brand transition-colors">{t(locale, 'nav_blog')}</a>
          <span class="text-carta/30" aria-hidden="true">/</span>
          <span class="text-brand">{a.categoria}</span>
        </div>
        <h1 data-reveal class="mt-5 text-2xl md:text-4xl font-bold leading-tight tracking-tight" style="text-wrap: balance">{a.h1}</h1>
        <div data-reveal class="mt-5 text-sm text-carta/55">{a.data} · VAM Deco</div>
      </div>
      {a.primaDopo ? (
        <div class="relative max-w-4xl mx-auto px-4 pb-12">
          <PrimaDopo prima={a.primaDopo.prima} dopo={a.primaDopo.dopo} didascalia={a.primaDopo.didascalia} />
        </div>
      ) : a.cover && (
        <div class="relative max-w-4xl mx-auto px-4 pb-12" data-reveal>
          <img src={a.cover} alt={a.h1} class="w-full max-h-[34rem] object-cover rounded-3xl border border-white/10 shadow-2xl" loading="eager" />
        </div>
      )}
    </header>

    <!-- CORPO -->
    <div class="max-w-3xl mx-auto px-4 py-12">
      {a.sezioni.map((s) => (
        <section class="mb-10" data-reveal>
          {s.heading && <h2 class="text-xl md:text-2xl font-bold mb-4" style="text-wrap: balance">{s.heading}</h2>}
          {(s.paragrafi ?? []).map((p) => (
            <p class="mt-4 text-carta/80 leading-relaxed" set:html={p} />
          ))}
          {s.lista && s.lista.length > 0 && (
            <ul class="mt-4 space-y-2.5">
              {s.lista.map((v) => (
                <li class="flex gap-3 text-carta/80 leading-relaxed">
                  <span class="text-brand font-bold shrink-0" aria-hidden="true">→</span>
                  <span set:html={v} />
                </li>
              ))}
            </ul>
          )}
          {s.img && <img src={s.img} alt={s.heading || a.h1} class="mt-6 w-full rounded-2xl border border-white/10" loading="lazy" />}
        </section>
      ))}
    </div>

    <!-- GALLERIA A FINE ARTICOLO -->
    {a.galleria && a.galleria.length > 0 && (
      <GalleriaOrizzontale immagini={a.galleria} alt={a.h1} />
    )}

    <!-- FAQ -->
    {a.faq && a.faq.length > 0 && (
      <section class="border-y border-white/5 bg-white/[0.02] py-14 mt-6">
        <div class="max-w-3xl mx-auto px-4">
          <h2 data-reveal class="text-2xl font-bold mb-8">{t(locale, 'art_faq')}</h2>
          <div data-reveal-stagger class="space-y-4">
            {a.faq.map((f) => (
              <details class="faq-item faq-card group px-5" data-reveal>
                <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 font-semibold text-sm md:text-base">
                  {f.domanda}
                  <span class="faq-bottone" aria-hidden="true">⌄</span>
                </summary>
                <div class="faq-risposta">
                  <div>
                    <p class="pb-5 text-sm text-carta/70 leading-relaxed">{f.risposta}</p>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <!-- CTA SERVIZIO CORRELATO + CONTATTO -->
  <section id="contattaci" class="max-w-2xl mx-auto px-4 py-16 text-center">
    <h2 data-reveal class="font-display text-3xl md:text-4xl font-bold text-brand">{t(locale, 'art_cta_t')}</h2>
    <p data-reveal class="mt-4 text-carta/70">{t(locale, 'art_cta_p')}</p>
    {a.servizioCorrelato && (
      <a data-reveal href={localePath(locale, a.servizioCorrelato.href)} class="btn-anim mt-6 inline-block rounded-full border-2 border-white/20 px-7 py-3.5 font-semibold hover:border-brand hover:text-brand">
        {a.servizioCorrelato.testo}
      </a>
    )}
    <div class="mt-10">
      <FormContatti oggetto={`Richiesta dall'articolo: ${a.h1}`} origine={`Articolo blog (${locale})`} compatto />
    </div>
  </section>

  {a.coverCredito && (
    <p class="max-w-2xl mx-auto px-4 pb-10 text-center text-xs text-carta/35">{a.coverCredito}</p>
  )}

  <WhatsAppTondo testo={t(locale, 'art_wa')} />
</Base>
