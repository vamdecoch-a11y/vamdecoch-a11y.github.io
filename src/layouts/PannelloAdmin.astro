---
// Layout del PANNELLO ADMIN VAM Deco (dashboard + blog + richieste).
// Estetica dark moderna (ispirata al componente shadcn indicato da Michele),
// adattata al brand: #0a0a0a, arancione #F58327, font Unbounded.
// Prototipo di interfaccia: i dati analitici sono reali (Search Console),
// il salvataggio blog e le richieste si collegheranno al backend.
import '../styles/global.css';

interface Props { titolo: string; attivo: string; }
const { titolo, attivo } = Astro.props;

const voci = [
  { id: 'dashboard', label: 'Dashboard', href: '/pannello', icona: 'M3 13h8V3H3v10Zm0 8h8v-6H3v6Zm10 0h8V11h-8v10Zm0-18v6h8V3h-8Z' },
  { id: 'blog', label: 'Blog', href: '/pannello/blog', icona: 'M4 4h16v2H4V4Zm0 5h16v2H4V9Zm0 5h10v2H4v-2Zm0 5h10v2H4v-2Z' },
  { id: 'richieste', label: 'Richieste', href: '/pannello/richieste', icona: 'M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z' },
];
---
<!doctype html>
<html lang="it" class="js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titolo} · Pannello VAM Deco</title>
  </head>
  <body class="min-h-screen bg-ink text-carta">
    <div class="flex min-h-screen">
      <!-- SIDEBAR -->
      <aside class="hidden md:flex w-60 shrink-0 flex-col border-r border-white/10 bg-superficie/60 p-4">
        <a href="/pannello" class="flex items-center gap-2 px-2 py-3">
          <img src="/img/logo-vamdeco.svg" alt="VAM Deco" class="h-6" onerror="this.style.display='none'" />
          <span class="font-display font-bold tracking-tight">VAM<span class="text-brand">Deco</span></span>
        </a>
        <div class="mt-6 text-[10px] font-bold tracking-widest text-carta/40 uppercase px-2 mb-2">Gestione sito</div>
        <nav class="flex flex-col gap-1">
          {voci.map((v) => (
            <a href={v.href} class={`flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${attivo === v.id ? 'bg-brand text-ink' : 'text-carta/70 hover:bg-white/5 hover:text-carta'}`}>
              <svg viewBox="0 0 24 24" class="w-4.5 h-4.5 fill-current shrink-0"><path d={v.icona} /></svg>
              {v.label}
            </a>
          ))}
        </nav>
        <div class="mt-auto rounded-xl border border-white/10 bg-white/[0.02] p-3 text-xs text-carta/55">
          <div class="font-semibold text-carta/80 mb-1">Anteprima interfaccia</div>
          I dati Search Console sono reali. Salvataggio blog e richieste si collegano al backend.
        </div>
      </aside>

      <!-- CONTENUTO -->
      <div class="flex-1 min-w-0 flex flex-col">
        <!-- TOPBAR -->
        <header class="sticky top-0 z-30 flex items-center justify-between gap-4 border-b border-white/10 bg-ink/80 backdrop-blur px-4 md:px-8 h-16">
          <div class="flex items-center gap-3">
            <!-- nav mobile -->
            <div class="md:hidden flex items-center gap-1">
              {voci.map((v) => (
                <a href={v.href} class={`grid place-items-center w-9 h-9 rounded-lg ${attivo === v.id ? 'bg-brand text-ink' : 'text-carta/60 hover:bg-white/5'}`} aria-label={v.label}>
                  <svg viewBox="0 0 24 24" class="w-4.5 h-4.5 fill-current"><path d={v.icona} /></svg>
                </a>
              ))}
            </div>
            <h1 class="font-display text-lg md:text-xl font-bold">{titolo}</h1>
          </div>
          <div class="flex items-center gap-3">
            <a href="/" target="_blank" class="hidden sm:inline text-xs text-carta/50 hover:text-brand">Vedi il sito ↗</a>
            <span class="grid place-items-center w-9 h-9 rounded-full bg-brand/20 text-brand font-display font-bold text-sm">MS</span>
          </div>
        </header>

        <main class="flex-1 p-4 md:p-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
