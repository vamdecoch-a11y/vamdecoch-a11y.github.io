---
// TEMPLATE UNICO delle pagine servizio (modello approvato da Michele su pellicole-satinate).
// Tutte le sezioni sono COLLEGATE: modificando un componente si aggiornano tutte le pagine.
// I contenuti arrivano dal file dati del servizio (src/dati/servizi/<slug>.json).
import { readdirSync, existsSync } from 'node:fs';
import Base from './Base.astro';
import GalleriaOrizzontale from '../components/GalleriaOrizzontale.astro';
import FormContatti from '../components/FormContatti.astro';
import RecensioniEleganti from '../components/RecensioniEleganti.astro';
import WhatsAppTondo from '../components/WhatsAppTondo.astro';
import { recensioniStandard } from '../dati/recensioni';

interface Beneficio { n: string; titolo: string; testo: string; }
interface Fase { t: string; d: string; }
interface Faq { domanda: string; risposta: string; }
interface Servizio {
  slug: string;
  title: string;
  description: string;
  h1: string;
  h1Evidenza?: string;
  heroParagrafi: string[];
  claimArancione: string;
  whatsappTesto: string;
  beneficiTitolo: string;
  beneficiIntro: string;
  benefici: Beneficio[];
  fasi: Fase[];
  faq: Faq[];
  oggettoForm: string;
}
interface Props { servizio: Servizio; }
const { servizio: s } = Astro.props;

// Galleria: tutte le foto nella cartella del servizio (pipeline pronta per il bot Telegram)
const cartellaGalleria = `public/img/${s.slug}/galleria`;
const galleria = existsSync(cartellaGalleria)
  ? readdirSync(cartellaGalleria).filter((f: string) => /\.(jpe?g|png|webp)$/i.test(f)).sort()
  : [];

const linkWhatsApp = `https://wa.me/41765889497?text=${encodeURIComponent(s.whatsappTesto)}`;

const faqJsonLd = s.faq.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: s.faq.map((f) => ({
        '@type': 'Question',
        name: f.domanda,
        acceptedAnswer: { '@type': 'Answer', text: f.risposta },
      })),
    })
  : null;
---
<Base title={s.title} description={s.description}>
  {faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}

  <!-- HERO scura con pattern e bagliore -->
  <section class="relative pattern-hero overflow-hidden">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-3xl mx-auto px-4 pt-20 pb-24 text-center" data-reveal-stagger>
      <h1 data-reveal class="text-3xl md:text-5xl font-bold leading-tight tracking-tight">
        {s.h1}{s.h1Evidenza && <> <span class="text-brand">{s.h1Evidenza}</span></>}
      </h1>
      {s.heroParagrafi.map((p, i) => (
        <p data-reveal class={`${i === 0 ? 'mt-8' : 'mt-5'} text-carta/80 leading-relaxed`} set:html={p} />
      ))}
      <p data-reveal class="mt-8 font-display text-xl md:text-2xl font-bold text-brand leading-snug">
        {s.claimArancione}
      </p>
      <div data-reveal class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#contattaci" class="btn-anim rounded-full bg-brand px-7 py-3.5 font-semibold text-ink hover:bg-brand-dark">
          Richiedi il tuo preventivo gratuito
        </a>
        <a href={linkWhatsApp} target="_blank" rel="noopener" class="btn-anim rounded-full border-2 border-white/20 px-7 py-3.5 font-semibold hover:border-brand hover:text-brand">
          Scrivici su WhatsApp
        </a>
      </div>
      <div data-reveal class="mt-6 space-y-1.5">
        <p class="text-base md:text-lg font-semibold text-carta">Richiedi il tuo preventivo gratuito in <span class="text-brand">24/48h</span></p>
        <p class="text-base md:text-lg font-semibold text-carta/85">Ti rispondiamo velocemente su WhatsApp o via mail</p>
      </div>
    </div>
  </section>

  <!-- GALLERIA (solo se il servizio ha foto) -->
  {galleria.length > 0 && (
    <GalleriaOrizzontale
      immagini={galleria.map((img) => `/img/${s.slug}/galleria/${img}`)}
      alt={`Lavoro di ${s.h1} realizzato da VAM Deco in Ticino`}
    />
  )}

  <!-- BENEFICI -->
  <section class="border-y border-white/5 bg-white/[0.02] py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Benefici</div>
      <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-4">{s.beneficiTitolo}</h2>
      <p data-reveal class="max-w-3xl text-carta/70 mb-10" set:html={s.beneficiIntro} />
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {s.benefici.map((b) => (
          <div data-reveal class="card-scura card-anim rounded-2xl p-6">
            <div class="font-display text-2xl font-bold text-brand">{b.n}</div>
            <div class="mt-2 font-semibold">{b.titolo}</div>
            {b.testo && <p class="mt-2 text-sm text-carta/65 leading-relaxed">{b.testo}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESSO IN 4 FASI -->
  <section class="max-w-3xl mx-auto px-4 py-20">
    <div class="text-center">
      <div data-reveal class="inline-block rounded-full bg-white/[0.06] border border-white/10 px-5 py-2 text-xs font-bold tracking-widest text-brand uppercase mb-3">Come funziona</div>
      <h2 data-reveal class="text-2xl md:text-4xl font-bold mb-14">Il nostro Processo in 4 Fasi</h2>
    </div>
    <div>
      {s.fasi.map((f, i) => (
        <div class="fase-riga grid grid-cols-[5.5rem_1fr] md:grid-cols-[9.5rem_1fr] gap-5 md:gap-10 items-stretch">
          <div class="fase-colonna">
            <div class="numero-fase w-full text-center">0{i + 1}</div>
            {i < s.fasi.length - 1 && <div class="fase-linea"><div class="fase-linea-riempi"></div></div>}
          </div>
          <div data-reveal class="card-scura rounded-2xl p-6 md:p-7 mb-6 self-start">
            <div class="inline-block rounded-full bg-white/[0.07] px-3.5 py-1 text-[10px] font-bold tracking-widest text-carta/60 uppercase">Step 0{i + 1}</div>
            <div class="mt-3 font-display text-lg md:text-2xl font-semibold">{f.t}</div>
            <p class="mt-2 text-sm md:text-base text-carta/65 leading-relaxed">{f.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA A METÀ PAGINA: typewriter + form + freccia -->
  <section class="max-w-6xl mx-auto px-4 pt-6 pb-16 text-center">
    <h2 class="typewriter font-display text-3xl md:text-6xl font-bold text-brand min-h-[1.3em]">
      <span class="tw-testo" data-frasi='["Parliamone.", "Diamo vita alle tue idee."]'></span><span class="cursore">&nbsp;</span>
    </h2>
    <div class="max-w-2xl mx-auto mt-10">
      <FormContatti oggetto={s.oggettoForm} />
    </div>
    <div class="freccia-giu mt-12 mx-auto w-12 h-12 rounded-full border border-white/20 grid place-items-center text-brand text-xl" aria-hidden="true">↓</div>
  </section>

  <!-- PERCHÉ NOI: fascia ARANCIONE coi numeri veri, non card generiche -->
  <section class="bg-brand py-16">
    <div class="max-w-6xl mx-auto px-4 grid gap-10 md:grid-cols-[1.2fr_1fr] items-center">
      <div data-reveal-stagger>
        <div data-reveal class="text-xs font-bold tracking-widest text-ink/70 mb-3 uppercase">Perchè scegliere VAM Deco</div>
        <h2 data-reveal class="text-3xl md:text-5xl font-bold text-ink leading-tight">Semplice, veloce,<br />su misura.</h2>
        <p data-reveal class="mt-5 max-w-md text-ink/80 leading-relaxed">
          Produzione interna a Sementina, un solo referente dall'idea alla consegna
          e la stessa cura sia per il singolo pezzo che per la flotta aziendale.
        </p>
        <a data-reveal href="#contattaci" class="btn-anim mt-7 inline-block rounded-full bg-ink px-7 py-3.5 font-semibold text-carta hover:bg-black">Richiedi il tuo preventivo</a>
      </div>
      <div class="divide-y divide-ink/20" data-reveal-stagger>
        {[
          { n: 400, s: '+', l: 'progetti realizzati', d: 'per aziende e privati in tutta la Svizzera' },
          { n: 24, s: '/48h', l: 'per il tuo preventivo', d: 'gratuito e senza impegno, su WhatsApp o via mail' },
          { n: 8, s: '+', l: 'anni di esperienza', d: 'in decorazione e personalizzazione in Ticino' },
        ].map((x) => (
          <div data-reveal class="flex items-baseline gap-5 py-5">
            <div class="font-display text-5xl md:text-6xl font-bold text-ink shrink-0" data-count={x.n} data-suffix={x.s}>{x.n}{x.s}</div>
            <div>
              <div class="font-display font-semibold text-ink">{x.l}</div>
              <p class="text-sm text-ink/70">{x.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RECENSIONI (componente condiviso in tutto il sito) -->
  <RecensioniEleganti recensioni={recensioniStandard} />
  <div class="text-center pb-16">
    <a data-reveal href="/recensioni" class="btn-anim inline-block rounded-full bg-brand px-8 py-3.5 font-semibold text-ink hover:bg-brand-dark">Vedi le recensioni</a>
  </div>

  <!-- FAQ (solo se il servizio le ha) -->
  {s.faq.length > 0 && (
    <section class="border-y border-white/5 bg-white/[0.02] py-16">
      <div class="max-w-3xl mx-auto px-4">
        <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">Domande frequenti</div>
        <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-8">Hai Domande? Ecco le nostre Risposte!</h2>
        <div data-reveal-stagger class="space-y-4">
          {s.faq.map((f) => (
            <details class="faq-item faq-card group px-5" data-reveal>
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 font-semibold text-sm md:text-base">
                {f.domanda}
                <span class="faq-bottone" aria-hidden="true">⌄</span>
              </summary>
              <div class="faq-risposta">
                <div>
                  <p class="pb-5 text-sm text-carta/70 leading-relaxed">{f.risposta}</p>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- PARLIAMO + FORM -->
  <section id="contattaci" class="relative overflow-hidden">
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-20">
      <div class="grid gap-6 md:grid-cols-2 md:gap-4 items-center">
        <div data-reveal class="w-full text-center md:text-left">
          <h2 class="font-display font-light leading-none md:leading-[0.72] text-[13.5vw] md:text-[11.5vw]">Parli<br class="hidden md:block" /><span class="text-brand font-medium">amo!</span></h2>
        </div>
        <div data-reveal class="md:max-w-md w-full">
          <FormContatti oggetto={s.oggettoForm} compatto />
        </div>
      </div>
    </div>
  </section>

  <WhatsAppTondo testo={s.whatsappTesto} />

  <script>
    // Processo: numero acceso al raggiungimento, linea che si riempie col progresso di scroll
    const righeFasi = Array.from(document.querySelectorAll<HTMLElement>('.fase-riga'));
    const numeriFasi = righeFasi.map((r) => r.querySelector<HTMLElement>('.numero-fase')!);
    const lineeFasi = righeFasi.map((r) => r.querySelector<HTMLElement>('.fase-linea-riempi'));
    const aggiornaFasi = () => {
      const centro = window.innerHeight * 0.55;
      const centri = numeriFasi.map((n) => {
        const b = n.getBoundingClientRect();
        return b.top + b.height / 2;
      });
      righeFasi.forEach((r, i) => {
        r.classList.toggle('accesa', centri[i] <= centro);
        const riempi = lineeFasi[i];
        if (riempi && i < centri.length - 1) {
          const p = Math.min(1, Math.max(0, (centro - centri[i]) / (centri[i + 1] - centri[i])));
          riempi.style.height = `${p * 100}%`;
        }
      });
    };
    if (righeFasi.length) {
      window.addEventListener('scroll', aggiornaFasi, { passive: true });
      window.addEventListener('resize', aggiornaFasi);
      aggiornaFasi();
    }

    // Macchina da scrivere in loop
    const tw = document.querySelector<HTMLElement>('.tw-testo');
    if (tw && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const frasi: string[] = JSON.parse(tw.dataset.frasi || '[]');
      const osservaTw = new IntersectionObserver((voci) => {
        if (!voci[0].isIntersecting) return;
        osservaTw.disconnect();
        let indice = 0;
        let pos = 0;
        let cancella = false;
        const passo = () => {
          const frase = frasi[indice];
          tw.textContent = frase.slice(0, pos);
          let attesa = cancella ? 32 : 68;
          if (!cancella) {
            pos += 1;
            if (pos > frase.length) { cancella = true; attesa = 1700; }
          } else {
            pos -= 1;
            if (pos < 0) { cancella = false; pos = 0; indice = (indice + 1) % frasi.length; attesa = 350; }
          }
          setTimeout(passo, attesa);
        };
        passo();
      }, { threshold: 0.15 });
      osservaTw.observe(tw.closest('h2')!);
    } else if (tw) {
      tw.textContent = 'Parliamone.';
    }
  </script>
</Base>
