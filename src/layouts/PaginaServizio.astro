---
// TEMPLATE UNICO delle pagine servizio (modello approvato da Michele su pellicole-satinate).
// Tutte le sezioni sono COLLEGATE: modificando un componente si aggiornano tutte le pagine.
// I contenuti arrivano dal file dati del servizio (src/dati/servizi/<slug>.json).
import { readdirSync, existsSync } from 'node:fs';
import Base from './Base.astro';
import GalleriaOrizzontale from '../components/GalleriaOrizzontale.astro';
import FormContatti from '../components/FormContatti.astro';
import SezioneParliamo from '../components/SezioneParliamo.astro';
import RecensioniEleganti from '../components/RecensioniEleganti.astro';
import WhatsAppTondo from '../components/WhatsAppTondo.astro';
import { recensioniStandard } from '../dati/recensioni';
import { anniEsperienza, ANNO_FONDAZIONE } from '../dati/statistiche';
import { t, haTraduzioni, type Locale } from '../i18n';

interface Beneficio { n: string; titolo: string; testo: string; }
interface Fase { t: string; d: string; }
interface Faq { domanda: string; risposta: string; }
interface Servizio {
  slug: string;
  title: string;
  description: string;
  h1: string;
  h1Evidenza?: string;
  heroParagrafi: string[];
  heroSfondo?: string; // immagine di sfondo della prima schermata (desktop), dietro un velo scuro per leggibilita'
  heroSfondoMobile?: string; // sfondo hero dedicato al mobile (verticale); se assente usa heroSfondo
  perchePara?: string; // paragrafo "Perche VAM Deco" personalizzato per servizio (es. testo "vetri" su pellicole); se assente usa quello di default
  claimArancione: string;
  whatsappTesto: string;
  whatsappNumero?: string; // numero WhatsApp in formato wa.me (default: VAM Deco); usato es. per far arrivare la festa a Lisa Details
  bottoneExtra?: { testo: string; url: string };
  beneficiTitolo: string;
  beneficiIntro: string;
  benefici: Beneficio[];
  fasi: Fase[];
  faq: Faq[];
  oggettoForm: string;
}
interface Props { servizio: Servizio; }
const { servizio: s } = Astro.props;
const locale = (Astro.currentLocale ?? 'it') as Locale;
// hreflang solo per le 12 pagine servizio principali (che hanno EN/DE);
// le sottopagine città sono solo-IT, quindi niente hreflang verso pagine inesistenti.
const conTraduzioni = haTraduzioni(Astro.url.pathname);

// Galleria: tutte le foto nella cartella del servizio (pipeline pronta per il bot Telegram)
const cartellaGalleria = `public/img/${s.slug}/galleria`;
const galleria = existsSync(cartellaGalleria)
  ? readdirSync(cartellaGalleria).filter((f: string) => /\.(jpe?g|png|webp)$/i.test(f)).sort()
  : [];

const numeroWhatsApp = s.whatsappNumero ?? '41765889497';
const linkWhatsApp = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(s.whatsappTesto)}`;

const faqJsonLd = s.faq.length
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: s.faq.map((f) => ({
        '@type': 'Question',
        name: f.domanda,
        acceptedAnswer: { '@type': 'Answer', text: f.risposta },
      })),
    })
  : null;

// Recensioni aggregate reali (Google): fanno comparire le stelle nello snippet
const businessJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'VAM Deco Agency Sagl',
  url: 'https://vamdeco.ch',
  telephone: '+41765889497',
  image: 'https://vamdeco.ch/og-vamdeco.jpg',
  address: { '@type': 'PostalAddress', streetAddress: 'Via Pobbia 4D', postalCode: '6514', addressLocality: 'Sementina', addressRegion: 'Ticino', addressCountry: 'CH' },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '5.0', reviewCount: '72', bestRating: '5' },
});
---
<Base title={s.title} description={s.description} i18n={conTraduzioni}>
  {faqJsonLd && <script type="application/ld+json" set:html={faqJsonLd} />}
  <script type="application/ld+json" set:html={businessJsonLd} />

  <!-- HERO scura con pattern e bagliore -->
  <section class="relative pattern-hero overflow-hidden">
    {s.heroSfondo && (
      <>
        <img src={s.heroSfondo} alt="" aria-hidden="true" class={`absolute inset-0 w-full h-full object-cover ${s.heroSfondoMobile ? 'hidden md:block' : ''}`} />
        {s.heroSfondoMobile && (
          <img src={s.heroSfondoMobile} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover md:hidden" />
        )}
        <div class="absolute inset-0 bg-ink/[0.72]"></div>
      </>
    )}
    <div class="absolute inset-0 glow-arancio pointer-events-none"></div>
    <div class="relative max-w-3xl mx-auto px-4 pt-20 pb-24 text-center" data-reveal-stagger>
      <div data-reveal class="flex justify-center mb-6">
        <a href="/recensioni" class="group inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.05] px-4 py-1.5 hover:border-brand/50 transition-colors">
          <span class="text-brand text-sm tracking-tight" aria-hidden="true">★★★★★</span>
          <span class="text-sm"><span class="font-bold">5.0</span> <span class="text-carta/60">{t(locale, 'badge_recensioni')}</span></span>
        </a>
      </div>
      <h1 data-reveal class="h1-adattivo text-3xl md:text-5xl font-bold leading-tight tracking-tight">
        {s.h1}{s.h1Evidenza && <> <span class="text-brand">{s.h1Evidenza}</span></>}
      </h1>
      {s.heroParagrafi.map((p, i) => (
        <p data-reveal class={`${i === 0 ? 'mt-8' : 'mt-5'} text-carta/80 leading-relaxed`} set:html={p} />
      ))}
      <p data-reveal class="mt-8 font-display text-xl md:text-2xl font-bold text-brand leading-snug">
        {s.claimArancione}
      </p>
      <div data-reveal class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="#preventivo" class="btn-anim rounded-full bg-brand px-7 py-3.5 font-semibold text-ink hover:bg-brand-dark">
          {t(locale, 'cta_preventivo')}
        </a>
        <a href={linkWhatsApp} target="_blank" rel="noopener" class="btn-anim rounded-full border-2 border-white/20 px-7 py-3.5 font-semibold hover:border-brand hover:text-brand">
          {t(locale, 'cta_whatsapp')}
        </a>
        {s.bottoneExtra && (
          <a href={s.bottoneExtra.url} target="_blank" rel="noopener" class="btn-anim inline-flex items-center gap-2.5 rounded-full border-2 border-white/20 px-7 py-3.5 font-semibold hover:border-brand hover:text-brand">
            <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.3-.1 1.7-.1 4.9-.1Zm0 1.8c-3.1 0-3.5 0-4.8.1-1.1.1-1.5.2-1.9.3-.5.2-.8.4-1.1.7-.3.3-.5.6-.7 1.1-.1.4-.3.8-.3 1.9-.1 1.3-.1 1.6-.1 4.8s0 3.5.1 4.8c.1 1.1.2 1.5.3 1.9.2.5.4.8.7 1.1.3.3.6.5 1.1.7.4.1.8.3 1.9.3 1.3.1 1.6.1 4.8.1s3.5 0 4.8-.1c1.1-.1 1.5-.2 1.9-.3.5-.2.8-.4 1.1-.7.3-.3.5-.6.7-1.1.1-.4.3-.8.3-1.9.1-1.3.1-1.6.1-4.8s0-3.5-.1-4.8c-.1-1.1-.2-1.5-.3-1.9-.2-.5-.4-.8-.7-1.1-.3-.3-.6-.5-1.1-.7-.4-.1-.8-.3-1.9-.3-1.3-.1-1.6-.1-4.8-.1Zm0 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4Zm5.2-3a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z"/></svg>
            {s.bottoneExtra.testo}
          </a>
        )}
      </div>
      <div data-reveal class="mt-6 space-y-1.5">
        <p class="text-base md:text-lg font-semibold text-carta">{t(locale, 'hero_rass1')} <span class="text-brand">{t(locale, 'hero_2448')}</span></p>
        <p class="text-base md:text-lg font-semibold text-carta/85">{t(locale, 'hero_rass2')}</p>
      </div>
    </div>
  </section>

  <!-- GALLERIA (solo se il servizio ha foto) -->
  {galleria.length > 0 && (
    <GalleriaOrizzontale
      immagini={galleria.map((img) => `/img/${s.slug}/galleria/${img}`)}
      alt={`Lavoro di ${s.h1} realizzato da VAM Deco in Ticino`}
    />
  )}

  <!-- BENEFICI -->
  <section class="border-y border-white/5 bg-white/[0.02] py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">{t(locale, 'lab_benefici')}</div>
      <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-4">{s.beneficiTitolo}</h2>
      <p data-reveal class="max-w-3xl text-carta/70 mb-10" set:html={s.beneficiIntro} />
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {s.benefici.map((b) => (
          <div data-reveal class="card-scura card-anim rounded-2xl p-6">
            <div class="font-display text-2xl font-bold text-brand">{b.n}</div>
            <div class="mt-2 font-semibold">{b.titolo}</div>
            {b.testo && <p class="mt-2 text-sm text-carta/65 leading-relaxed">{b.testo}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESSO IN 4 FASI -->
  <section class="max-w-3xl mx-auto px-4 py-20">
    <div class="text-center">
      <div data-reveal class="inline-block rounded-full bg-white/[0.06] border border-white/10 px-5 py-2 text-xs font-bold tracking-widest text-brand uppercase mb-3">{t(locale, 'lab_comefunziona')}</div>
      <h2 data-reveal class="text-2xl md:text-4xl font-bold mb-14">{t(locale, 'processo_titolo')}</h2>
    </div>
    <div>
      {s.fasi.map((f, i) => (
        <div class="fase-riga grid grid-cols-[5.5rem_1fr] md:grid-cols-[9.5rem_1fr] gap-5 md:gap-10 items-stretch">
          <div class="fase-colonna">
            <div class="numero-fase w-full text-center">0{i + 1}</div>
            {i < s.fasi.length - 1 && <div class="fase-linea"><div class="fase-linea-riempi"></div></div>}
          </div>
          <div data-reveal class="card-scura rounded-2xl p-6 md:p-7 mb-6 self-start">
            <div class="inline-block rounded-full bg-white/[0.07] px-3.5 py-1 text-[10px] font-bold tracking-widest text-carta/60 uppercase">{t(locale, 'step')} 0{i + 1}</div>
            <div class="fase-titolo mt-3 font-display text-lg md:text-2xl font-semibold transition-colors duration-500">{f.t}</div>
            <p class="fase-testo mt-2 text-sm md:text-base leading-relaxed transition-colors duration-500">{f.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA A META PAGINA: typewriter + form + freccia (primo form: target dei pulsanti principali) -->
  <section id="preventivo" class="max-w-6xl mx-auto px-4 pt-6 pb-16 text-center scroll-mt-20">
    <h2 class="typewriter font-display text-3xl md:text-6xl font-bold text-brand min-h-[1.3em]">
      <span class="tw-testo" data-frasi={JSON.stringify([t(locale, 'tw1'), t(locale, 'tw2')])}></span><span class="cursore">&nbsp;</span>
    </h2>
    <div class="max-w-2xl mx-auto mt-10">
      <FormContatti oggetto={s.oggettoForm} origine={`Servizio: ${s.slug} (modulo 1, a metà pagina)`} />
    </div>
    <div class="freccia-giu mt-12 mx-auto w-12 h-12 rounded-full border border-white/20 grid place-items-center text-brand text-xl" aria-hidden="true">↓</div>
  </section>

  <!-- PERCHÉ NOI: fascia ARANCIONE coi numeri veri, non card generiche -->
  <section class="bg-brand py-16">
    <div class="max-w-6xl mx-auto px-4 grid gap-10 md:grid-cols-[1.2fr_1fr] items-center">
      <div data-reveal-stagger>
        <div data-reveal class="text-xs font-bold tracking-widest text-ink/70 mb-3 uppercase">{t(locale, 'perche_label')}</div>
        <h2 data-reveal class="text-3xl md:text-5xl font-bold text-ink leading-tight">{t(locale, 'perche_titolo1')}<br />{t(locale, 'perche_titolo2')}</h2>
        <p data-reveal class="mt-5 max-w-md text-ink/80 leading-relaxed">
          {s.perchePara ?? t(locale, 'perche_para_default')}
        </p>
        <a data-reveal href="#preventivo" class="btn-anim mt-7 inline-block rounded-full bg-ink px-7 py-3.5 font-semibold text-carta hover:bg-black">{t(locale, 'cta_preventivo2')}</a>
      </div>
      <div class="divide-y divide-ink/20" data-reveal-stagger>
        {[
          { n: 500, s: '+', lk: 'stat1_l', dk: 'stat1_d' },
          { n: 24, s: '/48h', lk: 'stat2_l', dk: 'stat2_d' },
          { n: anniEsperienza(), s: '+', lk: 'stat3_l', dk: 'stat3_d', anniDa: ANNO_FONDAZIONE },
        ].map((x) => (
          <div data-reveal class="py-6">
            <div class="font-display text-6xl md:text-7xl font-bold text-ink leading-none" data-count={x.n} data-suffix={x.s} data-anni-da={x.anniDa}>{x.n}{x.s}</div>
            <div class="mt-3 font-display font-semibold text-ink">{t(locale, x.lk)}</div>
            <p class="mt-1 text-sm text-ink/75 max-w-sm">{t(locale, x.dk)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RECENSIONI (componente condiviso in tutto il sito) -->
  <RecensioniEleganti recensioni={recensioniStandard} />
  <div class="text-center pb-16">
    <a data-reveal href="/recensioni" class="btn-anim inline-block rounded-full bg-brand px-8 py-3.5 font-semibold text-ink hover:bg-brand-dark">{t(locale, 'vedi_recensioni')}</a>
  </div>

  <!-- FAQ (solo se il servizio le ha) -->
  {s.faq.length > 0 && (
    <section class="border-y border-white/5 bg-white/[0.02] py-16">
      <div class="max-w-3xl mx-auto px-4">
        <div data-reveal class="text-xs font-bold tracking-widest text-brand mb-2 uppercase">{t(locale, 'faq_label')}</div>
        <h2 data-reveal class="text-2xl md:text-3xl font-bold mb-8">{t(locale, 'faq_titolo')}</h2>
        <div data-reveal-stagger class="space-y-4">
          {s.faq.map((f) => (
            <details class="faq-item faq-card group px-5" data-reveal>
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 font-semibold text-sm md:text-base">
                {f.domanda}
                <span class="faq-bottone" aria-hidden="true">⌄</span>
              </summary>
              <div class="faq-risposta">
                <div>
                  <p class="pb-5 text-sm text-carta/70 leading-relaxed">{f.risposta}</p>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- PARLIAMO + FORM (componente condiviso) -->
  <SezioneParliamo oggetto={s.oggettoForm} origine={`Servizio: ${s.slug} (modulo 2, in fondo)`} />

  <WhatsAppTondo testo={s.whatsappTesto} numero={numeroWhatsApp} />

  <script>
    // Titolo senza parola orfana a capo: su desktop provo a farlo stare su UNA riga
    // riducendo il carattere al massimo del 25%; se non basta (titolo lungo),
    // torno a due righe ma bilanciate (text-wrap: balance), che evita comunque
    // la parola singola sulla seconda riga. Su mobile: sempre bilanciato.
    const h1 = document.querySelector<HTMLElement>('.h1-adattivo');
    if (h1) {
      const adatta = () => {
        h1.style.fontSize = '';
        h1.style.whiteSpace = '';
        (h1.style as any).textWrap = 'balance';
        if (window.innerWidth < 768) return;
        const base = parseFloat(getComputedStyle(h1).fontSize);
        h1.style.whiteSpace = 'nowrap';
        let dimensione = base;
        while (h1.scrollWidth > h1.clientWidth && dimensione > base * 0.75) {
          dimensione -= 1;
          h1.style.fontSize = `${dimensione}px`;
        }
        if (h1.scrollWidth > h1.clientWidth) {
          h1.style.whiteSpace = '';
          h1.style.fontSize = '';
        }
      };
      adatta();
      let attesa: number | undefined;
      window.addEventListener('resize', () => {
        clearTimeout(attesa);
        attesa = window.setTimeout(adatta, 150);
      });
    }

    // Processo: numero acceso al raggiungimento, linea che si riempie col progresso di scroll
    const righeFasi = Array.from(document.querySelectorAll<HTMLElement>('.fase-riga'));
    const numeriFasi = righeFasi.map((r) => r.querySelector<HTMLElement>('.numero-fase')!);
    const lineeFasi = righeFasi.map((r) => r.querySelector<HTMLElement>('.fase-linea-riempi'));
    const aggiornaFasi = () => {
      const centro = window.innerHeight * 0.55;
      const centri = numeriFasi.map((n) => {
        const b = n.getBoundingClientRect();
        return b.top + b.height / 2;
      });
      righeFasi.forEach((r, i) => {
        r.classList.toggle('accesa', centri[i] <= centro);
        const riempi = lineeFasi[i];
        if (riempi && i < centri.length - 1) {
          const p = Math.min(1, Math.max(0, (centro - centri[i]) / (centri[i + 1] - centri[i])));
          riempi.style.height = `${p * 100}%`;
        }
      });
    };
    if (righeFasi.length) {
      window.addEventListener('scroll', aggiornaFasi, { passive: true });
      window.addEventListener('resize', aggiornaFasi);
      aggiornaFasi();
    }

    // Macchina da scrivere in loop
    const tw = document.querySelector<HTMLElement>('.tw-testo');
    if (tw && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const frasi: string[] = JSON.parse(tw.dataset.frasi || '[]');
      const osservaTw = new IntersectionObserver((voci) => {
        if (!voci[0].isIntersecting) return;
        osservaTw.disconnect();
        let indice = 0;
        let pos = 0;
        let cancella = false;
        const passo = () => {
          const frase = frasi[indice];
          tw.textContent = frase.slice(0, pos);
          let attesa = cancella ? 32 : 68;
          if (!cancella) {
            pos += 1;
            if (pos > frase.length) { cancella = true; attesa = 1700; }
          } else {
            pos -= 1;
            if (pos < 0) { cancella = false; pos = 0; indice = (indice + 1) % frasi.length; attesa = 350; }
          }
          setTimeout(passo, attesa);
        };
        passo();
      }, { threshold: 0.15 });
      osservaTw.observe(tw.closest('h2')!);
    } else if (tw) {
      tw.textContent = (JSON.parse(tw.dataset.frasi || '[]')[0]) || '';
    }
  </script>
</Base>
