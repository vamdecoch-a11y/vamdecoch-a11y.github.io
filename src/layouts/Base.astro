---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const { title, description, ogImage = '/og-vamdeco.jpg' } = Astro.props;
const urlPagina = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="it-CH">
  <head>
    <script>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- ANTEPRIMA: rimuovere il noindex al go-live -->
    <meta name="robots" content="noindex, nofollow" />
    <!-- Anteprima social (WhatsApp, Facebook, ecc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <!-- Unbounded self-hosted: precarico i pesi principali -->
    <link rel="preload" href="/fonts/unbounded-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/unbounded-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen antialiased">
    <div class="bg-brand text-ink text-center text-[11px] py-1.5 px-4 font-semibold tracking-wide">
      ANTEPRIMA DI LAVORO DEL NUOVO SITO · non pubblica, non definitiva
    </div>
    <Header />
    <slot />
    <Footer />
    <script>
      // Comparsa allo scroll degli elementi [data-reveal]
      const osservatore = new IntersectionObserver(
        (voci) => {
          for (const voce of voci) {
            if (voce.isIntersecting) {
              voce.target.classList.add('is-visible');
              osservatore.unobserve(voce.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => {
        osservatore.observe(el);
      });

      // Ritardo a cascata per i figli di [data-reveal-stagger]
      document.querySelectorAll('[data-reveal-stagger]').forEach((gruppo) => {
        gruppo.querySelectorAll('[data-reveal]').forEach((el, i) => {
          (el as HTMLElement).style.setProperty('--reveal-delay', `${i * 0.09}s`);
        });
      });

      // Numeri "contachilometri" (stile Number Flow): <span data-count="500" data-suffix="+">
      // Ogni cifra è una colonna che scorre in verticale e scatta al suo posto quando
      // il numero entra nello schermo; i caratteri non numerici (+, /, h) restano fissi.
      // Senza JS o con reduced-motion resta il testo statico già renderizzato.
      const costruisciOdometro = (el: HTMLElement) => {
        // fonte = testo già renderizzato dal server: JS e fallback coincidono per costruzione
        const testo = (el.textContent || '').trim() || `${el.dataset.count || ''}${el.dataset.suffix || ''}`;
        const vis = document.createElement('span');
        vis.className = 'nf-vis';
        vis.setAttribute('aria-hidden', 'true');
        let colonna = 0;
        for (const ch of testo) {
          const col = document.createElement('span');
          col.className = 'nf-col';
          if (/[0-9]/.test(ch)) {
            const strip = document.createElement('span');
            strip.className = 'nf-strip';
            // due giri di 0-9: ogni cifra fa almeno un giro completo prima di fermarsi
            for (let giro = 0; giro < 2; giro++) {
              for (let d = 0; d <= 9; d++) {
                const cella = document.createElement('span');
                cella.className = 'nf-cella';
                cella.textContent = String(d);
                strip.appendChild(cella);
              }
            }
            strip.dataset.target = String(10 + Number(ch));
            strip.style.transition = `transform ${(1.1 + colonna * 0.15).toFixed(2)}s cubic-bezier(0.19, 1, 0.22, 1) ${(colonna * 0.06).toFixed(2)}s`;
            col.appendChild(strip);
            colonna += 1;
          } else {
            col.textContent = ch;
          }
          vis.appendChild(col);
        }
        el.textContent = '';
        // copia solo-testo: leggibile da screen reader, Cmd+F, Google e in stampa
        const sr = document.createElement('span');
        sr.className = 'nf-testo';
        sr.textContent = testo;
        el.appendChild(sr);
        el.appendChild(vis);
      };
      const avviaOdometro = (el: HTMLElement) => {
        el.querySelectorAll<HTMLElement>('.nf-strip').forEach((strip) => {
          strip.style.transform = `translateY(-${strip.dataset.target}em)`;
        });
      };
      const osservaContatori = new IntersectionObserver((voci) => {
        for (const voce of voci) {
          if (voce.isIntersecting) {
            avviaOdometro(voce.target as HTMLElement);
            osservaContatori.unobserve(voce.target);
          }
        }
      }, { threshold: 0.5 });
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          costruisciOdometro(el);
          osservaContatori.observe(el);
        });
      }
    </script>
  </body>
</html>
