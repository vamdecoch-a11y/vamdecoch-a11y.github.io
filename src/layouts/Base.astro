---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BannerCookie from '../components/BannerCookie.astro';
import { localePath, type Locale } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean; // pagine da tenere fuori da Google anche dopo il go-live (es. /ringraziamenti)
  i18n?: boolean; // se true, emette i link hreflang it/en/de (solo per pagine che hanno le 3 versioni)
}
const { title, description, ogImage = '/og-vamdeco.jpg', noindex = false, i18n = false } = Astro.props;
const locale = (Astro.currentLocale ?? 'it') as Locale;
const langAttr = locale === 'it' ? 'it-CH' : locale;
// URL "ufficiale" pulito (senza .html e senza /index): coerente con sitemap e menu,
// così canonical e og:url non creano doppioni /pagina vs /pagina.html
const percorsoPulito = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '') || '/';
const urlPagina = new URL(percorsoPulito, Astro.site).href;
// percorso senza prefisso lingua, per calcolare le versioni nelle altre lingue (hreflang)
const base = percorsoPulito.replace(/^\/(en|de)(?=\/|$)/, '') || '/';
const altIt = new URL(base, Astro.site).href;
const altEn = new URL(localePath('en', base), Astro.site).href;
const altDe = new URL(localePath('de', base), Astro.site).href;

// --- Provenienza contatti (rif. pagina + canale) ---------------------------
// Codice pagina per il riferimento nei messaggi WhatsApp/email. Calcolato dal
// percorso senza prefisso lingua (`base`), quindi vale identico per it/en/de.
const codicePagina =
  base.startsWith('/abbigliamento-personalizzato-ticino') ? 'AB'
  : base.startsWith('/pellicole-satinate-ticino') ? 'SA'
  : base.startsWith('/oscuramento-vetri-auto-ticino') ? 'OS'
  : base.startsWith('/decorazione-veicoli-ticino') ? 'DV'
  : base.startsWith('/adesivi-e-etichette') ? 'AD'
  : 'GE';
// Nome del servizio per esteso, nella lingua della pagina.
const nomiServizio: Record<Locale, Record<string, string>> = {
  it: { AB: 'abbigliamento personalizzato', SA: 'pellicole satinate', OS: 'oscuramento vetri auto', DV: 'decorazione veicoli', AD: 'adesivi e etichette' },
  en: { AB: 'custom clothing', SA: 'frosted films', OS: 'car window tinting', DV: 'vehicle graphics', AD: 'stickers and labels' },
  de: { AB: 'individuelle Bekleidung', SA: 'satinierte Folien', OS: 'Auto-Scheibentönung', DV: 'Fahrzeugbeschriftung', AD: 'Aufkleber und Etiketten' },
};
const nomeServ = nomiServizio[locale][codicePagina] || '';
// Testi precompilati (senza il codice, che viene aggiunto a runtime con la fonte).
// Il token "(rif. XX-N)" resta invariato in tutte le lingue: cosi' Michele lo
// legge sempre allo stesso modo nella sua casella.
const testiRif: Record<Locale, { wa: string; waGe: string; mail: string }> = {
  it: {
    wa: nomeServ ? `Buongiorno, ho visto la pagina ${nomeServ} sul vostro sito e vorrei informazioni.` : 'Buongiorno, ho visitato il vostro sito e vorrei informazioni.',
    waGe: 'Buongiorno, ho visitato il vostro sito e vorrei informazioni.',
    mail: nomeServ ? `Richiesta ${nomeServ}` : 'Richiesta informazioni',
  },
  en: {
    wa: nomeServ ? `Hello, I saw your ${nomeServ} page on your website and would like some information.` : 'Hello, I visited your website and would like some information.',
    waGe: 'Hello, I visited your website and would like some information.',
    mail: nomeServ ? `Enquiry about ${nomeServ}` : 'General enquiry',
  },
  de: {
    wa: nomeServ ? `Guten Tag, ich habe auf Ihrer Website die Seite „${nomeServ}“ gesehen und hätte gerne Informationen.` : 'Guten Tag, ich habe Ihre Website besucht und hätte gerne Informationen.',
    waGe: 'Guten Tag, ich habe Ihre Website besucht und hätte gerne Informationen.',
    mail: nomeServ ? `Anfrage: ${nomeServ}` : 'Allgemeine Anfrage',
  },
};
// Lettera lingua nel codice quando la pagina NON è italiana: e=inglese, d=tedesco
// (italiano = nessuna lettera). Es. rif. SA-1e = satinate, annuncio, pagina inglese.
const letteraLingua = locale === 'en' ? 'e' : locale === 'de' ? 'd' : '';
const rifCfg = { code: codicePagina, lang: letteraLingua, wa: testiRif[locale].wa, waGe: testiRif[locale].waGe, mail: testiRif[locale].mail };
---
<!doctype html>
<html lang={langAttr}>
  <head>
    <script>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={urlPagina} />
    {i18n && (
      <>
        <link rel="alternate" hreflang="it-ch" href={altIt} />
        <link rel="alternate" hreflang="en" href={altEn} />
        <link rel="alternate" hreflang="de" href={altDe} />
        <link rel="alternate" hreflang="x-default" href={altIt} />
      </>
    )}
    <!-- Google Analytics: caricato dal banner cookie SOLO dopo consenso "Statistiche" -->

    <!-- Anteprima social (WhatsApp, Facebook, ecc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <!-- Unbounded self-hosted: precarico i pesi principali -->
    <link rel="preload" href="/fonts/unbounded-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/unbounded-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen antialiased">
    <Header />
    <slot />
    <Footer />
    <BannerCookie />
    <script>
      // Comparsa allo scroll degli elementi [data-reveal]
      const osservatore = new IntersectionObserver(
        (voci) => {
          for (const voce of voci) {
            if (voce.isIntersecting) {
              voce.target.classList.add('is-visible');
              osservatore.unobserve(voce.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => {
        osservatore.observe(el);
      });

      // Ritardo a cascata per i figli di [data-reveal-stagger]
      document.querySelectorAll('[data-reveal-stagger]').forEach((gruppo) => {
        gruppo.querySelectorAll('[data-reveal]').forEach((el, i) => {
          (el as HTMLElement).style.setProperty('--reveal-delay', `${i * 0.09}s`);
        });
      });

      // Numeri "contachilometri" (stile Number Flow): <span data-count="500" data-suffix="+">
      // Ogni cifra è una colonna che scorre in verticale e scatta al suo posto quando
      // il numero entra nello schermo; i caratteri non numerici (+, /, h) restano fissi.
      // Senza JS o con reduced-motion resta il testo statico già renderizzato.
      const costruisciOdometro = (el: HTMLElement) => {
        // fonte = testo già renderizzato dal server: JS e fallback coincidono per costruzione
        const testo = (el.textContent || '').trim() || `${el.dataset.count || ''}${el.dataset.suffix || ''}`;
        const vis = document.createElement('span');
        vis.className = 'nf-vis';
        vis.setAttribute('aria-hidden', 'true');
        let colonna = 0;
        for (const ch of testo) {
          const col = document.createElement('span');
          col.className = 'nf-col';
          if (/[0-9]/.test(ch)) {
            const strip = document.createElement('span');
            strip.className = 'nf-strip';
            // due giri di 0-9: ogni cifra fa almeno un giro completo prima di fermarsi
            for (let giro = 0; giro < 2; giro++) {
              for (let d = 0; d <= 9; d++) {
                const cella = document.createElement('span');
                cella.className = 'nf-cella';
                cella.textContent = String(d);
                strip.appendChild(cella);
              }
            }
            strip.dataset.target = String(10 + Number(ch));
            strip.style.transition = `transform ${(1.1 + colonna * 0.15).toFixed(2)}s cubic-bezier(0.19, 1, 0.22, 1) ${(colonna * 0.06).toFixed(2)}s`;
            col.appendChild(strip);
            colonna += 1;
          } else {
            col.textContent = ch;
          }
          vis.appendChild(col);
        }
        el.textContent = '';
        // copia solo-testo: leggibile da screen reader, Cmd+F, Google e in stampa
        const sr = document.createElement('span');
        sr.className = 'nf-testo';
        sr.textContent = testo;
        el.appendChild(sr);
        el.appendChild(vis);
      };
      const avviaOdometro = (el: HTMLElement) => {
        el.querySelectorAll<HTMLElement>('.nf-strip').forEach((strip) => {
          strip.style.transform = `translateY(-${strip.dataset.target}em)`;
        });
      };
      const osservaContatori = new IntersectionObserver((voci) => {
        for (const voce of voci) {
          if (voce.isIntersecting) {
            avviaOdometro(voce.target as HTMLElement);
            osservaContatori.unobserve(voce.target);
          }
        }
      }, { threshold: 0.5 });

      // Anni di esperienza auto-incrementanti: rileggo la data del browser così il
      // numero sale da solo a dicembre (2026 -> 9, 2027 -> 10...) anche senza un nuovo
      // deploy. Aggiorno data-count e testo PRIMA di costruire l'odometro/fallback.
      document.querySelectorAll<HTMLElement>('[data-anni-da]').forEach((el) => {
        const inizio = parseInt(el.dataset.anniDa || '0', 10);
        if (!inizio) return;
        const ora = new Date();
        const anni = ora.getFullYear() - inizio - (ora.getMonth() >= 11 ? 0 : 1);
        el.dataset.count = String(anni);
        el.textContent = `${anni}${el.dataset.suffix || ''}`;
      });

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          costruisciOdometro(el);
          osservaContatori.observe(el);
        });
      }
    </script>
    <script define:vars={{ rifCfg }}>
      // Provenienza nei contatti: precompila testo WhatsApp e oggetto email con
      // il riferimento "(rif. CODICE-FONTE)" cosi' Michele capisce da quale pagina
      // e da quale canale (annuncio Google vs organico) arriva la richiesta.
      (function () {
        // 1) Fonte di sessione: 1 = annuncio Google (gclid/cpc), 2 = tutto il resto.
        //    Salvata una volta per sessione in sessionStorage (dato tecnico, non
        //    profilazione). Un click su annuncio in corso di sessione aggiorna a 1.
        //    Senza sessionStorage disponibile, si degrada con eleganza a fonte 2.
        var fonte = '2';
        try {
          var salv = sessionStorage.getItem('vd_fonte');
          var q = new URLSearchParams(location.search);
          var m = (q.get('utm_medium') || '').toLowerCase();
          var annuncio = q.has('gclid') || q.has('gbraid') || q.has('wbraid') ||
                         ['cpc', 'ppc', 'paidsearch', 'paid'].indexOf(m) !== -1;
          if (annuncio) fonte = '1';
          else if (salv === '1' || salv === '2') fonte = salv;
          else fonte = '2';
          sessionStorage.setItem('vd_fonte', fonte);
        } catch (e) { fonte = '2'; }

        // rif dei link (WhatsApp/email): PAGINA-FONTE+LINGUA, es. SA-1, SA-2e, GE-1d.
        var rif = rifCfg.code + '-' + fonte + rifCfg.lang;
        window.vdRif = rif;
        // parti esposte al modulo di contatto, che vi inserisce anche il numero
        // del modulo (1=metà pagina, 2=fondo): PAGINA+MODULO-FONTE+LINGUA, es. SA1-1e.
        window.vdRifParti = { code: rifCfg.code, fonte: fonte, lang: rifCfg.lang };
        var suffisso = ' (rif. ' + rif + ')';

        // 2) Imposta un parametro nell'href mantenendo gli altri (spazio = %20,
        //    piu' compatibile di "+" per l'oggetto delle email).
        function setParam(href, key, val) {
          var hash = '', h = href.indexOf('#');
          if (h >= 0) { hash = href.slice(h); href = href.slice(0, h); }
          var qi = href.indexOf('?');
          var basePart = qi >= 0 ? href.slice(0, qi) : href;
          var qs = qi >= 0 ? href.slice(qi + 1) : '';
          var parts = qs ? qs.split('&').filter(function (p) { return p && p.split('=')[0] !== key; }) : [];
          parts.push(key + '=' + encodeURIComponent(val));
          return basePart + '?' + parts.join('&') + hash;
        }
        function valoreParam(href, key) {
          var qi = href.indexOf('?'); if (qi < 0) return '';
          var qs = href.slice(qi + 1).split('#')[0], out = '';
          qs.split('&').forEach(function (p) {
            var i = p.indexOf('='); if (i > 0 && p.slice(0, i) === key) out = p.slice(i + 1);
          });
          try { return decodeURIComponent(out.replace(/\+/g, ' ')); } catch (e) { return out; }
        }

        // 3) Link WhatsApp: testo precompilato + rif. Sulle pagine servizio usa il
        //    testo standard; sulle pagine generiche mantiene un testo gia' presente
        //    (home, festa) e vi aggiunge solo il riferimento.
        document.querySelectorAll('a[href*="wa.me"], a[href*="api.whatsapp.com"]').forEach(function (a) {
          var href = a.getAttribute('href') || '';
          var msg;
          if (rifCfg.code !== 'GE') {
            msg = rifCfg.wa;
          } else {
            var attuale = valoreParam(href, 'text');
            msg = attuale || rifCfg.waGe;
          }
          a.setAttribute('href', setParam(href, 'text', msg + suffisso));
        });

        // 4) Link email: oggetto precompilato + rif. Salta i link con data-rif="off"
        //    (es. contatti nella pagina privacy, che non sono richieste commerciali).
        document.querySelectorAll('a[href^="mailto:"]').forEach(function (a) {
          if (a.getAttribute('data-rif') === 'off') return;
          var href = a.getAttribute('href') || '';
          a.setAttribute('href', setParam(href, 'subject', rifCfg.mail + suffisso));
        });
      })();
    </script>
    <script is:inline>
      // GA4: click su WhatsApp, telefono ed email. Un solo listener per tutto il sito
      // (fase capture, così intercetta anche se un componente ferma la propagazione).
      // Con Consent Mode v2 gli eventi entrano nelle statistiche solo col consenso.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a || typeof window.gtag !== 'function') return;
        var h = a.getAttribute('href') || '';
        if (h.indexOf('wa.me') !== -1 || h.indexOf('api.whatsapp.com') !== -1) {
          window.gtag('event', 'click_whatsapp', { pagina: location.pathname });
        } else if (h.indexOf('tel:') === 0) {
          window.gtag('event', 'click_telefono', { pagina: location.pathname });
        } else if (h.indexOf('mailto:') === 0) {
          window.gtag('event', 'click_email', { pagina: location.pathname });
        }
      }, true);
    </script>
  </body>
</html>
